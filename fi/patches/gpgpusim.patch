+    l1_enabled = &gpu_sim->l1t_enabled;
+    l1_cluster_idx = &gpu_sim->l1t_cluster_idx;
+    l1_shader_core_ctx = &gpu_sim->l1t_shader_core_ctx;
+  }
+  // find if the thread belongs to a shader that we want to inject its L1D cache
+  for (int i=0; i<(*l1_enabled).size(); i++) {
+    if ((*l1_enabled)[i] == false) continue;
+    simt_core_cluster *simt_cluster_tmp = gpu_sim->m_cluster[(*l1_cluster_idx)[i]];
+    shader_core_ctx *shader_core_tmp = simt_cluster_tmp->get_core()[(*l1_shader_core_ctx)[i]];
+
+    if (thread_in_shader(thread, shader_core_tmp, simt_cluster_tmp)) {
+      l1_used_index = i;
+      break;
+    }
+  }
+}
+
+void *find_l1(ptx_thread_info *thread, gpgpu_sim *gpu_sim, unsigned l1_cache) {
+  for (unsigned cluster_idx = 0; cluster_idx < gpu_sim->m_shader_config->n_simt_clusters; cluster_idx++) {
+    simt_core_cluster *simt_core_cluster = gpu_sim->m_cluster[cluster_idx];
+    for (unsigned shd_core_idx = 0; shd_core_idx < simt_core_cluster->get_config()->n_simt_cores_per_cluster; shd_core_idx++) {
+      shader_core_ctx *shader_core_ctx = (simt_core_cluster->get_core())[shd_core_idx];
+      if (thread_in_shader(thread, shader_core_ctx, simt_core_cluster)) {
+        if (l1_cache == 0) {
+          return (void*) shader_core_ctx->m_ldst_unit->m_L1D;
+        } else if (l1_cache == 1) {
+          return (void*) shader_core_ctx->m_ldst_unit->m_L1C;
+        } else {
+          return (void*) shader_core_ctx->m_ldst_unit->m_L1T;
+        }
+      }
+    }
+  }
+  return NULL;
+}
+
+// Apply a cache-data fault to precisely the bit covered by this load.  A
+// line-relative modulo is incorrect for an unaligned/partial-width access.
+static void apply_cache_operand_fault(ptx_thread_info *thread, ptx_reg_t &data,
+                                       size_t width, unsigned line_bit,
+                                       unsigned access_start, const char *component,
+                                       addr_t address, unsigned cache_line,
+                                       const std::string &realization = std::string(),
+                                       uint64_t version = 0, unsigned operand_bit = static_cast<unsigned>(-1)) {
+  const unsigned bit = operand_bit == static_cast<unsigned>(-1) ? line_bit - access_start : operand_bit;
+  if (!width || width > sizeof(data) * 8 || (operand_bit == static_cast<unsigned>(-1) && line_bit < access_start) ||
+      bit >= width) {
+    printf("GPUFI_FAULT component=%s status=rejected reason=invalid_operand_bit\n", component);
+    return;
+  }
+  unsigned char before[sizeof(ptx_reg_t)];
+  memcpy(before, &data, sizeof(data));
+  if (!sara_fault::flip_bit(&data, sizeof(data), static_cast<unsigned>(width), bit + 1)) return;
+  const unsigned char *after = reinterpret_cast<const unsigned char *>(&data);
+  gpgpu_sim *gpu = thread->get_gpu();
+  printf("GPUFI_FAULT component=%s kind=data status=propagated cycle=%llu "
+         "kernel=%u thread=%u sm=%u line=%u byte_addr=%llu width=%u bit=%u "
+         "data_bit=%u before=", component, gpu->gpu_tot_sim_cycle + gpu->gpu_sim_cycle,
+         thread->get_kernel().get_uid(), thread->get_uid(), thread->get_hw_sid(),
+         cache_line, static_cast<unsigned long long>(address), static_cast<unsigned>(width),
+         bit + 1, line_bit);
+  for (size_t i = (width + 7) / 8; i; --i) printf("%02x", before[i - 1]);
+  printf(" after=");
+  for (size_t i = (width + 7) / 8; i; --i) printf("%02x", after[i - 1]);
+  printf(" realization_id=%s version=%llu\n", realization.empty() ? "legacy" : realization.c_str(),
+         static_cast<unsigned long long>(version));
+  fflush(stdout);
+}
+
+// Match ldst_unit::memory_cycle's cache routing, including explicit .cg and
+// the global-memory bypass option. A functional load must not consume an L1
+// fault when the timing model routes that instruction directly to L2.
+static bool fault_bypasses_l1d(ptx_thread_info *thread, l1_cache *cache,
+                               memory_space_t space) {
+  const ptx_instruction *instruction = thread->get_inst();
+  return cache == NULL || instruction->cache_op == CACHE_GLOBAL ||
+      (space.is_global() && thread->get_gpu()->m_shader_config->gmem_skip_L1D &&
+       instruction->cache_op != CACHE_L1);
+}
+
+static cache_request_status fault_probe_copy(baseline_cache *cache, addr_t address,
+                                              unsigned &index) {
+  mem_access_sector_mask_t mask;
+  const unsigned sector = (address % cache->m_config.get_line_sz()) /
+      (cache->m_config.get_line_sz() / SECTOR_CHUNCK_SIZE);
+  mask.set(sector);
+  return cache->m_tag_array->probe(address, index, mask, false, NULL);
+}
+
+static sara_fault::cache_read_observation fault_copy_identity(unsigned level,
+                                                               cache_block_t *source) {
+  sara_fault::cache_read_observation identity;
+  identity.level = level;
+  identity.slot = reinterpret_cast<uintptr_t>(source);
+  identity.version = source->m_fault_overlay.version();
+  identity.execution = source->m_fault_overlay.execution();
+  identity.tag = source->m_tag;
+  return identity;
+}
+
+// Independent diagnostic witness, enabled only with the existing explicit
+// cache-state ledger. No numeric/cache/FI state is modified by this traversal.
+static void observe_functional_cache_access(ptx_thread_info *thread, const ptx_reg_t &data,
+    size_t width, addr_t address, memory_space_t space, bool write) {
+  if (!sara_cache_witness::enabled() || (!space.is_global() && !space.is_local())) return;
+  sara_host_copy::collector *writer = sara_host_copy::get();
+  if (!writer->functional_cache_accesses()) return;
+  const sara_cache_witness::instruction_context &instruction = sara_cache_witness::current_instruction();
+  if (!instruction.active || thread->get_gpu()->is_functional_sim() || !space.is_global() || !width || width % 8 || width > sizeof(data) * 8) {
+    // Delayed atomic callbacks do not run inside ptx_exec_inst. Record the
+    // missing context honestly; never borrow the thread's later current PC.
+    std::ostringstream unsupported;
+    unsupported << "\"operation\":\"functional_access_without_supported_execution_scope\","
+        << "\"address_space_enum\":" << static_cast<int>(space.get_type()) << ",\"global\":" << (space.is_global() ? "true" : "false")
+        << ",\"kernel_uid\":" << thread->get_kernel().get_uid() << ",\"thread_id\":" << thread->get_uid()
+        << ",\"address\":" << address << ",\"width_bits\":" << width << ",\"write\":" << (write ? "true" : "false")
+        << ",\"cycle\":" << thread->get_gpu()->gpu_tot_sim_cycle + thread->get_gpu()->gpu_sim_cycle;
+    writer->cache_event("functional_cache_unbound", sara_exact_trace_instruction_cursor(), unsupported.str()); return;
+  }
+  gpgpu_sim *gpu = thread->get_gpu();
+  l1_cache *l1 = static_cast<l1_cache *>(find_l1(thread, gpu, 0));
+  const bool bypass = fault_bypasses_l1d(thread, l1, space);
+  std::ostringstream row; row << "\"kernel_uid\":" << thread->get_kernel().get_uid()
+      << ",\"thread_id\":" << thread->get_uid() << ",\"thread_instruction_ordinal\":" << thread->get_trace_attempt_count()
+      << ",\"dynamic_warp_instruction_uid\":" << instruction.uid << ",\"instruction_issue_cycle\":" << instruction.issue
+      << ",\"instruction_pc\":" << thread->get_pc() << ",\"cycle\":" << gpu->gpu_tot_sim_cycle + gpu->gpu_sim_cycle
+      << ",\"sm\":" << thread->get_hw_sid() << ",\"warp\":" << thread->get_hw_wid()
+      << ",\"address\":" << address << ",\"count\":" << width / 8 << ",\"atomic\":"
+      << (thread->get_inst()->isatomic() ? "true" : "false") << ",\"write\":" << (write ? "true" : "false")
+      << ",\"actual_operand_bytes\":" << (writer->functional_cache_values() ? sara_host_copy::quoted(sara_host_copy::hexbytes(reinterpret_cast<const unsigned char *>(&data), width / 8)) : "null")
+      << ",\"l1_bypass\":" << (bypass ? "true" : "false") << ",\"bytes\":[";
+  for (unsigned byte = 0; byte < width / 8; ++byte) {
+    const uint64_t cell = static_cast<uint64_t>(address) + byte;
+    if (cell > (std::numeric_limits<unsigned>::max)()) { writer->unmodeled("functional_cache_witness_address_wrap", address, width / 8, sara_exact_trace_instruction_cursor()); return; }
+    if (byte) row << ','; row << "{\"address\":" << cell << ",\"l1\":";
+    if (bypass) row << "null";
+    else row << sara_cache_records::candidate(l1->m_tag_array, l1->m_config, cell);
+    row << ",\"l2_bank\":";
+    if (gpu->m_memory_config->m_L2_config.disabled()) row << "null,\"l2\":null";
+    else {
+      addrdec_t decoded; gpu->m_memory_config->m_L2_config.m_address_mapping->addrdec_tlx(cell, &decoded);
+      l2_cache *l2 = gpu->m_memory_sub_partition[decoded.sub_partition]->m_L2cache;
+      row << decoded.sub_partition << ",\"l2\":";
+      if (!l2) row << "null"; else row << sara_cache_records::candidate(l2->m_tag_array, l2->m_config, cell);
+    }
+    row << '}';
+  }
+  row << ']';
+  writer->cache_event(write ? "functional_cache_store_intent" : "functional_cache_load_source", sara_exact_trace_instruction_cursor(), row.str());
+}
+
+// Functional-snapshot-cache-v3: functional values are final at issue. Timing
+// requests transport snapshots and cannot retroactively change these operands.
+static void fault_read_cache_copy(ptx_thread_info *thread, ptx_reg_t &data,
+                                  size_t width, addr_t address, memory_space_t space) {
+  gpgpu_sim *gpu = thread->get_gpu();
+  if (!sara_fault::live_cache_error()) return;
+  if (!space.is_global() || !width || width % 8 || width > sizeof(data)*8) {
+    sara_fault::cache_approximation("functional_backing_access", "cache", gpu->cache_fault_realization_id);
+    return;
+  }
+  const uint64_t cycle = gpu->gpu_tot_sim_cycle + gpu->gpu_sim_cycle;
+  for (unsigned byte=0; byte<width/8; ++byte) {
+    const uint64_t cell=address+byte;
+    baseline_cache *selected=NULL; cache_block_t *source=NULL; unsigned level=0,index=0;
+    l1_cache *l1=static_cast<l1_cache *>(find_l1(thread,gpu,0));
+    if (!fault_bypasses_l1d(thread,l1,space)) {
+      const cache_request_status status=fault_probe_copy(l1,cell,index);
+      if (status==HIT) {selected=l1;level=1;}
+      else if (status==HIT_RESERVED || status==RESERVATION_FAIL)
+        sara_fault::cache_approximation("reserved_L1_uses_lower_snapshot", "l1d", gpu->cache_fault_realization_id);
+    }
+    if (!selected) {
+      addrdec_t decoded;gpu->m_memory_config->m_L2_config.m_address_mapping->addrdec_tlx(cell,&decoded);
+      l2_cache *l2=gpu->m_memory_sub_partition[decoded.sub_partition]->m_L2cache;
+      if (l2) {
+        const cache_request_status status=fault_probe_copy(l2,cell,index);
+        if (status==HIT) {selected=l2;level=2;}
+        else if (status==HIT_RESERVED || status==RESERVATION_FAIL)
+          sara_fault::cache_approximation("reserved_L2_uses_backing_snapshot", "l2", gpu->cache_fault_realization_id);
+      }
+    }
+    sara_fault::cache_read_observation observed;
+    observed.thread=thread->get_uid(); observed.kernel=thread->get_kernel().get_uid();
+    if (selected) {
+      source=selected->m_tag_array->get_block(index);
+      const uint64_t requested=selected->m_config.block_addr(cell);
+      if (source->m_block_addr!=requested) {
+        sara_fault::cache_approximation("tag_alias_uses_functional_backing",level==1?"l1d":"l2",gpu->cache_fault_realization_id);
+        source=NULL;
+      }
+    }
+    if (source) {
+      observed=fault_copy_identity(level,source);
+      observed.thread=thread->get_uid();observed.kernel=thread->get_kernel().get_uid();
+      observed.mask=source->m_fault_overlay.mask(cell-source->m_block_addr);
+      observed.realization=observed.mask?source->m_fault_overlay.realization():std::string();
+      const unsigned sector_bytes=selected->m_config.m_cache_type==NORMAL?selected->m_config.get_line_sz():selected->m_config.get_line_sz()/SECTOR_CHUNCK_SIZE;
+      const unsigned begin=((cell-source->m_block_addr)/sector_bytes)*sector_bytes;
+      const sara_fault::cache_payload payload=source->m_fault_overlay.snapshot(begin,sector_bytes);
+      const sara_fault::cache_read_key snapshot(thread->get_hw_sid(),thread->get_hw_wid(),thread->get_pc(),cycle,selected->m_config.block_addr(cell));
+      sara_fault::cache_payload &saved=gpu->cache_fault_snapshots[snapshot];
+      if (gpu->cache_snapshot_sectors[snapshot].insert(begin).second) {
+        // An empty clean sector is a snapshot too; later observations cannot
+        // add a fault to an already frozen functional read.
+        saved.insert(payload.begin(),payload.end());
+        for (sara_fault::cache_payload::const_iterator item=payload.begin();item!=payload.end();++item) {
+          printf("GPUFI_CACHE_SNAPSHOT component=%s cycle=%llu sm=%u warp=%u pc=%llu issue=%llu block_addr=%llu line=%u version=%llu byte_addr=%llu mask=%02x realization_id=%s\n",
+              level==1?"l1d":"l2",(unsigned long long)cycle,thread->get_hw_sid(),thread->get_hw_wid(),
+              (unsigned long long)thread->get_pc(),(unsigned long long)cycle,(unsigned long long)source->m_block_addr,
+              index,(unsigned long long)source->m_fault_overlay.version(),(unsigned long long)item->first,
+              (unsigned)item->second.mask,item->second.realization.c_str());
+        }
+        if (!payload.empty()) fflush(stdout);
+      }
+    }
+    if (source && observed.mask) {
+      const unsigned line_bit=(cell-source->m_block_addr)*8;
+      for (unsigned bit=0;bit<8;++bit) if (observed.mask&(1U<<bit))
+        apply_cache_operand_fault(thread,data,width,line_bit+bit,(address-source->m_block_addr)*8,
+            level==1?"l1d":"l2",address,index,observed.realization,source->m_fault_overlay.version(),byte*8+bit);
+    }
+  }
+}
+
+static void fault_store_cache_copy(ptx_thread_info *thread,const ptx_reg_t &,size_t,
+                                   addr_t,memory_space_t) {
+  // Functional memory is the value baseline. Physical copies are cleared only
+  // by the accepted timing store/eviction; no speculative forwarding proof.
+  if (sara_fault::live_cache_error())
+    sara_fault::cache_approximation("functional_store_timing_order", "cache",thread->get_gpu()->cache_fault_realization_id);
+}
+
+void check_and_apply_l2_bf(ptx_thread_info *thread, addr_t addr, ptx_reg_t &data, size_t size, bool is_store, bool is_rw, bool is_constant, bool is_texture) {
+  gpgpu_sim *gpu_sim = (gpgpu_sim *)(thread->m_gpu);
+  if (gpu_sim->cache_fault_model_active) {
+    sara_fault::cache_approximation("legacy_functional_backing_path", "l2", gpu_sim->cache_fault_realization_id);
+    return;
+  }
+
+//  printf("GLOBAL/LOCAL MISSED L1 -> READ L2 OEOEOEO FROM ld_exec from thread uid=%u on address=%x\n", thread->get_uid(), addr);
+
+  addrdec_t addrdec = addrdec_t();
+  gpu_sim->m_memory_config->m_L2_config.m_address_mapping->addrdec_tlx(addr, &addrdec);
+
+  l2_cache *L2 = gpu_sim->m_memory_sub_partition[addrdec.sub_partition]->m_L2cache;
+  if (L2 == NULL) return;
+
+  new_addr_type block_addr = L2->m_config.block_addr(addr);
+  unsigned set_index = L2->m_config.set_index(block_addr);
+  new_addr_type tag = L2->m_config.tag(block_addr);
+  unsigned bit_start = (addr % L2->m_config.get_line_sz()) * 8;
+  unsigned bit_end = bit_start + size - 1;
+
+  for (int j=0; j<gpu_sim->l2_line_bitflip_bits_idx.size(); j++) {
+    if (!gpu_sim->l2_bf_enabled[j] || (gpu_sim->l2_bank_id[j] != addrdec.sub_partition)) continue;
+    unsigned index = static_cast<unsigned>(-1);
+    mem_access_sector_mask_t mask = mem_access_sector_mask_t();
+    const unsigned sector = (addr % L2->m_config.get_line_sz()) /
+        (L2->m_config.get_line_sz() / SECTOR_CHUNCK_SIZE);
+    mask.set(sector);
+    enum cache_request_status probe_status = L2->m_tag_array->probe(addr, index, mask, false, NULL);
+
+    if (gpu_sim->l2_index[j] == index) {
+//        printf("Thread = %u, index = %u, l2_idx = %u, tag = %u, l2_tag=%u, probe_status = %u\n", thread->get_uid(), index, gpu_sim->l2_index[j], tag, gpu_sim->l2_tag[j], probe_status);
+//        printf("l2_line_bitflip_bits_idx=%u, bit_start=%u, bit_end=%u\n", gpu_sim->l2_line_bitflip_bits_idx[j], bit_start, bit_end);
+      bool probe_status_hit = false, probe_status_miss = false;
+      if (is_store || is_rw) {
+        probe_status_hit = probe_status == HIT || probe_status == HIT_RESERVED;
+        probe_status_miss = (probe_status != RESERVATION_FAIL && probe_status != HIT && probe_status != HIT_RESERVED);
+      } else if (is_constant) {
+        probe_status_hit = probe_status == HIT;
+        probe_status_miss = (probe_status != RESERVATION_FAIL && probe_status != HIT);
+      } else if (is_texture) {
+        probe_status_hit = probe_status == HIT;
+        probe_status_miss = probe_status == MISS;
+      }
+
+      if (is_store && gpu_sim->l2_tag[j] == tag && probe_status_hit &&
+          sara_fault::access_covers_bit(gpu_sim->l2_line_bitflip_bits_idx[j], bit_start, size)) {
+        printf("DEACTIVATING L2 BIT FLIP ON LOAD GLOBAL/LOCAL\n");
+        gpu_sim->l2_bf_enabled[j] = false;
+        continue;
+      }
+      if (gpu_sim->l2_tag[j] == tag && probe_status_hit) { // hit
+        // Inject the error to the specific value of a thread that the bit flip belongs to
+        if (gpu_sim->l2_line_bitflip_bits_idx[j]>=bit_start && gpu_sim->l2_line_bitflip_bits_idx[j]<=bit_end) {
+          apply_cache_operand_fault(thread, data, size,
+              gpu_sim->l2_line_bitflip_bits_idx[j], bit_start, "l2", addr, index);
+        }
+      } else if (gpu_sim->l2_tag[j] == tag && probe_status_miss) {
+        if (is_constant) {
+          // check if is really a miss and not reservation fail
+          new_addr_type mshr_addr = L2->m_config.mshr_addr(addr);
+          bool mshr_hit = L2->m_mshrs.probe(mshr_addr);
+          bool mshr_avail = !(L2->m_mshrs.full(mshr_addr));
+          if ((mshr_hit && mshr_avail) || (!mshr_hit && mshr_avail && (L2->m_miss_queue.size() < L2->m_config.m_miss_queue_size))) {
+            printf("DEACTIVATING L2 BIT FLIP ON LOAD CONSTANT\n");
+            gpu_sim->l2_bf_enabled[j] = false;
+          }
+        } else {
+          printf("DEACTIVATING L2 BIT FLIP ON LOAD GLOBAL/LOCAL\n");
+          // TODO disable main flag if l2_bf_enabled[*]==false
+          gpu_sim->l2_bf_enabled[j] = false;
+        }
+      }
+    }
+  }
+}
+
+void l1t_bit_flip(ptx_thread_info *thread, unsigned data_tex_array_index, unsigned long data_size, ptx_reg_t &data_bf, int l1t_used_index) {
+  gpgpu_sim *gpu_sim = (gpgpu_sim *)(thread->m_gpu);
+  simt_core_cluster *simt_cluster = gpu_sim->m_cluster[gpu_sim->l1t_cluster_idx[l1t_used_index]];
+  shader_core_ctx *shader_core = simt_cluster->get_core()[gpu_sim->l1t_shader_core_ctx[l1t_used_index]];
+
+//  printf("...on address=%x\n", data_tex_array_index);
+
+  tex_cache *L1T = shader_core->m_ldst_unit->m_L1T;
+  new_addr_type block_addr = L1T->m_config.block_addr(data_tex_array_index);
+  unsigned set_index = L1T->m_config.set_index(block_addr);
+  new_addr_type tag = L1T->m_config.tag(block_addr);
+  unsigned bit_start = (data_tex_array_index % L1T->m_config.get_line_sz()) * 8;
+  unsigned bit_end = bit_start + data_size - 1;
+
+  std::vector<bool> &l1t_bf_enabled_vector = gpu_sim->l1t_bf_enabled[l1t_used_index];
+  std::vector<unsigned> l1t_line_bitflip_bits_idx_vector = gpu_sim->l1t_line_bitflip_bits_idx[l1t_used_index];
+  std::vector<new_addr_type> l1t_tag_vector = gpu_sim->l1t_tag[l1t_used_index];
+  std::vector<unsigned> l1t_index_vector = gpu_sim->l1t_index[l1t_used_index];
+
+  for (int j=0; j<l1t_line_bitflip_bits_idx_vector.size(); j++) {
+    if (!l1t_bf_enabled_vector[j]) continue;
+    unsigned index = static_cast<unsigned>(-1);
+    // line cache block so we don't care about masking
+    mem_access_sector_mask_t mask = mem_access_sector_mask_t();
+    mask.set(0);
+    enum cache_request_status probe_status = L1T->m_tags.probe(data_tex_array_index, index, mask, false, NULL);
+    if (L1T->m_fragment_fifo.full() || L1T->m_request_fifo.full() || L1T->m_rob.full()) {
+      probe_status = RESERVATION_FAIL;
+    }
+
+    if (l1t_index_vector[j] == index) {
+//      printf("index = %u, l1t_idx = %u, tag = %u, l1t_tag=%u, probe_status = %u\n", index, l1t_index_vector[j], tag, l1t_tag_vector[j], probe_status);
+//      printf("l1t_line_bitflip_bits_idx=%u, bit_start=%u, bit_end=%u\n", l1t_line_bitflip_bits_idx_vector[j], bit_start, bit_end);
+      if (l1t_tag_vector[j] == tag && probe_status == HIT) { // hit
+        // Inject the error to the specific value of a thread that the bit flip belongs to
+        if (l1t_line_bitflip_bits_idx_vector[j]>=bit_start && l1t_line_bitflip_bits_idx_vector[j]<=bit_end) {
+          apply_cache_operand_fault(thread, data_bf, data_size,
+              l1t_line_bitflip_bits_idx_vector[j], bit_start, "l1t",
+              data_tex_array_index, index);
+        }
+      } else if (l1t_tag_vector[j] == tag && probe_status == MISS) { // miss
+        printf("DEACTIVATING L1T BIT FLIP ON LOAD TEXTURE\n");
+        l1t_bf_enabled_vector[j] = false;
+      }
+    }
+  }
+}
+
+void l2_wrapper_L1T(ptx_thread_info *thread, unsigned data_tex_array_index, unsigned long data_size, ptx_reg_t &data_bf) {
+  gpgpu_sim *gpu_sim = (gpgpu_sim *)(thread->m_gpu);
+
+  tex_cache *L1T = (tex_cache *) find_l1(thread, gpu_sim, 2);
+  if (L1T != NULL && gpu_sim->l2_enabled) {
+    // line cache block so we don't care about masking
+    mem_access_sector_mask_t mask = mem_access_sector_mask_t();
+    mask.set(0);
+    unsigned index = static_cast<unsigned>(-1);
+    enum cache_request_status probe_status = L1T->m_tags.probe(data_tex_array_index, index, mask, false, NULL);
+    if (L1T->m_fragment_fifo.full() || L1T->m_request_fifo.full() || L1T->m_rob.full()) {
+      probe_status = RESERVATION_FAIL;
+    }
+
+    if (probe_status == MISS) {
+      // check L2 on load miss
+      check_and_apply_l2_bf(thread, data_tex_array_index, data_bf, data_size, false, false, false, true);
+    }
+  }
+}
