+#ifndef SARA_PTX_FP_UNARY_BITS_H
+#define SARA_PTX_FP_UNARY_BITS_H
+
+// PTX scalar f32/f64 abs/neg, without host FP rounding/DAZ/FTZ dependence.
+// NaN payload/sign for f32 abs and all neg is an implementation choice under
+// PTX ISA 7.8. f64 abs must pass a NaN through unchanged.
+#include <stdint.h>
+
+namespace sara_ptx {
+
+inline uint32_t unary_flush_f32(uint32_t bits, bool ftz) {
+  if (ftz && (bits & 0x7f800000U) == 0 && (bits & 0x007fffffU) != 0)
+    return bits & 0x80000000U;
+  return bits;
+}
+
+inline uint32_t abs_f32_bits(uint32_t bits, bool ftz) {
+  return unary_flush_f32(bits, ftz) & 0x7fffffffU;
+}
+
+inline uint32_t neg_f32_bits(uint32_t bits, bool ftz) {
+  return unary_flush_f32(bits, ftz) ^ 0x80000000U;
+}
+
+inline uint64_t abs_f64_bits(uint64_t bits) {
+  if ((bits & UINT64_C(0x7ff0000000000000)) == UINT64_C(0x7ff0000000000000) &&
+      (bits & UINT64_C(0x000fffffffffffff)) != 0)
+    return bits;
+  return bits & UINT64_C(0x7fffffffffffffff);
+}
+
+inline uint64_t neg_f64_bits(uint64_t bits) {
+  return bits ^ UINT64_C(0x8000000000000000);
+}
+
+}  // namespace sara_ptx
+#endif
