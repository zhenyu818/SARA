+bool thread_in_shader(ptx_thread_info *thread, shader_core_ctx *shader_core, simt_core_cluster *simt_cluster) {
+  for (unsigned warp_idx = 0; warp_idx < simt_cluster->get_config()->max_warps_per_shader; warp_idx++) {
