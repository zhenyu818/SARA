+static std::string trace_scalar_pure_effect(const ptx_instruction *instruction) {
+  const std::string complete_lm=trace_complete_lm_pure_effect(instruction);
+  if (complete_lm!="null") return complete_lm;
+  const std::string opcode = extract_opcode_token(instruction);
+  const bool conversion = opcode == "cvt.rn.f32.s32";
+  const bool unsigned_rzi = opcode == "cvt.rzi.u32.f32";
+  const bool any_conversion = conversion || unsigned_rzi;
+  const bool signed_div = opcode == "div.s32", signed_rem = opcode == "rem.s32";
+  const bool signed_divrem = signed_div || signed_rem;
+  const bool wide_mad = opcode == "mad.wide.u32";
+  const bool rounded_fma = opcode == "fma.rm.f32";
+  if ((!any_conversion && !wide_mad && !rounded_fma && !signed_divrem) || instruction->is_exit() || instruction->is_neg() ||
+      instruction->has_memory_read() || instruction->has_memory_write() ||
+      !instruction->latency || !instruction->initiation_interval) return "null";
+  const unsigned source_count = signed_divrem ? 2 : any_conversion ? 1 : 3;
+  const unsigned destination_bits = wide_mad ? 64 : 32;
+  const unsigned source_bits[] = {32, 32, wide_mad ? 64u : 32u};
+  const char *source_types[] = {(conversion || signed_divrem) ? "s32" : wide_mad ? "u32" : "f32",
+                              signed_divrem ? "s32" : wide_mad ? "u32" : "f32", wide_mad ? "u64" : "f32"};
+  const char *destination_type = signed_divrem ? "s32" : unsigned_rzi ? "u32" : wide_mad ? "u64" : "f32";
+  const char *route = signed_div ? "SFU" : signed_rem ? "ALU" : any_conversion ? "ALU" : wide_mad ? "INTP" : "SP";
+  const int option = unsigned_rzi ? RZI_OPTION : conversion ? RN_OPTION : wide_mad ? WIDE_OPTION : RM_OPTION;
+  const std::list<int> options = instruction->get_options();
+  if (instruction->get_num_operands() != source_count + 1 ||
+      (signed_divrem ? !options.empty() : (options.size() != 1 || options.front() != option)) ||
+      instruction->get_scalar_type().size() != (any_conversion ? 2u : 1u)) return "null";
+  if ((conversion && (instruction->get_opcode() != CVT_OP || instruction->get_type() != F32_TYPE ||
+                      instruction->get_type2() != S32_TYPE || instruction->op != ALU_OP)) ||
+      (unsigned_rzi && (instruction->get_opcode() != CVT_OP || instruction->get_type() != U32_TYPE ||
+                        instruction->get_type2() != F32_TYPE || instruction->op != ALU_OP)) ||
+      (signed_divrem && (instruction->get_opcode() != (signed_div ? DIV_OP : REM_OP) ||
+                         instruction->get_type() != S32_TYPE || instruction->op != (signed_div ? SFU_OP : ALU_OP))) ||
+      (wide_mad && (instruction->get_opcode() != MAD_OP || instruction->get_type() != U32_TYPE ||
+                   instruction->op != INTP_OP)) ||
+      (rounded_fma && (instruction->get_opcode() != FMA_OP || instruction->get_type() != F32_TYPE ||
+                      instruction->op != SP_OP))) return "null";
+  if (instruction->has_pred() && instruction->get_pred_mod() != -1) return "null";
+  const symbol *predicate = instruction->has_pred() ? instruction->get_pred().get_symbol() : NULL;
+  if (instruction->has_pred() && (!predicate || !predicate->is_reg() || !predicate->uid() || !predicate->type() ||
+      predicate->type()->get_key().scalar_type() != PRED_TYPE)) return "null";
+  for (unsigned index = 0; index <= source_count; ++index) {
+    const operand_info &operand = instruction->operand_lookup(index);
+    if (operand.is_vector() || operand.get_addr_space() != undefined_space || operand.get_operand_lohi() ||
+        operand.get_operand_neg() || operand.is_neg_pred() || operand.get_double_operand_type()) return "null";
+  }
+  const operand_info &dst = instruction->dst();
+  const symbol *write = dst.is_reg() ? dst.get_symbol() : NULL;
+  if (!write || !write->is_reg() || !write->uid() || write->name() == "_" || !write->type() ||
+      write->get_size_in_bytes() * 8 != destination_bits ||
+      write->type()->get_key().scalar_type() == PRED_TYPE) return "null";
+  std::ostringstream out;
+  out << "{\"schema\":\"sara-assembled-scalar-pure-effect-v1\",\"opcode\":\"" << opcode
+      << "\",\"source_line_projection\":\"existing_ptx_ir_removes_tabs_v1\",\"assembled_source_line\":\""
+      << json_escape(instruction->get_source()) << "\",\"memory\":false,\"control\":false,\"implicit_state\":false,"
+      << "\"route\":\"" << route << "\",\"latency\":" << instruction->latency
+      << ",\"initiation_interval\":" << instruction->initiation_interval << ",\"predicate\":";
+  if (predicate) out << "{\"name\":\"" << json_escape(predicate->name()) << "\",\"register_uid\":" << predicate->uid()
+      << ",\"modifier\":-1,\"negated\":" << (instruction->get_pred_neg() ? "true" : "false") << '}';
+  else out << "null";
+  out << ",\"sources\":[";
+  for (unsigned index = 0; index < source_count; ++index) {
+    const operand_info &operand = instruction->operand_lookup(index + 1);
+    if (index) out << ',';
+    out << "{\"role\":\"operand\",\"operand_index\":" << index + 1 << ",\"width_bits\":" << source_bits[index]
+        << ",\"scalar_type\":\"" << source_types[index] << '\"';
+    if (operand.is_reg()) {
+      const symbol *read = operand.get_symbol();
+      if (!read || !read->is_reg() || !read->uid() || read->name() == "_" || !read->type() ||
+          read->get_size_in_bytes() * 8 != source_bits[index] ||
+          read->type()->get_key().scalar_type() == PRED_TYPE) return "null";
+      out << ",\"kind\":\"register\",\"name\":\"" << json_escape(read->name()) << "\",\"register_uid\":" << read->uid();
+    } else if (!wide_mad && !unsigned_rzi && !signed_divrem && operand.is_literal() &&
+               (conversion ? (operand.get_type() == int_t || operand.get_type() == unsigned_t)
+                           : operand.get_type() == float_op_t)) {
+      out << ",\"kind\":\"literal\",\"value\":\"" << hex_u64(operand.get_literal_value().u32) << '\"';
+    } else return "null";
+    out << '}';
+  }
+  out << "],\"destinations\":[{\"width_bits\":" << destination_bits << ",\"scalar_type\":\"" << destination_type
+      << "\",\"name\":\"" << json_escape(write->name()) << "\",\"register_uid\":" << write->uid() << "}]}";
+  return out.str();
+}
