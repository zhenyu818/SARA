+inline void mark_slot(const tag_array *tags, unsigned slot) {
+  sara_host_copy::collector *writer = sara_host_copy::get();
+  if (writer && writer->cache_state_enabled() && changed_slot_profile() && slot != static_cast<unsigned>(-1))
+    changed_slots()[tags].insert(slot);
