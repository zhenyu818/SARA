+#ifndef SARA_PTX_SFU_OPS_H
+#define SARA_PTX_SFU_OPS_H
+
+// Shared simulator arithmetic only. Approximate results are not native-CUDA
+// bit identities or a SARA replay authorization. PTX ISA 7.8, 9.7.3.13/16/21.
+#include "ptx_fp_ops.h"
+#include <cstdint>
+#include <cstring>
+#include <cmath>
+#include <limits>
+#if defined(__FAST_MATH__)
+#error "PTX SFU semantics require IEEE host arithmetic, not fast-math"
+#endif
+
+namespace sara_ptx {
+static_assert(std::numeric_limits<float>::is_iec559 && sizeof(float) == 4 &&
+              std::numeric_limits<double>::is_iec559 && sizeof(double) == 8,
+              "PTX SFU host must provide binary32 and binary64");
+
+inline float sfu_float(uint32_t bits) { float value; std::memcpy(&value, &bits, 4); return value; }
+inline uint32_t sfu_bits(float value) { uint32_t bits; std::memcpy(&bits, &value, 4); return bits; }
+inline double sfu_double(uint64_t bits) { double value; std::memcpy(&value, &bits, 8); return value; }
+inline uint64_t sfu_bits(double value) { uint64_t bits; std::memcpy(&bits, &value, 8); return bits; }
+inline uint32_t sfu_flush(uint32_t bits, bool ftz) {
+  return ftz && (bits & 0x7f800000u) == 0 ? bits & 0x80000000u : bits;
+}
+inline bool sfu_nan(uint32_t bits) { return (bits & 0x7fffffffu) > 0x7f800000u; }
+inline bool sfu_nan(uint64_t bits) {
+  return (bits & UINT64_C(0x7fffffffffffffff)) > UINT64_C(0x7ff0000000000000);
+}
+
+inline uint32_t sfu_ex2_f32(uint32_t bits, bool ftz) {
+  bits = sfu_flush(bits, ftz);
+  if (sfu_nan(bits)) return 0x7fc00000u;  // PTX leaves this NaN payload unspecified.
+  if (bits == 0xff800000u) return 0;
+  if (bits == 0x7f800000u) return 0x7f800000u;
+  if ((bits & 0x7fffffffu) == 0) return 0x3f800000u;
+  ScopedRounding rounding(FE_TONEAREST);
+  float (*volatile operation)(float) = ::exp2f;
+  return sfu_flush(sfu_bits(operation(sfu_float(bits))), ftz);
+}
+
+inline uint32_t sfu_rcp_f32(uint32_t bits, int mode, bool ftz) {
+  bits = sfu_flush(bits, ftz);
+  const uint32_t sign = bits & 0x80000000u, magnitude = bits & 0x7fffffffu;
+  if (sfu_nan(bits)) return 0x7fc00000u;
+  if (magnitude == 0) return sign | 0x7f800000u;
+  if (magnitude == 0x7f800000u) return sign;
+  ScopedRounding rounding(mode);
+  volatile float numerator = 1.0f, denominator = sfu_float(bits);
+  volatile float result = numerator / denominator;
+  return sfu_flush(sfu_bits(result), ftz);
+}
+
+inline uint64_t sfu_rcp_f64(uint64_t bits, int mode) {
+  const uint64_t sign = bits & UINT64_C(0x8000000000000000);
+  const uint64_t magnitude = bits & UINT64_C(0x7fffffffffffffff);
+  if (sfu_nan(bits)) return UINT64_C(0x7ff8000000000000);
+  if (magnitude == 0) return sign | UINT64_C(0x7ff0000000000000);
+  if (magnitude == UINT64_C(0x7ff0000000000000)) return sign;
+  ScopedRounding rounding(mode);
+  volatile double numerator = 1.0, denominator = sfu_double(bits);
+  volatile double result = numerator / denominator;
+  return sfu_bits(result);
+}
+
+inline uint32_t sfu_rsqrt_f32(uint32_t bits, bool ftz) {
+  bits = sfu_flush(bits, ftz);
+  const uint32_t magnitude = bits & 0x7fffffffu;
+  if (sfu_nan(bits)) return 0x7fc00000u;
+  if (magnitude == 0) return (bits & 0x80000000u) | 0x7f800000u;
+  if (bits & 0x80000000u) return 0x7fc00000u;
+  if (magnitude == 0x7f800000u) return 0;
+  ScopedRounding rounding(FE_TONEAREST);
+  float (*volatile operation)(float) = ::sqrtf;
+  volatile float denominator = operation(sfu_float(bits)), numerator = 1.0f;
+  volatile float result = numerator / denominator;
+  return sfu_flush(sfu_bits(result), ftz);
+}
+
+inline uint64_t sfu_rsqrt_f64(uint64_t bits) {
+  const uint64_t magnitude = bits & UINT64_C(0x7fffffffffffffff);
+  if (sfu_nan(bits)) return UINT64_C(0x7ff8000000000000);
+  if (magnitude == 0) return (bits & UINT64_C(0x8000000000000000)) | UINT64_C(0x7ff0000000000000);
+  if (bits & UINT64_C(0x8000000000000000)) return UINT64_C(0x7ff8000000000000);
+  if (magnitude == UINT64_C(0x7ff0000000000000)) return 0;
+  ScopedRounding rounding(FE_TONEAREST);
+  double (*volatile operation)(double) = ::sqrt;
+  volatile double denominator = operation(sfu_double(bits)), numerator = 1.0;
+  volatile double result = numerator / denominator;
+  return sfu_bits(result);
+}
+// PTX sqrt.rnd is correctly rounded in the requested mode. Approximate f32
+// uses the same RN host operation as a chosen simulator implementation, never
+// a native-CUDA bit identity or a claim of universal approximate accuracy.
+inline uint32_t sfu_sqrt_f32(uint32_t bits, int mode, bool ftz) {
+  bits = sfu_flush(bits, ftz);
+  const uint32_t magnitude = bits & 0x7fffffffu;
+  if (sfu_nan(bits)) return 0x7fc00000u;
+  if (magnitude == 0) return bits;  // Includes -0 after explicit signed FTZ.
+  if (bits & 0x80000000u) return 0x7fc00000u;
+  if (magnitude == 0x7f800000u) return bits;
+  ScopedRounding rounding(mode);
+  float (*volatile operation)(float) = ::sqrtf;
+  volatile float result = operation(sfu_float(bits));
+  return sfu_flush(sfu_bits(result), ftz);
+}
+
+inline uint64_t sfu_sqrt_f64(uint64_t bits, int mode) {
+  const uint64_t magnitude = bits & UINT64_C(0x7fffffffffffffff);
+  if (sfu_nan(bits)) return UINT64_C(0x7ff8000000000000);
+  if (magnitude == 0) return bits;
+  if (bits & UINT64_C(0x8000000000000000)) return UINT64_C(0x7ff8000000000000);
+  if (magnitude == UINT64_C(0x7ff0000000000000)) return bits;
+  ScopedRounding rounding(mode);
+  double (*volatile operation)(double) = ::sqrt;
+  volatile double result = operation(sfu_double(bits));
+  return sfu_bits(result);
+}
+}  // namespace sara_ptx
+#endif
