+
+namespace {
+
+static const uint32_t kRegfileTraceMagic = 0x52544652;  // "RFTR"
+static const uint16_t kRegfileTraceVersion = 1;
+static const uint32_t kRegfileTraceFlagWriteBit = 0x1;
+static const uint32_t kRegfileTraceWriteBit = 0x80000000u;
+
+struct regfile_trace_header_v1 {
+  uint32_t magic;
+  uint16_t version;
+  uint16_t record_size;
+  uint32_t flags;
+  uint32_t reserved;
+};
+
+struct regfile_trace_event_v1 {
+  uint64_t cycle;
+  uint32_t thread_uid;
+  uint32_t reg_uid_and_type;
+};
+
+class regfile_trace_writer {
+ public:
+  regfile_trace_writer() : m_fp(NULL), m_enabled(false), m_event_max(0) {}
+
+  void log(const gpgpu_functional_sim_config &cfg, uint64_t cycle,
+           uint32_t thread_uid, uint32_t reg_uid, bool is_write) {
+    if (!cfg.regfile_trace_enabled()) return;
+    if (!m_enabled) init(cfg);
+    if (!m_enabled) return;
+    regfile_trace_event_v1 ev;
+    ev.cycle = cycle;
+    ev.thread_uid = thread_uid;
+    ev.reg_uid_and_type = reg_uid | (is_write ? kRegfileTraceWriteBit : 0);
+    m_buffer.push_back(ev);
+    if (m_buffer.size() >= m_event_max) flush();
+  }
+
+  void flush() {
+    if (!m_enabled || m_buffer.empty()) return;
+    fwrite(&m_buffer[0], sizeof(regfile_trace_event_v1), m_buffer.size(), m_fp);
+    m_buffer.clear();
+  }
+
+  void close() {
+    if (m_fp) {
+      fclose(m_fp);
+      m_fp = NULL;
+    }
+  }
+
+  ~regfile_trace_writer() {
+    flush();
+    close();
+  }
+
+ private:
+  void init(const gpgpu_functional_sim_config &cfg) {
+    const char *path = cfg.regfile_trace_file();
+    m_fp = fopen(path, "wb");
+    if (!m_fp) {
+      fprintf(stderr,
+              "GPGPU-Sim: failed to open regfile trace output '%s'\n", path);
+      m_enabled = false;
+      return;
+    }
+
+    regfile_trace_header_v1 hdr;
