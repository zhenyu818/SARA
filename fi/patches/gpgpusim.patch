+static void fault_validate_cache_write(gpgpu_sim *gpu,unsigned level,
+    const cache_config &config,cache_block_t *source,cache_request_status accepted,mem_fetch *mf) {
+  if (!gpu->cache_fault_model_active || !mf->get_is_write() || accepted==RESERVATION_FAIL || !source) return;
+  const mem_access_byte_mask_t bytes=mf->get_access_byte_mask();
+  for (unsigned byte=0;byte<bytes.size();++byte)
+    if (bytes.test(byte) && byte<config.get_line_sz()) source->m_fault_overlay.clear_range(byte,1,"accepted_store_byte");
+  (void)level;
+}
