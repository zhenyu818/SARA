+      << ",\"line\":" << slot << ",\"allocation_version\":" << line->m_fault_overlay.version()
+      << ",\"block\":" << line->m_block_addr << ",\"tag\":" << line->m_tag << ",\"line_bytes\":" << a.line_bytes
+      << ",\"actual_allocated_lines\":" << a.lines << ",\"cache_type\":" << a.cache_type << '}'; return out.str();
