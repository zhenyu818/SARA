+// Production records initial physical slots once and then only changed slots.
+// The independent full-walk witness remains the default validation profile.
+// This is common acquisition machinery, never a SARA propagation optimization.
+inline bool changed_slot_profile() {
+  const char *value = getenv("SARA_CACHE_CAPTURE_PROFILE");
+  return value && std::string(value) == "changes";
+}
+inline std::map<const tag_array *, std::set<unsigned> > &changed_slots() {
+  static std::map<const tag_array *, std::set<unsigned> > value;
+  return value;
