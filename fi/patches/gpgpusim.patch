+#ifndef SARA_PTX_STATIC_CFG_H
+#define SARA_PTX_STATIC_CFG_H
+
+// Read-only structural metadata primitives; no PTX state/timing is executed.
+#include <stdint.h>
+#include <stddef.h>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace sara_cfg {
+
+struct instruction {
+  instruction() : pc(0), size(0), predicate(false), target_valid(false), target(0),
+                  exit_modifier(false), source_line(0), memory_read(false), memory_write(false), next_valid(false), next(0),
+                  taken_valid(false), taken(0), fallthrough_valid(false), fallthrough(0) {}
+  uint64_t pc;
+  unsigned size;
+  std::string base_opcode, opcode, source_file;
+  std::string full32_operands_json, bfi_operands_json, sfu_unchanged_effect_json, scalar_pure_effect_json;
+  bool predicate, target_valid;
+  uint64_t target;
+  bool exit_modifier;
+  unsigned source_line;
+  bool memory_read, memory_write;
+  std::string kind, unsupported;
+  bool next_valid;
+  uint64_t next;
+  bool taken_valid;
+  uint64_t taken;
+  bool fallthrough_valid;
+  uint64_t fallthrough;
+};
+
+struct result {
+  result() : complete(false) {}
+  bool complete;
+  std::vector<instruction> instructions;
+  std::vector<std::string> issues;
+};
+
+inline result complete_static_table(const std::vector<instruction> &input,
+                                    uint64_t start, uint64_t extent) {
+  result out;
+  out.instructions = input;
+  if (input.empty() || !extent || start > UINT64_MAX - extent) {
+    out.issues.push_back("empty_or_overflowing_assembled_function"); return out;
+  }
+  const uint64_t stop = start + extent;
+  uint64_t cursor = start;
+  std::set<uint64_t> pcs;
+  for (size_t i = 0; i < input.size(); ++i) {
+    const instruction &row = input[i];
+    if (row.pc != cursor || !row.size || row.size > 8 || cursor > stop || row.size > stop - cursor ||
+        !pcs.insert(row.pc).second) {
+      out.issues.push_back("assembled_pc_size_domain_not_contiguous"); return out;
+    }
+    cursor += row.size;
+  }
+  if (cursor != stop) { out.issues.push_back("assembled_extent_is_incomplete"); return out; }
+  for (size_t i = 0; i < out.instructions.size(); ++i) {
+    instruction &row = out.instructions[i];
+    const uint64_t following = row.pc + row.size;
+    // Output-only fields are rederived, even if a caller reuses a prior row.
+    row.unsupported.clear();
+    row.next_valid = row.taken_valid = row.fallthrough_valid = false;
+    row.next = row.taken = row.fallthrough = 0;
+    row.kind = row.memory_write ? "store" : row.memory_read ? "load" : "inst";
+    if (row.exit_modifier) row.unsupported = "instruction_exit_modifier_not_in_first_CFG_scope";
+    else if (row.base_opcode == "bra") {
+      row.kind = "branch";
+      if (!row.target_valid || !pcs.count(row.target)) row.unsupported = "direct_branch_target_not_in_assembled_function";
+      else { row.taken_valid = true; row.taken = row.target; }
+      if (row.predicate) {
+        if (!pcs.count(following)) row.unsupported = "conditional_branch_fallthrough_missing";
+        else { row.fallthrough_valid = true; row.fallthrough = following; }
+      }
+    } else if (row.base_opcode == "ret" || row.base_opcode == "exit") {
+      row.kind = "ret";
+      if (row.predicate) row.unsupported = "predicated_termination_not_in_first_CFG_scope";
+    } else if (row.base_opcode == "brx" || row.base_opcode == "break" || row.base_opcode == "breakaddr" ||
+               row.base_opcode == "call" || row.base_opcode == "callp" || row.base_opcode == "retp" ||
+               row.base_opcode == "brkpt" || row.base_opcode == "trap" || row.base_opcode == "ssy") {
+      row.unsupported = "indirect_or_interprocedural_control_not_in_first_CFG_scope";
+    } else {
+      if (!pcs.count(following)) row.unsupported = "nonterminal_function_falloff";
+      else { row.next_valid = true; row.next = following; }
+    }
+    if (!row.unsupported.empty()) out.issues.push_back(row.unsupported);
+  }
+  out.complete = out.issues.empty();
+  return out;
+}
+
+}  // namespace sara_cfg
+#endif
