+static void fault_validate_cache_read(gpgpu_sim *gpu,unsigned level,
+    const cache_config &config,tag_array *,unsigned,cache_request_status probe,
+    cache_request_status accepted,mem_fetch *mf) {
+  if (!gpu->cache_fault_model_active || mf->get_is_write() || accepted==RESERVATION_FAIL) return;
+  mem_fetch *owner=mf;
+  while(owner->get_inst().empty() && owner->get_original_mf()) owner=owner->get_original_mf();
+  const warp_inst_t &inst=owner->get_inst();
+  if (probe==HIT_RESERVED)
+    sara_fault::cache_approximation("inflight_request_uses_issue_snapshot",level==1?"l1d":"l2",gpu->cache_fault_realization_id);
+  if (level!=2) return; // an L1 merged request keeps its own functional operand
+  mf->m_fault_payload.clear();
+  if (!inst.empty()) {
+    const sara_fault::cache_read_key key(mf->get_sid(),mf->get_wid(),inst.pc,inst.get_issue_cycle(),config.block_addr(mf->get_addr()));
+    std::map<sara_fault::cache_read_key,sara_fault::cache_payload>::const_iterator found=gpu->cache_fault_snapshots.find(key);
+    if (found!=gpu->cache_fault_snapshots.end()) mf->m_fault_payload=found->second;
+    else if (sara_fault::live_cache_error())
+      sara_fault::cache_approximation("pre_fault_issue_snapshot_is_clean","l2",gpu->cache_fault_realization_id);
+  }
+  sara_fault::track_cache_payload(&mf->m_fault_payload);
+}
