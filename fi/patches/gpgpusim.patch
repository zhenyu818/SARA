+#ifndef SARA_TRACE_INTEGRITY_H
+#define SARA_TRACE_INTEGRITY_H
+
+// Standalone audit primitives. They observe execution/bytes and do not modify
+// PTX state, scheduling or fault-injection order.
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+#include <string>
+
+namespace sara_trace {
+
+struct attempt_counter {
+  attempt_counter() : value(0), overflow(false) {}
+  void next() {
+    if (value == UINT64_MAX) overflow = true;
+    else ++value;
+  }
+  uint64_t value;
+  bool overflow;
+};
+
+class sha256 {
+ public:
+  sha256() : bytes_(0), buffered_(0), overflow_(false) {
+    const uint32_t initial[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372,
+      0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+    memcpy(state_, initial, sizeof(state_));
+  }
+  void update(const void *data, size_t size) {
+    if (overflow_ || size > UINT64_MAX / 8 - bytes_) {
+      overflow_ = true;
+      return;
+    }
+    bytes_ += size;
+    const unsigned char *input = static_cast<const unsigned char *>(data);
+    while (size) {
+      const size_t room = 64 - buffered_;
+      const size_t count = size < room ? size : room;
+      memcpy(buffer_ + buffered_, input, count);
+      buffered_ += count;
+      input += count;
+      size -= count;
+      if (buffered_ == 64) {
+        compress(buffer_);
+        buffered_ = 0;
+      }
+    }
+  }
+  bool overflow() const { return overflow_; }
+  uint64_t bytes() const { return bytes_; }
+  std::string hex_digest() const {
+    if (overflow_) return std::string();
+    sha256 final(*this);
+    const uint64_t bits = bytes_ * 8;
+    final.buffer_[final.buffered_++] = 0x80;
+    if (final.buffered_ > 56) {
+      memset(final.buffer_ + final.buffered_, 0, 64 - final.buffered_);
+      final.compress(final.buffer_);
+      final.buffered_ = 0;
+    }
+    memset(final.buffer_ + final.buffered_, 0, 56 - final.buffered_);
+    for (unsigned i = 0; i < 8; ++i)
+      final.buffer_[63 - i] = static_cast<unsigned char>(bits >> (8 * i));
+    final.compress(final.buffer_);
+    const char alphabet[] = "0123456789abcdef";
+    std::string result;
+    for (unsigned i = 0; i < 8; ++i)
+      for (int shift = 28; shift >= 0; shift -= 4)
+        result += alphabet[(final.state_[i] >> shift) & 15];
+    return result;
+  }
+
+ private:
+  static uint32_t rotate(uint32_t value, unsigned count) {
+    return (value >> count) | (value << (32 - count));
+  }
+  void compress(const unsigned char *block) {
+    static const uint32_t k[64] = {
+      0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+      0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+      0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+      0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+      0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+      0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+      0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+      0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+    uint32_t w[64];
+    for (unsigned i = 0; i < 16; ++i) {
+      const unsigned char *p = block + 4 * i;
+      w[i] = (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16)
+             | (uint32_t(p[2]) << 8) | uint32_t(p[3]);
+    }
+    for (unsigned i = 16; i < 64; ++i) {
+      const uint32_t s0 = rotate(w[i-15],7) ^ rotate(w[i-15],18) ^ (w[i-15] >> 3);
+      const uint32_t s1 = rotate(w[i-2],17) ^ rotate(w[i-2],19) ^ (w[i-2] >> 10);
+      w[i] = w[i-16] + s0 + w[i-7] + s1;
+    }
+    uint32_t a=state_[0], b=state_[1], c=state_[2], d=state_[3];
+    uint32_t e=state_[4], f=state_[5], g=state_[6], h=state_[7];
+    for (unsigned i = 0; i < 64; ++i) {
+      const uint32_t s1 = rotate(e,6) ^ rotate(e,11) ^ rotate(e,25);
+      const uint32_t t1 = h + s1 + ((e & f) ^ (~e & g)) + k[i] + w[i];
+      const uint32_t s0 = rotate(a,2) ^ rotate(a,13) ^ rotate(a,22);
+      const uint32_t t2 = s0 + ((a & b) ^ (a & c) ^ (b & c));
+      h=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2;
+    }
+    state_[0]+=a; state_[1]+=b; state_[2]+=c; state_[3]+=d;
+    state_[4]+=e; state_[5]+=f; state_[6]+=g; state_[7]+=h;
+  }
+  uint32_t state_[8];
+  uint64_t bytes_;
+  unsigned char buffer_[64];
+  size_t buffered_;
+  bool overflow_;
+};
