+#ifndef SARA_CACHE_FAULT_OVERLAY_H
+#define SARA_CACHE_FAULT_OVERLAY_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <map>
+#include <set>
+#include <bitset>
+#include <string>
+#include <tuple>
+#include "cache_cold_data.h"
+#include "cache_compatibility.h"
+
+namespace sara_fault {
+
+template <unsigned LineBytes, unsigned SectorBytes>
+inline std::bitset<LineBytes> sector_byte_mask(unsigned sector) {
+  std::bitset<LineBytes> mask;
+  if (!SectorBytes || sector >= LineBytes / SectorBytes) return mask;
+  for (unsigned byte = sector * SectorBytes; byte < (sector + 1) * SectorBytes; ++byte)
+    mask.set(byte);
+  return mask;
+}
+
+
+struct overlay_byte {
+  overlay_byte() : mask(0) {}
+  overlay_byte(unsigned char value, const std::string &id) : mask(value), realization(id) {}
+  unsigned char mask;
+  std::string realization;
+};
+typedef std::map<uint64_t, overlay_byte> cache_payload;  // absolute byte addresses
+
+inline std::set<const cache_payload *> &inflight_cache_payloads() {
+  static std::set<const cache_payload *> *value = new std::set<const cache_payload *>;
+  return *value;
+}
+inline void track_cache_payload(const cache_payload *payload) {
+  if (payload != NULL && !payload->empty()) inflight_cache_payloads().insert(payload);
+}
+inline void retire_cache_payload(const cache_payload *payload) {
+  inflight_cache_payloads().erase(payload);
+}
+
+// One instance belongs to one physical cache slot. Allocation changes version;
+// mutation, overwrite, fill and invalidation change execution. A transfer assigns
+// bytes from a source snapshot, rather than XORing the same error a second time.
+class cache_overlay {
+ public:
+  cache_overlay() : block_(0), version_(0), execution_(0), line_bytes_(128), scope_(-1), writeback_sensitive_(true) {}
+  ~cache_overlay() { registry().erase(this); }
+  cache_overlay(const cache_overlay &) = delete;
+  cache_overlay &operator=(const cache_overlay &) = delete;
+  void configure(unsigned line_bytes, int scope = -1, bool writeback_sensitive = true) {
+    cold_.configuration(line_bytes);
+    line_bytes_ = line_bytes; scope_ = scope; writeback_sensitive_ = writeback_sensitive;
+  }
+  cold_invalid_data &cold() { return cold_; }
+  const cold_invalid_data &cold() const { return cold_; }
+  int scope() const { return scope_; }
+  static const std::set<cache_overlay *> &copies() { return registry(); }
+  void set_component(const char *component) { component_ = component; }
+  const char *component() const { return component_.empty() ? "l2" : component_.c_str(); }
+  uint64_t block() const { return block_; }
+  uint64_t version() const { return version_; }
+  uint64_t execution() const { return execution_; }
+  unsigned line_bytes() const { return line_bytes_; }
+  bool empty() const { return bytes_.empty(); }
+  std::string realization() const { return bytes_.empty() ? std::string() : bytes_.begin()->second.realization; }
+
+  void allocate(uint64_t block) {
+    if (!bytes_.empty()) note("reallocate", 0, line_bytes_);
+    bytes_.clear();
+    registry().erase(this);
+    block_ = block;
+    advance(version_);
+    cold_.metadata_allocation(version_);
+    advance(execution_);
+  }
+  bool flip(unsigned data_bit, const std::string &id) {
+    cold_invalid_data::reject_new_cause();
+    if (data_bit >= static_cast<uint64_t>(line_bytes_) * 8 || id.empty()) return false;
+    const unsigned byte = data_bit / 8;
+    overlay_byte &entry = bytes_[byte];
+    if (entry.mask && entry.realization != id) return false;
+    entry.mask ^= static_cast<unsigned char>(1U << (data_bit % 8));
+    entry.realization = id;
+    if (!entry.mask) bytes_.erase(byte);
+    update_registry();
+    advance(execution_);
+    return true;
+  }
+  unsigned char mask(unsigned byte) const {
+    std::map<unsigned, overlay_byte>::const_iterator found = bytes_.find(byte);
+    return found == bytes_.end() ? 0 : found->second.mask;
+  }
+  bool has_range(unsigned begin, unsigned count) const {
+    std::map<unsigned, overlay_byte>::const_iterator found = bytes_.lower_bound(begin);
+    return found != bytes_.end() && found->first - begin < count;
+  }
+  bool dirty_loss(bool modified, unsigned begin, unsigned count) const {
+    return modified && writeback_sensitive_ && has_range(begin, count);
+  }
+  void clear_range(unsigned begin, unsigned count, const char *event = "clear") {
+    std::map<unsigned, overlay_byte>::iterator item = bytes_.lower_bound(begin);
+    bool changed = false;
+    if (item != bytes_.end() && item->first - begin < count) note(event, begin, count);
+    while (item != bytes_.end() && item->first - begin < count) {
+      bytes_.erase(item++);
+      changed = true;
+    }
+    if (changed) advance(execution_);
+    update_registry();
+  }
+  cache_payload snapshot(unsigned begin, unsigned count) const {
+    cache_payload result;
+    for (std::map<unsigned, overlay_byte>::const_iterator item = bytes_.lower_bound(begin);
+         item != bytes_.end() && item->first - begin < count; ++item)
+      result[block_ + item->first] = item->second;
+    return result;
+  }
+  void replace_range(unsigned begin, unsigned count, const cache_payload &source) {
+    clear_range(begin, count, "fill_replace");
+    for (cache_payload::const_iterator item = source.begin(); item != source.end(); ++item) {
+      if (item->first >= block_ + begin && item->first - (block_ + begin) < count && item->second.mask)
+        bytes_[static_cast<unsigned>(item->first - block_)] = item->second;
+    }
+    advance(execution_);
+    update_registry();
+    cold_.finish_fill(begin, count, version_);
+  }
+
+ private:
+  static void advance(uint64_t &value) {
+    if (value == UINT64_MAX) { fprintf(stderr, "GPUFI_INVALID_CONFIGURATION reason=cache_overlay_lifetime_counter_overflow\n"); fflush(stderr); abort(); }
+    ++value;
+  }
