+static sara_host_copy::collector *static_memory_observer(gpgpu_t *gpu) {
+  const gpgpu_functional_sim_config &cfg = gpu->get_config();
+  sara_host_copy::configure(cfg.host_copy_ledger_file(), cfg.exact_trace_file(), cfg.exact_trace_enabled(), cfg.exact_trace_jsonl(), cfg.host_copy_ledger_budget_bytes(), cfg.cache_state_ledger());
+  return sara_host_copy::get();
+}
+static void observe_static_symbol(gpgpu_t *gpu, const symbol *sym) {
+  sara_host_copy::collector *o = static_memory_observer(gpu); if (!o) return;
+  o->allocate(sym->get_address(), sym->get_size_in_bytes(), "symbol", sara_exact_trace_instruction_cursor(),
+              sym->name(), false, sym->uid());
+  o->symbol_definition(sym->uid(), sym->name(), sym->get_address(), sym->get_size_in_bytes(),
+                       sym->is_const(), sym->is_global(), sara_exact_trace_instruction_cursor());
+}
+static void observe_static_bytes(gpgpu_t *gpu, const symbol *sym, uint64_t address, unsigned count, const void *literal) {
+  sara_host_copy::collector *o = sara_host_copy::get();
+  if (!o) return;
+  if (!count) return;
+  const bool capture_values = o->capture_memory_values();
+  std::vector<unsigned char> actual;
+  if (capture_values) {
+    actual.resize(count);
+    gpu->get_global_memory()->read(address, count, &actual[0]);
+  }
+  std::ostringstream row; row << "\"symbol_uid\":" << sym->uid() << ",\"symbol_name\":" << sara_host_copy::quoted(sym->name())
+      << ",\"address\":" << address << ",\"count\":" << count
+      << ",\"literal_bytes\":" << (capture_values ? sara_host_copy::quoted(sara_host_copy::hexbytes(static_cast<const unsigned char *>(literal), count)) : "null")
+      << ",\"actual_bytes\":" << (capture_values ? sara_host_copy::quoted(sara_host_copy::hexbytes(&actual[0], count)) : "null");
+  o->cache_event("static_initialization", sara_exact_trace_instruction_cursor(), row.str());
+}
