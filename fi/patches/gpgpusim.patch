+#ifndef SARA_TRACE_GZIP_STORAGE_H
+#define SARA_TRACE_GZIP_STORAGE_H
+
+// Optional lossless transport only. Instruction serialization, counters and
+// the decoded trace/host-ledger hash stay in the existing exact trace writer.
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <fcntl.h>
+#include <stdexcept>
+#include <string>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <zlib.h>
+#include "trace_integrity.h"
+
+namespace sara_trace {
+class gzip_storage {
+ public:
+  gzip_storage() : stream_(NULL), fd_(-1), physical_bytes_(0), closed_(false) {}
+  ~gzip_storage() { if (stream_ != NULL) gzclose(stream_); }
+  gzip_storage(const gzip_storage &) = delete;
+  gzip_storage &operator=(const gzip_storage &) = delete;
+  bool is_open() const { return stream_ != NULL; }
+  bool closed() const { return closed_; }
+  uint64_t physical_bytes() const { if (!closed_) error("unclosed gzip size"); return physical_bytes_; }
+  const std::string &physical_sha256() const { if (!closed_) error("unclosed gzip digest"); return physical_sha256_; }
+
+  void open(const std::string &path) {
+    if (is_open() || closed_ || path.empty()) error("invalid gzip open");
+    // Match the legacy private-work-directory overwrite behavior; reject a
+    // symbolic link as the output file. No uncompressed disk copy is written.
+    fd_ = ::open(path.c_str(), O_RDWR | O_CREAT | O_TRUNC | O_NOFOLLOW, 0600);
+    if (fd_ < 0) error("gzip file open");
+    struct stat value;
+    if (fstat(fd_, &value) || !S_ISREG(value.st_mode)) {
+      ::close(fd_); fd_ = -1; error("gzip output is not regular");
+    }
+    stream_ = gzdopen(fd_, "wb1");
+    if (stream_ == NULL) { ::close(fd_); fd_ = -1; error("gzdopen"); }
+    // Low compression level limits added CPU work. Both methods must disclose
+    // their actually required acquisition/compression costs independently.
+    if (gzbuffer(stream_, 64 * 1024) != 0) error("gzip buffer");
+  }
+
+  void write(const char *bytes, size_t size) {
+    if (!is_open() || (size && bytes == NULL)) error("invalid gzip write");
+    while (size) {
+      const unsigned count = static_cast<unsigned>(size > 1024 * 1024 ? 1024 * 1024 : size);
+      if (gzwrite(stream_, bytes, count) != static_cast<int>(count)) error("gzip short write");
+      bytes += count; size -= count;
+    }
+  }
+
+  void flush() {
+    if (!is_open() || gzflush(stream_, Z_SYNC_FLUSH) != Z_OK || fsync(fd_) != 0)
+      error("gzip flush/fsync");
+  }
+
+  void close() {
+    if (!is_open()) error("gzip close without open");
+    const int owned = dup(fd_);
+    if (owned < 0) error("gzip duplicate close descriptor");
+    gzFile old = stream_; stream_ = NULL; fd_ = -1;
+    if (gzclose(old) != Z_OK) { ::close(owned); error("gzip close/CRC write"); }
+    if (fsync(owned) != 0 || lseek(owned, 0, SEEK_SET) != 0) {
+      ::close(owned); error("gzip final sync/seek");
+    }
+    struct stat before, after;
+    if (fstat(owned, &before) != 0 || before.st_size <= 0) {
+      ::close(owned); error("gzip closed size");
+    }
+    sara_trace::sha256 hash; char buffer[64 * 1024];
+    while (true) {
+      const ssize_t count = ::read(owned, buffer, sizeof(buffer));
+      if (count < 0 && errno == EINTR) continue;
+      if (count < 0) { ::close(owned); error("gzip physical read"); }
+      if (!count) break;
+      hash.update(buffer, static_cast<size_t>(count));
+      if (hash.overflow()) { ::close(owned); error("gzip physical hash overflow"); }
+    }
+    if (fstat(owned, &after) != 0 || before.st_dev != after.st_dev || before.st_ino != after.st_ino ||
+        before.st_size != after.st_size || hash.bytes() != static_cast<uint64_t>(before.st_size)) {
+      ::close(owned); error("gzip bytes changed during close");
+    }
+    if (::close(owned) != 0) error("gzip descriptor close");
+    physical_bytes_ = hash.bytes(); physical_sha256_ = hash.hex_digest(); closed_ = true;
+  }
+
+ private:
+  static void error(const char *reason) { throw std::runtime_error(std::string("trace gzip storage: ") + reason); }
+  gzFile stream_;
+  int fd_;
+  uint64_t physical_bytes_;
+  bool closed_;
+  std::string physical_sha256_;
+};
+}  // namespace sara_trace
+#endif
