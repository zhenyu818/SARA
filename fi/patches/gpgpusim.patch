+#ifndef SARA_PTX_LM_RZI_EQ_OPS_H
+#define SARA_PTX_LM_RZI_EQ_OPS_H
+#include <cstdint>
+#include <stdexcept>
+namespace sara_ptx {
+// Integral-valued binary32 truncation uses raw bits, never a host FP operation.
+inline uint32_t cvt_f32_f32_rzi_bits(uint32_t a) {
+    const uint32_t magnitude=a&0x7fffffffu,sign=a&0x80000000u;
+    if (magnitude>0x7f800000u) return 0x7fc00000u;
+    const unsigned exponent=magnitude>>23;
+    if (exponent<127) return sign;
+    if (exponent>=150) return a;
+    const unsigned discarded=150-exponent;  // 1..23; no width-sized shift.
+    return a&~((uint32_t(1)<<discarded)-1u);
+}
+// Ordered equality: NaN is false, both signed zeros equal, other words exact.
+inline bool setp_eq_f32_bits(uint32_t a,uint32_t b) {
+    const uint32_t aa=a&0x7fffffffu,bb=b&0x7fffffffu;
+    if (aa>0x7f800000u || bb>0x7f800000u) return false;
+    return (aa==0 && bb==0) || a==b;
+}
+// Only the nine ordinary single-predicate F32 forms in the actual inventory.
+// Raw classification/order avoids host DAZ and signaling-NaN exception flags.
+enum f32_comparison : unsigned { FP32_EQ,FP32_LT,FP32_LE,FP32_GT,FP32_GE,
+                      FP32_LTU,FP32_LEU,FP32_GTU,FP32_NEU };
+inline bool setp_compare_f32_bits(uint32_t a,uint32_t b,f32_comparison op) {
+    const uint32_t aa=a&0x7fffffffu,bb=b&0x7fffffffu;
+    const bool unordered=aa>0x7f800000u || bb>0x7f800000u;
+    const bool equal=(aa==0 && bb==0) || a==b;
+    const uint32_t ka=(a&0x80000000u) ? ~a : a^0x80000000u;
+    const uint32_t kb=(b&0x80000000u) ? ~b : b^0x80000000u;
+    const bool less=!equal && ka<kb,greater=!equal && ka>kb;
+    switch(op) {
+      case FP32_EQ:return setp_eq_f32_bits(a,b);
+      case FP32_LT:return !unordered && less;
+      case FP32_LE:return !unordered && (less || equal);
+      case FP32_GT:return !unordered && greater;
+      case FP32_GE:return !unordered && (greater || equal);
+      case FP32_LTU:return unordered || less;
+      case FP32_LEU:return unordered || less || equal;
+      case FP32_GTU:return unordered || greater;
+      case FP32_NEU:return unordered || !equal;
+      default:throw std::invalid_argument("unreviewed F32 predicate comparison");
+    }
+}
+}  // namespace sara_ptx
+#endif
