+// Exact four scalar SFU effect facts only, never replay/runtime authority.
+// All arithmetic and latency assignment remain in the shared core. A changed
+// input is deliberately NOT evaluated by the unchanged-input replay adapter.
+static std::string trace_sfu_unchanged_effect(const ptx_instruction *instruction) {
+  const std::string opcode = extract_opcode_token(instruction);
+  const bool approximate = opcode == "ex2.approx.ftz.f32" || opcode == "rcp.approx.ftz.f32";
+  const bool rounded = opcode == "rcp.rn.f32" || opcode == "sqrt.rn.f32";
+  if ((!approximate && !rounded) || instruction->get_type() != F32_TYPE ||
+      instruction->get_scalar_type().size() != 1 || instruction->get_num_operands() != 2 ||
+      instruction->is_exit() || instruction->has_memory_read() || instruction->has_memory_write() ||
+      instruction->op != SFU_OP || !instruction->latency || !instruction->initiation_interval) return "null";
+  if ((opcode == "ex2.approx.ftz.f32" && instruction->get_opcode() != EX2_OP) ||
+      ((opcode == "rcp.approx.ftz.f32" || opcode == "rcp.rn.f32") && instruction->get_opcode() != RCP_OP) ||
+      (opcode == "sqrt.rn.f32" && instruction->get_opcode() != SQRT_OP)) return "null";
+  unsigned ftz = 0, approx = 0, rn = 0;
+  const std::list<int> options = instruction->get_options();
+  for (std::list<int>::const_iterator option = options.begin(); option != options.end(); ++option) {
+    if (*option == FTZ_OPTION) ++ftz;
+    else if (*option == APPROX_OPTION) ++approx;
+    else if (*option == RN_OPTION) ++rn;
+    else return "null";
+  }
+  if ((approximate && (ftz != 1 || approx != 1 || rn)) ||
+      (rounded && (rn != 1 || ftz || approx))) return "null";
+  if (instruction->has_pred() && instruction->get_pred_mod() != -1) return "null";
+  const symbol *predicate = instruction->has_pred() ? instruction->get_pred().get_symbol() : NULL;
+  if (instruction->has_pred() && (!predicate || !predicate->is_reg() || !predicate->uid() ||
+      !predicate->type() || predicate->type()->get_key().scalar_type() != PRED_TYPE)) return "null";
+  const operand_info &dst = instruction->dst(), &src = instruction->src1();
+  const operand_info *operands[] = {&dst, &src};
+  for (unsigned index = 0; index < 2; ++index) {
+    const operand_info &operand = *operands[index];
+    if (operand.is_vector() || operand.get_addr_space() != undefined_space || operand.get_operand_lohi() ||
+        operand.get_operand_neg() || operand.is_neg_pred() || operand.get_double_operand_type()) return "null";
+  }
+  const symbol *write = dst.is_reg() ? dst.get_symbol() : NULL;
+  if (!write || !write->is_reg() || !write->uid() || write->name() == "_" || !write->type() ||
+      write->get_size_in_bytes() != 4 || write->type()->get_key().scalar_type() == PRED_TYPE) return "null";
+  std::ostringstream out;
+  out << "{\"schema\":\"sara-assembled-four-SFU-effect-v1\",\"opcode\":\"" << opcode
+      << "\",\"source_line_projection\":\"existing_ptx_ir_removes_tabs_v1\",\"assembled_source_line\":\""
+      << json_escape(instruction->get_source()) << "\",\"memory\":false,\"control\":false,\"implicit_state\":false,"
+      << "\"route\":\"SFU\",\"latency\":" << instruction->latency
+      << ",\"initiation_interval\":" << instruction->initiation_interval << ",\"predicate\":";
+  if (predicate) out << "{\"name\":\"" << json_escape(predicate->name()) << "\",\"register_uid\":" << predicate->uid()
+      << ",\"modifier\":-1,\"negated\":" << (instruction->get_pred_neg() ? "true" : "false") << '}';
+  else out << "null";
+  out << ",\"sources\":[{\"role\":\"operand\",\"width_bits\":32";
+  if (src.is_reg()) {
+    const symbol *read = src.get_symbol();
+    if (!read || !read->is_reg() || !read->uid() || read->name() == "_" || !read->type() ||
+        read->get_size_in_bytes() != 4 || read->type()->get_key().scalar_type() == PRED_TYPE) return "null";
+    out << ",\"kind\":\"register\",\"name\":\"" << json_escape(read->name()) << "\",\"register_uid\":" << read->uid();
+  } else if (src.is_literal() && src.get_type() == float_op_t) {
+    out << ",\"kind\":\"literal\",\"value\":\"" << hex_u64(src.get_literal_value().u32) << '\"';
+  } else return "null";
+  out << "}],\"destinations\":[{\"width_bits\":32,\"name\":\"" << json_escape(write->name())
+      << "\",\"register_uid\":" << write->uid() << "}]}";
+  return out.str();
+}
