+#ifndef SARA_PTX_BIT_OPS_H
+#define SARA_PTX_BIT_OPS_H
+#include <cstdint>
+#include <stdexcept>
+namespace sara_ptx {
+inline uint64_t bit_mask(unsigned width) {
+    if (!width || width > 64) throw std::invalid_argument("invalid PTX scalar width");
+    return width == 64 ? ~uint64_t(0) : (uint64_t(1) << width) - 1;
+}
+// PTX ISA 7.8, 9.7.1.20: c/d are u32, each restricted to its low eight bits.
+// Clip before shifting, including the whole-width and empty-field cases.
+inline uint64_t bitfield_insert(uint64_t source, uint64_t base, unsigned width,
+                               uint32_t position, uint32_t length) {
+    if (width != 32 && width != 64)
+        throw std::invalid_argument("invalid PTX bfi width");
+    const uint64_t word_mask = bit_mask(width);
+    base &= word_mask;
+    const unsigned pos = position & 0xffU, len = length & 0xffU;
+    if (pos >= width || len == 0) return base;
+    const unsigned count = len < width - pos ? len : width - pos;
+    const uint64_t low_mask = bit_mask(count);
+    const uint64_t field_mask = low_mask << pos;
+    return ((base & ~field_mask) | ((source & low_mask) << pos)) & word_mask;
+}
+inline uint64_t shift_left(uint64_t value, unsigned width, uint32_t count) {
+    return count >= width ? 0 : (value << count) & bit_mask(width);
+}
+inline uint64_t shift_right(uint64_t value, unsigned width, uint32_t count, bool arithmetic) {
+    const uint64_t mask = bit_mask(width);
+    value &= mask;
+    const bool negative = arithmetic && (value & (uint64_t(1) << (width - 1)));
+    if (count >= width) return negative ? mask : 0;
+    uint64_t result = value >> count;
+    if (negative && count) result |= mask ^ (mask >> count);
+    return result;
+}
+}  // namespace sara_ptx
+#endif
