+#ifndef SARA_PTX_TRACE_OPCODE_H
+#define SARA_PTX_TRACE_OPCODE_H
+#include <string>
+#include <vector>
+
+namespace sara_ptx {
+// Carry volatile in the lexer's semantic value: mutating recognizer state
+// inside the lexer would race the parser's lookahead/reset boundary.
+static const int volatile_opcode_flag = 1 << 24;
+inline int opcode_payload(int opcode, bool is_volatile) {
+  return opcode | (is_volatile ? volatile_opcode_flag : 0);
+}
+inline int payload_opcode(int payload) { return payload & ~volatile_opcode_flag; }
+inline bool payload_is_volatile(int payload) { return (payload & volatile_opcode_flag) != 0; }
+
+struct trace_opcode_fields {
+  std::string base;
+  std::string space;
+  std::vector<std::string> options;
+  std::vector<std::string> types;
+  bool is_volatile;
+  trace_opcode_fields() : is_volatile(false) {}
+};
+
+inline std::string structured_trace_opcode(const trace_opcode_fields &fields) {
+  std::string result = fields.base.empty() ? "unsupported_opcode" : fields.base;
+  if (fields.is_volatile) result += ".volatile";
+  // cvta.to.global and ld.volatile.global have different qualifier order.
+  if (fields.base == "cvta") {
+    for (unsigned i = 0; i < fields.options.size(); ++i) result += "." + fields.options[i];
+    if (!fields.space.empty()) result += "." + fields.space;
+  } else {
+    if (!fields.space.empty()) result += "." + fields.space;
+    for (unsigned i = 0; i < fields.options.size(); ++i) result += "." + fields.options[i];
+  }
+  for (unsigned i = 0; i < fields.types.size(); ++i) result += "." + fields.types[i];
+  return result;
+}
+}  // namespace sara_ptx
+#endif
