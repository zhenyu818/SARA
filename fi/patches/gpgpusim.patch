+#ifndef SARA_CACHE_TAG_GUARD_H
+#define SARA_CACHE_TAG_GUARD_H
+
+#include <stdint.h>
+#include <map>
+#include <string>
+#include <vector>
+#include "cache_fault_overlay.h"
+
+namespace sara_fault {
+// A simulator-specific geometry/model descriptor, not a hardware tag claim.
+struct tag_cache_geometry {
+  std::vector<uint64_t> fields;
+  bool operator==(const tag_cache_geometry &other) const { return fields == other.fields; }
+};
+struct tag_cache_owner {
+  tag_cache_owner() : instance(0), epoch(0), config(NULL), allocated_lines(0), line_bytes(0), cache_type(0) {}
+  uint64_t instance, epoch;
+  const void *config;
+  uint64_t allocated_lines, line_bytes, cache_type;
+  tag_cache_geometry geometry;
+};
+struct tag_fault_stamp {
+  tag_fault_stamp() : owner(NULL), instance(0), epoch(0), slot_index(0), version(0),
+      reference_tag(0), block(0), block_known(false), writeback_sensitive(true) {}
+  const void *owner;
+  uint64_t instance, epoch, slot_index, version, reference_tag, block;
+  bool block_known, writeback_sensitive;
+  std::string component, realization;
+};
+inline std::map<const void *, tag_cache_owner> &tag_cache_owners() {
+  static std::map<const void *, tag_cache_owner> *value = new std::map<const void *, tag_cache_owner>;
+  return *value;
+}
+inline std::map<const void *, tag_fault_stamp> &tag_fault_slots() {
+  static std::map<const void *, tag_fault_stamp> *value = new std::map<const void *, tag_fault_stamp>;
+  return *value;
+}
+inline uint64_t &tag_cache_next_instance() { static uint64_t value = 0; return value; }
+inline bool tag_faults_active() { return !tag_fault_slots().empty(); }
+inline void tag_cache_owner_end(const void *owner, bool terminal_destruction = false) {
+  cold_invalid_data::owner_change(owner, "cold_pending_owner_destroyed_or_reinitialized", terminal_destruction);
+  for (std::map<const void *, tag_fault_stamp>::iterator it = tag_fault_slots().begin(); it != tag_fault_slots().end();) {
+    if (it->second.owner == owner) tag_fault_slots().erase(it++);
+    else ++it;
+  }
+  tag_cache_owners().erase(owner);
+}
+inline void tag_cache_owner_begin(const void *owner, const tag_cache_geometry &geometry,
+    const void *config = NULL, uint64_t allocated_lines = 0, uint64_t line_bytes = 0, uint64_t cache_type = 0) {
+  // Destruction/reconstruction at the same address cannot inherit old stamps.
+  for (std::map<const void *, tag_fault_stamp>::const_iterator it = tag_fault_slots().begin(); it != tag_fault_slots().end(); ++it)
+    if (it->second.owner == owner)
+      cache_approximation("tag_cache_reinitialized_with_live_fault", it->second.component.c_str(), it->second.realization);
+  tag_cache_owner_end(owner);
+  if (tag_cache_next_instance() == UINT64_MAX)
+    cache_approximation("tag_cache_instance_overflow", "cache", "none");
+  tag_cache_owner &entry = tag_cache_owners()[owner];
+  entry.instance = ++tag_cache_next_instance(); entry.epoch = 1; entry.geometry = geometry;
+  entry.config = config; entry.allocated_lines = allocated_lines;
+  entry.line_bytes = line_bytes; entry.cache_type = cache_type;
+}
+inline void tag_cache_check_geometry(const void *owner, const tag_cache_geometry &geometry) {
+  std::map<const void *, tag_cache_owner>::iterator found = tag_cache_owners().find(owner);
+  if (found == tag_cache_owners().end())
+    cache_approximation("unregistered_tag_cache_instance", "cache", "none");
+  if (found->second.geometry == geometry) return;
+  cold_invalid_data::owner_change(owner, "cold_pending_geometry_changed");
+  for (std::map<const void *, tag_fault_stamp>::const_iterator it = tag_fault_slots().begin(); it != tag_fault_slots().end(); ++it)
+    if (it->second.owner == owner)
+      cache_approximation("tag_fault_cache_geometry_changed", it->second.component.c_str(), it->second.realization);
+  if (found->second.epoch == UINT64_MAX)
+    cache_approximation("tag_cache_epoch_overflow", "cache", "none");
+  ++found->second.epoch; found->second.geometry = geometry;
+}
+// Called at the real shared configuration mutation, never by an observer.
+// Preflight EVERY affected owner before committing any new epoch. These bounds
+// are constructor-captured backing capacity, not current configured capacity.
+inline void tag_cache_config_changed(const void *config, const tag_cache_geometry &geometry) {
+  std::map<const void *, tag_cache_owner> &owners = tag_cache_owners();
+  for (std::map<const void *, tag_cache_owner>::const_iterator owner = owners.begin(); owner != owners.end(); ++owner) {
+    const tag_cache_owner &entry = owner->second;
+    if (entry.config != config || entry.geometry == geometry) continue;
+    cold_invalid_data::owner_change(owner->first, "cold_pending_config_geometry_changed");
+    if (!config || geometry.fields.size() != 10 || !entry.allocated_lines ||
+        !geometry.fields[0] || !geometry.fields[1] ||
+        geometry.fields[0] > entry.allocated_lines / geometry.fields[1] ||
+        geometry.fields[2] != entry.line_bytes || geometry.fields[4] != entry.cache_type) {
+      fprintf(stderr, "GPUFI_INVALID_CONFIGURATION reason=cache_reconfiguration_exceeds_actual_allocation\n");
+      fflush(stderr); abort();
+    }
+    for (std::map<const void *, tag_fault_stamp>::const_iterator stamp = tag_fault_slots().begin(); stamp != tag_fault_slots().end(); ++stamp)
+      if (stamp->second.owner == owner->first)
+        cache_approximation("tag_fault_cache_geometry_changed", stamp->second.component.c_str(), stamp->second.realization);
+    if (entry.epoch == UINT64_MAX)
+      cache_approximation("tag_cache_epoch_overflow", "cache", "none");
+    // A changed physical mapping with any outstanding data/payload cause has
+    // no current cross-epoch numeric proof. Preserve it as explicit refusal.
+    if (live_cache_error())
+      cache_approximation("cache_geometry_changed_with_live_data_fault", "cache", active_cache_realization());
+  }
+  for (std::map<const void *, tag_cache_owner>::iterator owner = owners.begin(); owner != owners.end(); ++owner) {
+    tag_cache_owner &entry = owner->second;
+    if (entry.config == config && !(entry.geometry == geometry)) {
+      ++entry.epoch; entry.geometry = geometry;
+    }
+  }
+}
+inline void tag_fault_remember(const void *owner, const void *slot, uint64_t slot_index,
+    uint64_t version, uint64_t reference_tag, uint64_t block, bool block_known,
+    bool writeback_sensitive, const char *component, const std::string &realization) {
+  cold_invalid_data::reject_new_cause();
+  if (!slot || realization.empty() || tag_fault_slots().count(slot))
+    cache_approximation("multiple_or_unidentified_tag_fault", component, realization);
+  std::map<const void *, tag_cache_owner>::const_iterator found = tag_cache_owners().find(owner);
+  if (found == tag_cache_owners().end())
+    cache_approximation("unregistered_tag_cache_instance", component, realization);
+  tag_fault_stamp stamp;
+  stamp.owner = owner; stamp.instance = found->second.instance; stamp.epoch = found->second.epoch;
+  stamp.slot_index = slot_index; stamp.version = version; stamp.reference_tag = reference_tag;
+  stamp.block = block; stamp.block_known = block_known; stamp.writeback_sensitive = writeback_sensitive;
+  stamp.component = component; stamp.realization = realization;
+  tag_fault_slots()[slot] = stamp;
+}
+inline const tag_fault_stamp *tag_fault_bound(const void *slot, uint64_t version) {
+  std::map<const void *, tag_fault_stamp>::const_iterator found = tag_fault_slots().find(slot);
+  if (found == tag_fault_slots().end()) return NULL;
+  const tag_fault_stamp &stamp = found->second;
+  std::map<const void *, tag_cache_owner>::const_iterator owner = tag_cache_owners().find(stamp.owner);
+  if (owner == tag_cache_owners().end() || owner->second.instance != stamp.instance ||
+      owner->second.epoch != stamp.epoch || stamp.version != version)
+    cache_approximation("tag_fault_copy_identity_changed", stamp.component.c_str(), stamp.realization);
+  return &stamp;
+}
+inline void tag_fault_check_lookup(const void *slot, uint64_t version,
+    uint64_t requested_block, uint64_t stored_block, bool tag_matches, bool live_line) {
+  if (!tag_faults_active()) return;
+  const tag_fault_stamp *stamp = tag_fault_bound(slot, version);
+  if (!stamp || !tag_matches || !live_line) return;
+  if (!stamp->block_known || stamp->block != stored_block || requested_block != stored_block)
+    cache_approximation("tag_false_hit_or_sector_alias", stamp->component.c_str(), stamp->realization);
+}
+inline void tag_fault_check_dirty(const void *slot, uint64_t version,
+    uint64_t current_tag, bool modified, const char *reason) {
+  if (!tag_faults_active()) return;
+  const tag_fault_stamp *stamp = tag_fault_bound(slot, version);
+  if (stamp && modified && stamp->writeback_sensitive &&
+      (!stamp->block_known || current_tag != stamp->reference_tag))
+    cache_approximation(reason, stamp->component.c_str(), stamp->realization);
+}
+inline void tag_fault_before_allocate(const void *slot, uint64_t version,
+    uint64_t current_tag, bool modified) {
+  tag_fault_check_dirty(slot, version, current_tag, modified, "dirty_tag_reallocation");
+  // Full allocation overwrites the tag. Invalidation alone deliberately does not.
+  tag_fault_slots().erase(slot);
+}
+inline void tag_fault_slot_destroy(const void *slot) { tag_fault_slots().erase(slot); }
+}  // namespace sara_fault
