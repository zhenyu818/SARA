+#ifndef SARA_PTX_LM_WIDTH_OPS_H
+#define SARA_PTX_LM_WIDTH_OPS_H
+#include <cstdint>
+
+namespace sara_ptx {
+// CUDA 11.8 PTX 7.8, cvt.rn.f32.s32. Input/output are raw words.
+// Integer-only RN-even rounding: no floating cast, signed negation, ambient
+// rounding, DAZ/FTZ, floating exception flags or host conversion intrinsic.
+inline uint32_t cvt_s32_f32_rn_bits(uint32_t input) {
+    const uint32_t sign = input & 0x80000000u;
+    const uint32_t magnitude = sign ? uint32_t(0) - input : input;
+    if (!magnitude) return 0;
+    unsigned top = 0;
+    for (uint32_t scan = magnitude; scan > 1; scan >>= 1) ++top;
+    uint32_t significand;
+    if (top <= 23) {
+        significand = magnitude << (23 - top);
+    } else {
+        const unsigned shift = top - 23;  // 1..8, including raw INT32_MIN.
+        significand = magnitude >> shift;
+        const uint32_t remainder = magnitude & ((uint32_t(1) << shift) - 1);
+        const uint32_t midpoint = uint32_t(1) << (shift - 1);
+        if (remainder > midpoint || (remainder == midpoint && (significand & 1)))
+            ++significand;
+        if (significand == (uint32_t(1) << 24)) {
+            significand >>= 1;
+            ++top;
+        }
+    }
+    return sign | (uint32_t(top + 127) << 23) | (significand & 0x007fffffu);
+}
+
+// CUDA 11.8 PTX 7.8, cvt.rn.f64.s64: exact integer significand rounding.
+// Input is the raw two's-complement word, including INT64_MIN. No signed
+// negation, floating cast, host rounding, DAZ/FTZ or floating flags are used.
+inline uint64_t cvt_s64_f64_rn_bits(uint64_t input) {
+    const uint64_t sign = input & UINT64_C(0x8000000000000000);
+    const uint64_t magnitude = sign ? uint64_t(0) - input : input;
+    if (!magnitude) return 0;
+    unsigned top = 0;
+    for (uint64_t scan = magnitude; scan > 1; scan >>= 1) ++top;
+    uint64_t significand;
+    if (top <= 52) {
+        significand = magnitude << (52 - top);
+    } else {
+        const unsigned shift = top - 52;  // 1..11 for signed 64-bit input.
+        significand = magnitude >> shift;
+        const uint64_t remainder = magnitude & ((uint64_t(1) << shift) - 1);
+        const uint64_t midpoint = uint64_t(1) << (shift - 1);
+        if (remainder > midpoint || (remainder == midpoint && (significand & 1)))
+            ++significand;
+        if (significand == (uint64_t(1) << 53)) {
+            significand >>= 1;
+            ++top;
+        }
+    }
+    return sign | (uint64_t(top + 1023) << 52)
+        | (significand & UINT64_C(0x000fffffffffffff));
+}
+
+// CUDA 11.8 PTX 7.8, mad.wide.u32: widen BEFORE multiplication; c/d are u64.
+// Unsigned addition implements the specified low 64-bit destination word.
+inline uint64_t mad_wide_u32(uint32_t a, uint32_t b, uint64_t c) {
+    return uint64_t(a) * uint64_t(b) + c;
+}
+}  // namespace sara_ptx
+#endif
