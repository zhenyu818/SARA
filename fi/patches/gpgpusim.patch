+    row << ",\"observed_active_kernel_uids\":[";
+    for (std::set<uint64_t>::const_iterator i = active_kernels_.begin(); i != active_kernels_.end(); ++i) {
+      if (i != active_kernels_.begin()) row << ',';
+      row << *i;
+    }
+    row << ']';
+    event("api_request", cursor, row.str()); return api_count_;
+  }
+  // Read-only diagnostic query. The caller may wait on the host; this method
+  // never pauses simulation, initializes a runtime or writes an evidence row.
+  // 1=idle, 2=exactly one actual launched kernel, 3=ambiguous multiple kernels.
+  int active_kernel_query(uint64_t &uid) {
+    std::lock_guard<std::mutex> lock(lock_); uid = 0;
+    if (active_kernels_.empty()) return 1;
+    if (active_kernels_.size() != 1) return 3;
+    uid = *active_kernels_.begin(); return 2;
+  }
+  void api_return(uint64_t id, int status, uint64_t cursor) {
+    std::lock_guard<std::mutex> lock(lock_); caller(cursor); request *r = lookup(id, cursor);
+    if (!r || r->returned) fail("unmatched_or_duplicate_return");
+    r->returned = true;
+    increment(returned_);
+    if (!r->queued || status || r->skipped) block("copy_API_return_without_successful_queue", cursor);
+    std::ostringstream row; row << "\"request_id\":" << id << ",\"status\":" << status;
+    event("api_return", cursor, row.str());
+  }
+  void queued(uint64_t id, uint64_t stream, uint64_t cursor) {
+    std::lock_guard<std::mutex> lock(lock_); request *r = lookup(id, cursor); increment(queued_);
+    if (r) {
+      if (r->queued || r->skipped) fail("duplicate_queue");
+      r->queued = true; r->stream = stream;
+    }
+    std::ostringstream row; row << "\"request_id\":" << id << ",\"resolved_stream_uid\":" << stream << ",\"observed_active_kernel_uids\":[";
+    for (std::set<uint64_t>::const_iterator i = active_kernels_.begin(); i != active_kernels_.end(); ++i) {
+      if (i != active_kernels_.begin()) row << ",";
+      row << *i;
+    }
+    row << "]"; event("queue", cursor, row.str());
+  }
+  void skipped(uint64_t id, uint64_t cursor) {
+    std::lock_guard<std::mutex> lock(lock_); request *r = lookup(id, cursor); increment(skipped_);
+    if (r) {
+      if (r->queued || r->skipped) fail("duplicate_skip");
+      r->skipped = true;
+    }
+    block("operation_skipped_by_simulation_limit", cursor); event("queue_skipped", cursor, "\"request_id\":" + std::to_string(id));
+  }
+  void entered(uint64_t id, uint64_t stream, uint64_t cursor, bool idle, const std::string &state) {
+    std::lock_guard<std::mutex> lock(lock_); increment(entered_); request *r = lookup(id, cursor);
+    if (r && (!r->queued || r->stream != stream || r->entered)) fail("service_queue_identity_mismatch");
+    if (r) r->entered = true;
+    // The service runs on the sole simulation thread: kernels may be active,
+    // but no instruction executes inside the observed byte-copy helper.
+    // Activity/limit/deadlock are retained separately; false active() is unused.
+    std::ostringstream row; row << "\"request_id\":" << id << ",\"resolved_stream_uid\":" << stream
+      << ",\"idle\":" << (idle ? "true" : "false") << ",\"gpu_state\":" << state;
+    event("service_enter", cursor, row.str());
+  }
+  copy_token copy_begin(const std::string &kind, uint64_t source, uint64_t destination,
+      uint64_t count, uint64_t cycle, uint64_t cursor, uint64_t symbol_handle = 0, uint64_t symbol_offset = 0) {
+    std::lock_guard<std::mutex> lock(lock_); increment(attempted_); service_context &c = current_service();
+    copy_token t; t.sequence = attempted_; t.request = c.active ? c.request : 0;
+    t.source = source; t.destination = destination; t.count = count; t.kind = kind; c.helper = t.sequence;
+    request *r = lookup(t.request, cursor);
+    allocation *src = kind == "h2d" || kind == "symbol_to" || kind == "memset" ? NULL : locate(source, count);
+    allocation *dst = kind == "d2h" || kind == "symbol_from" ? NULL : locate(destination, count);
+    const bool src_needed = kind == "d2d" || kind == "d2h" || kind == "symbol_from";
+    const bool dst_needed = kind == "d2d" || kind == "h2d" || kind == "symbol_to" || kind == "memset";
+    // A symbol address is resolved by the real helper, not guessed from the host symbol handle.
+    const bool args = r && r->kind == kind && r->count == count &&
+      ((kind == "symbol_to" || kind == "symbol_from") ?
+          r->symbol_handle == symbol_handle && r->symbol_offset == symbol_offset :
+          r->source == source && r->destination == destination);
+    const bool overlap = kind == "d2d" && count && count <= UINT64_MAX - source && count <= UINT64_MAX - destination &&
+      source < destination + count && destination < source + count;
+    t.capture = capture_memory_values() && c.active && r && r->queued && r->entered && !r->completed &&
+      r->stream == c.stream && args && count && count <= MAX_COPY_BYTES &&
+      (!src_needed || src) && (!dst_needed || dst) && !overlap;
+    if (!c.active || !args) block("helper_request_unmatched", cursor);
+    if (!count || count > MAX_COPY_BYTES) block("copy_capture_budget_or_empty", cursor);
+    if ((src_needed && !src) || (dst_needed && !dst)) block("copy_live_allocation_unmapped", cursor);
+    if (overlap) block("overlapping_D2D_unsupported", cursor);
+    copies_[t.sequence] = t;
+    std::ostringstream row; row << "\"service_sequence\":" << t.sequence << ",\"request_id\":" << t.request
+      << ",\"copy_kind\":" << quoted(kind) << ",\"cycle\":" << cycle << ",\"source\":" << source
+      << ",\"destination\":" << destination << ",\"count\":" << count << ",\"capture_bytes\":" << (t.capture ? "true" : "false")
+      << ",\"symbol_handle\":" << symbol_handle << ",\"symbol_offset\":" << symbol_offset
+      << ",\"source_allocation\":" << (src ? allocation_json(*src, source - src->base) : "null")
+      << ",\"destination_allocation\":" << (dst ? allocation_json(*dst, destination - dst->base) : "null");
+    event("copy_begin", cursor, row.str()); return t;
+  }
+  void copy_end(const copy_token &t, const std::string &source_before, const std::string &destination_before,
+      const std::string &source_after, const std::string &destination_after, uint64_t cursor) {
+    std::lock_guard<std::mutex> lock(lock_); request *r = lookup(t.request, cursor);
+    if (!t.sequence || !copies_.count(t.sequence) || !completed_copies_.insert(t.sequence).second) fail("duplicate_or_unmatched_helper_end");
+    increment(completed_); if (r) r->completed = true;
+    if (t.capture && (source_before.size() != t.count * 2 || ((t.kind != "d2h" && t.kind != "symbol_from") && destination_before.size() != t.count * 2) ||
+         source_after != source_before || destination_after != source_before)) block("copy_snapshot_assignment_mismatch", cursor);
+    std::ostringstream row; row << "\"service_sequence\":" << t.sequence << ",\"request_id\":" << t.request;
+    row << ",\"source_before\":" << (t.capture ? quoted(source_before) : "null")
+      << ",\"destination_before\":" << (t.capture && t.kind != "d2h" && t.kind != "symbol_from" ? quoted(destination_before) : "null")
+      << ",\"source_after\":" << (t.capture ? quoted(source_after) : "null")
+      << ",\"destination_after\":" << (t.capture ? quoted(destination_after) : "null");
+    event("copy_end", cursor, row.str());
+  }
+  void retired(uint64_t id, uint64_t helper, uint64_t cursor) {
+    std::lock_guard<std::mutex> lock(lock_); request *r = lookup(id, cursor);
+    if (!helper || !completed_copies_.count(helper) || !retired_copies_.insert(helper).second || !r || r->retired)
+      fail("retire_without_unique_completed_helper");
+    r->retired = true; increment(retired_);
+    std::ostringstream row; row << "\"request_id\":" << id << ",\"service_sequence\":" << helper; event("service_retired", cursor, row.str());
+  }
+  void kernel(uint64_t id, const std::string &entry, bool start, uint64_t cursor,
+      unsigned gx, unsigned gy, unsigned gz, unsigned bx, unsigned by, unsigned bz) {
+    std::lock_guard<std::mutex> lock(lock_);
+    if (start) { if (!active_kernels_.insert(id).second) fail("duplicate_kernel_launch"); }
+    else if (active_kernels_.erase(id) != 1) fail("kernel_completion_without_launch");
+    std::ostringstream row; row << "\"kernel_uid\":" << id << ",\"entry\":" << quoted(entry)
+      << ",\"grid\":[" << gx << ',' << gy << ',' << gz << "],\"block\":[" << bx << ',' << by << ',' << bz << ']';
+    event(start ? "kernel_launch" : "kernel_complete", cursor, row.str());
+  }
+  // Actual assembled symbol metadata only. No address/trace-based space inference.
+  void symbol_definition(uint64_t uid, const std::string &name, uint64_t base,
+      uint64_t size, bool is_const, bool is_global, uint64_t cursor) {
+    std::ostringstream row;
+    row << "\"schema\":\"sara-assembled-symbol-definition-v1\",\"symbol_uid\":" << uid
+        << ",\"symbol_name\":" << quoted(name) << ",\"base\":" << base << ",\"size\":" << size
+        << ",\"is_const\":" << (is_const ? "true" : "false")
+        << ",\"is_global\":" << (is_global ? "true" : "false");
+    cache_event("symbol_definition", cursor, row.str());
+  }
+  // Cache callers emit actual immutable snapshots; no certification boolean is accepted.
+  uint64_t cache_event(const char *kind, uint64_t cursor, const std::string &fields) {
+    std::lock_guard<std::mutex> lock(lock_); return event(kind, cursor, fields);
+  }
+  void cache_request(uint64_t id, unsigned uid, bool born, uint64_t parent, uint64_t root) {
+    std::lock_guard<std::mutex> lock(lock_);
+    if (born ? !cache_requests_.insert(id).second : cache_requests_.erase(id) != 1)
+      fail("cache_request_lifetime_unmatched");
+    std::ostringstream row; row << "\"request_lifetime\":" << id << ",\"request_uid\":" << uid << ",\"parent_lifetime\":" << parent << ",\"root_lifetime\":" << root;
+    event(born ? "cache_request_begin" : "cache_request_end", 0, row.str());
+  }
+  void unmodeled(const char *kind, uint64_t addr, uint64_t count, uint64_t cursor) {
+    std::lock_guard<std::mutex> lock(lock_); block(std::string("unobserved_effect:") + kind, cursor);
+    std::ostringstream row; row << "\"operation\":" << quoted(kind) << ",\"address\":" << addr << ",\"count\":" << count;
+    event("unmodeled_transfer", cursor, row.str());
+  }
+  void shutdown(uint64_t cursor) {
+    std::lock_guard<std::mutex> lock(lock_); if (shutdown_) fail("duplicate_shutdown");
+    shutdown_ = true; event("simulation_thread_joined", cursor, "\"semaphore_exit_confirmed\":true");
+  }
+  std::string seal() {
+    std::lock_guard<std::mutex> lock(lock_); if (sealed_ || closed_) fail("duplicate_seal");
+    if (!shutdown_) block("simulation_thread_join_receipt_missing", 0);
+    if (!active_kernels_.empty()) block("active_kernel_at_close", 0);
+    if (!cache_requests_.empty()) block("cache_request_lifetimes_not_drained", 0);
+    if (skipped_ || api_count_ != queued_ || queued_ != entered_ || entered_ != attempted_ ||
+        attempted_ != completed_ || completed_ != retired_ || retired_ != returned_) block("request_lifetime_counts_disagree", 0);
+    for (std::map<uint64_t, request>::const_iterator i = requests_.begin(); i != requests_.end(); ++i)
+      if (!i->second.returned || !i->second.retired || !i->second.completed) block("pending_request_at_close", 0);
+    std::ostringstream out; out << "{\"schema\":\"sara-memory-effects-prefix-v2\",\"record_count\":" << records_
+      << ",\"prefix_bytes\":" << hash_.bytes() << ",\"prefix_sha256\":" << quoted(hash_.hex_digest())
+      << ",\"api_count\":" << api_count_ << ",\"completed_count\":" << completed_ << ",\"blockers\":[";
+    for (std::set<std::string>::const_iterator i = blockers_.begin(); i != blockers_.end(); ++i) {
+      if (i != blockers_.begin()) out << ',';
+      out << quoted(*i);
+    }
+    out << "],\"replay_authorized\":false,\"mapping_certified\":false}"; sealed_ = true; checkpoint_ = out.str(); return checkpoint_;
+  }
+  std::string finish(const std::string &trace_sha, uint64_t trace_bytes, uint64_t events) {
+    std::lock_guard<std::mutex> lock(lock_); if (!sealed_ || closed_ || !fp_) fail("close_without_seal");
+    std::ostringstream row; row << "{\"kind\":\"close\",\"sequence\":" << records_ + 1
+      << ",\"schema\":\"sara-memory-effects-close-v2\",\"trace_sha256\":" << quoted(trace_sha)
+      << ",\"trace_bytes\":" << trace_bytes << ",\"trace_event_count\":" << events << ",\"checkpoint\":" << checkpoint_ << "}\n";
+    write(row.str()); if (ferror(fp_) || fflush(fp_) || fsync(fileno(fp_))) fail("flush_or_fsync");
+    FILE *f = fp_; fp_ = NULL;
+    if (fclose(f)) fail("fclose");
+    sync_parent(path_);
+    closed_ = true;
+    std::ostringstream out; out << "{\"schema\":\"sara-memory-effects-binding-v2\",\"ledger_path\":" << quoted(path_)
+      << ",\"ledger_bytes\":" << hash_.bytes() << ",\"ledger_sha256\":" << quoted(hash_.hex_digest())
+      << ",\"close_succeeded\":true,\"checkpoint\":" << checkpoint_ << '}'; return out.str();
+  }
+ private:
+  struct request {
+    request() : source(0), destination(0), count(0), stream(0), symbol_handle(0), symbol_offset(0), null_stream(false), queued(false), skipped(false), entered(false), completed(false), retired(false), returned(false) {}
+    std::string kind; uint64_t source, destination, count, stream, symbol_handle, symbol_offset; bool null_stream, queued, skipped, entered, completed, retired, returned;
+  };
+  void caller(uint64_t cursor) {
+    std::ostringstream out; out << std::this_thread::get_id();
+    (void)cursor; host_ = out.str(); // Every host event carries its actual caller below.
+  }
+  request *lookup(uint64_t id, uint64_t cursor) {
+    std::map<uint64_t, request>::iterator i = requests_.find(id);
+    if (!id || i == requests_.end()) { block("request_identity_missing", cursor); return NULL; }
+    return &i->second;
+  }
+  allocation *locate(uint64_t address, uint64_t count) {
+    if (!count || count > UINT64_MAX - address) return NULL;
+    allocation *out = NULL;
+    for (std::map<uint64_t, allocation>::iterator i = allocations_.begin(); i != allocations_.end(); ++i) {
+      allocation &a = i->second;
+      if (a.live && address >= a.base && count <= a.size && address - a.base <= a.size - count) {
+        if (out) return NULL;
+        out = &a;
+      }
+    }
+    return out;
+  }
+  static std::string allocation_json(const allocation &a, uint64_t offset) {
+    std::ostringstream out; out << "{\"id\":" << a.id << ",\"generation\":" << a.generation << ",\"base\":" << a.base
+      << ",\"size\":" << a.size << ",\"offset\":" << offset << ",\"allocator\":" << quoted(a.kind) << ",\"name\":" << quoted(a.name) << ",\"symbol_uid\":" << a.symbol_uid << '}'; return out.str();
+  }
+  void block(const std::string &reason, uint64_t cursor) { if (blockers_.insert(reason).second) event("blocker", cursor, "\"reason\":" + quoted(reason)); }
+  uint64_t event(const char *kind, uint64_t cursor, const std::string &fields) {
+    if (sealed_ || closed_) fail("record_after_seal");
+    increment(records_);
+    std::ostringstream row;
+    row << "{\"kind\":" << quoted(kind) << ",\"sequence\":" << records_ << ",\"instruction_cursor\":" << cursor ;
+    std::ostringstream executing_thread; executing_thread << std::this_thread::get_id();
+    row << ",\"observer_thread\":" << quoted(executing_thread.str());
+    if (!fields.empty()) row << ',' << fields;
+    row << "}\n";
+    write(row.str());
+    return records_;
+  }
+  void write(const std::string &s) {
+    if (!fp_ || hash_.bytes() > budget_ || s.size() > budget_ - hash_.bytes()) fail("ledger_byte_budget");
+    if (fwrite(s.data(), 1, s.size(), fp_) != s.size()) fail("ledger_write");
+    hash_.update(s.data(), s.size());
+    if (hash_.overflow()) fail("hash_overflow");
+  }
+  static void sync_parent(const std::string &p) {
+    const size_t slash = p.find_last_of('/'); const std::string parent = slash == std::string::npos ? "." : slash == 0 ? "/" : p.substr(0, slash);
+    const int fd = open(parent.c_str(), O_RDONLY | O_DIRECTORY); if (fd < 0) fail("parent_open");
+    const int synced = fsync(fd), closed = ::close(fd); if (synced || closed) fail("parent_fsync_or_close");
+  }
+  const uint64_t budget_; const bool cache_state_; bool standalone_, population_only_;
+  std::string path_, trace_, host_, checkpoint_; FILE *fp_; uint64_t records_, allocation_count_, api_count_, queued_, skipped_, entered_, attempted_, completed_, retired_, returned_;
+  bool shutdown_, sealed_, closed_; sara_trace::sha256 hash_; std::map<uint64_t, allocation> allocations_; std::map<uint64_t, request> requests_;
+  std::map<uint64_t, copy_token> copies_; std::set<uint64_t> completed_copies_, retired_copies_, active_kernels_, cache_requests_; std::set<std::string> blockers_; std::mutex lock_;
+};
+inline std::atomic<collector *> &instance() { static std::atomic<collector *> value(NULL); return value; }
+inline collector *get() { return instance().load(std::memory_order_acquire); }
+inline void configure(const char *path, const char *trace, bool enabled, bool jsonl, uint64_t budget = DEFAULT_LEDGER_BYTES, bool cache_state = false) {
+  if (!path || !*path) return;
+  static std::mutex lock;
+  std::lock_guard<std::mutex> guard(lock);
+  collector *c = get(); if (c) c->same_configuration(path, trace ? trace : "", budget, cache_state);
+  else instance().store(new collector(path, trace ? trace : "", enabled, jsonl, budget, cache_state), std::memory_order_release);
+}
+inline void service_enter(uint64_t id, uint64_t stream, uint64_t cursor, bool idle, const std::string &state) {
+  collector *c = get();
+  if (!c) return;
+  service_context &s = current_service();
+  if (s.active) fail("nested_service");
+  s.active = true; s.request = id; s.stream = stream; s.helper = 0; s.idle = idle; c->entered(id, stream, cursor, idle, state);
+}
+inline void service_retired(uint64_t cursor) {
+  collector *c = get();
+  if (!c) return;
+  service_context &s = current_service();
+  c->retired(s.request, s.helper, cursor); s = service_context();
+}
+inline std::string seal() { collector *c = get(); return c ? c->seal() : "null"; }
+inline std::string finish(const std::string &sha, uint64_t bytes, uint64_t events) { collector *c = get(); return c ? c->finish(sha, bytes, events) : "null"; }
