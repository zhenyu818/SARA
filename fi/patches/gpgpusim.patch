+#ifndef SARA_CACHE_COLD_DATA_H
+#define SARA_CACHE_COLD_DATA_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <set>
+#include <string>
+#include "cache_compatibility.h"
+
+namespace sara_fault {
+
+inline const char *cold_data_fault_model() {
+  return "all-active-physical-cache-tag57-and-data-invalid-pending-single-bit-v2";
+}
+
+// A relative mutation of a physical INVALID data cell. It is deliberately NOT
+// a logical-address payload, resident-copy mask, or member of live_cache_error.
+// No unknown baseline byte is read or initialized. INVALID/RESERVED cells
+// remain pending until an actual covered fill/store assignment. Owner identity comes from the actual tag array.
+class cold_invalid_data {
+ public:
+  cold_invalid_data() : owner_(NULL), instance_(0), epoch_(0), slot_(0),
+      allocated_lines_(0), line_bytes_(0), cache_type_(0), bit_(0),
+      origin_version_(0), version_(0), execution_(0), mask_(0), stage_(IDLE),
+      assignment_begin_(0), assignment_count_(0), request_(0), exposed_(false), terminal_(false) {}
+  ~cold_invalid_data() {
+    if (active() && !terminal_) fail("cold_pending_slot_destroyed_without_assignment_or_normal_end");
+    registry().erase(this);
+  }
+  cold_invalid_data(const cold_invalid_data &) = delete;
+  cold_invalid_data &operator=(const cold_invalid_data &) = delete;
+  bool active() const { return mask_ != 0; }
+  unsigned mask() const { return mask_; }
+  unsigned data_bit() const { return bit_; }
+  uint64_t execution() const { return execution_; }
+  uint64_t version() const { return version_; }
+  uint64_t origin_version() const { return origin_version_; }
+  const std::string &realization() const { return realization_; }
+  static bool any() { return !registry().empty(); }
+  static const std::set<cold_invalid_data *> &pending() { return registry(); }
+  const void *owner() const { return owner_; }
+  uint64_t instance() const { return instance_; }
+  uint64_t epoch() const { return epoch_; }
+  uint64_t slot() const { return slot_; }
+  unsigned line_bytes() const { return line_bytes_; }
+  unsigned cache_type() const { return cache_type_; }
+  uint64_t allocated_lines() const { return allocated_lines_; }
+  static void reject_all(const char *reason) {
+    if (any()) (*registry().begin())->fail(reason);
+  }
+  bool intersects(unsigned begin, unsigned count) const {
+    return active() && bit_ / 8 >= begin && bit_ / 8 - begin < count;
+  }
+  void arm(const void *owner, uint64_t instance, uint64_t epoch,
+      uint64_t slot, uint64_t allocated_lines, unsigned line_bytes,
+      unsigned cache_type, unsigned bit, uint64_t version,
+      const char *component, const std::string &realization) {
+    if (active() || any() || !owner || !instance || !epoch ||
+        !allocated_lines || slot >= allocated_lines || !line_bytes ||
+        bit >= static_cast<uint64_t>(line_bytes) * 8 || cache_type > 1 ||
+        !component || (std::string(component) != "l1d" && std::string(component) != "l2") ||
+        realization.empty())
+      invalid_configuration("cold_invalid_physical_binding");
+    owner_ = owner; instance_ = instance; epoch_ = epoch; slot_ = slot;
+    allocated_lines_ = allocated_lines; line_bytes_ = line_bytes;
+    cache_type_ = cache_type; bit_ = bit; origin_version_ = version;
+    version_ = version; component_ = component; realization_ = realization;
+    mask_ = 1U << (bit % 8); advance(); registry().insert(this);
+  }
+  void metadata_allocation(uint64_t new_version) {
+    if (!active()) return;
+    if (terminal_ || stage_ == FILL || new_version <= version_) fail("cold_allocation_order_unverified");
+    version_ = new_version;  // tag/block/generation changes do not write DATA
+    note("metadata_allocation", 0, 0, mask_, mask_);
+  }
+  void configuration(unsigned line_bytes) const {
+    if (active() && (terminal_ || line_bytes != line_bytes_)) fail("cold_physical_width_changed");
+  }
+  // Only baseline_cache::fill supplies assignment=true. force_tag_access and
+  // metadata-only fills retain the default false and cannot kill a cold bit.
+  void begin_fill(unsigned begin, unsigned count, uint64_t request,
+      bool assignment, bool reserved, bool ignore, bool modified) {
+    if (!intersects(begin, count)) return;
+    if (terminal_ || stage_ != IDLE || !assignment || !request || !reserved || ignore || modified)
+      fail("cold_fill_assignment_unverified");
+    stage_ = FILL; assignment_begin_ = begin; assignment_count_ = count;
+    request_ = request;
+  }
+  // Called at the actual overlay assignment, not at allocation/status changes.
+  void finish_fill(unsigned begin, unsigned count, uint64_t version) {
+    if (!intersects(begin, count)) return;
+    if (stage_ != FILL || begin != assignment_begin_ || count != assignment_count_ ||
+        version != version_) fail("cold_fill_completion_unverified");
+    kill("fill_assignment", begin, count);
+  }
+  template <class ByteMask>
+  void begin_store(const ByteMask &bytes, uint64_t request) {
+    if (!active()) return;
+    if (terminal_ || stage_ != IDLE) fail("cold_store_overlaps_assignment");
+    if (bit_ / 8 >= bytes.size() || !bytes.test(bit_ / 8)) return;
+    if (!request) fail("cold_store_request_unidentified");
+    for (unsigned byte = line_bytes_; byte < bytes.size(); ++byte)
+      if (bytes.test(byte)) fail("cold_store_mask_exceeds_line");
+    stage_ = STORE; assignment_begin_ = bit_ / 8; assignment_count_ = 1;
+    request_ = request;
+  }
+  void finish_store(uint64_t request, bool accepted, bool assigned,
+      uint64_t version) {
+    if (!active() || stage_ != STORE) return;
+    if (request != request_ || version != version_) fail("cold_store_identity_changed");
+    if (accepted && assigned) {
+      kill("accepted_store_byte", assignment_begin_, 1);
+      return;
+    }
+    if (exposed_) fail("cold_store_made_unassigned_byte_readable");
+    stage_ = IDLE; request_ = 0;  // queued/rejected/no-WA is not an assignment
+  }
+  // INVALID/RESERVED remain non-sources. VALID and MODIFIED are only allowed
+  // transiently within a source-bound fill or an actually covered store; a
+  // subsequent read/export is still forbidden until assignment completes.
+  void state(unsigned begin, unsigned count, bool source_state) {
+    if (!intersects(begin, count)) return;
+    if (terminal_) fail("cold_cache_access_after_model_end");
+    if (!source_state) return;
+    if (stage_ != FILL && stage_ != STORE) fail("cold_unassigned_data_became_source_state");
+    exposed_ = true;
+  }
+  void readability(unsigned begin, unsigned count, bool became_readable) {
+    if (intersects(begin, count) && (terminal_ || (became_readable && stage_ != FILL && stage_ != STORE)))
+      fail("cold_unassigned_data_revalidated");
+  }
+  void flags(unsigned begin, unsigned count, bool ignored_or_modified) const {
+    if (intersects(begin, count) && (terminal_ || ignored_or_modified))
+      fail("cold_ignore_or_modified_on_fill");
+  }
+  void source(unsigned begin, unsigned count) const {
+    if (intersects(begin, count)) fail("cold_unassigned_data_source_or_export");
+  }
+  void terminal_invalid(uint64_t version, uint64_t cycle, uint64_t cursor, bool readable) {
+    if (!active() || terminal_ || stage_ != IDLE || exposed_ || version != version_)
+      fail("cold_terminal_pending_state_unverified");
+    terminal_ = true;  // the pending XOR remains physically present and unchanged
+    printf("GPUFI_CACHE_COLD event=terminal_invalid ack_schema=cache-invalid-pending-v2 realizer_version=2 component=%s cache_instance=%llu geometry_epoch=%llu line=%llu allocated_lines=%llu line_bytes=%u cache_type=%u data_bit=%u origin_version=%llu allocation_version=%llu execution=%llu byte_start=%u bytes=1 request_lifetime=0 pending_before=%02x pending_after=%02x realization_id=%s terminal_state=INVALID terminal_cycle=%llu terminal_cursor=%llu terminal_readable=%u\n",
+        component_.c_str(), (unsigned long long)instance_, (unsigned long long)epoch_,
+        (unsigned long long)slot_, (unsigned long long)allocated_lines_, line_bytes_, cache_type_, bit_,
+        (unsigned long long)origin_version_, (unsigned long long)version_,
+        (unsigned long long)execution_, bit_/8, mask_, mask_, realization_.c_str(),
+        (unsigned long long)cycle, (unsigned long long)cursor, readable ? 1U : 0U);
+    fflush(stdout);
+  }
+  static void owner_change(const void *owner, const char *reason, bool terminal_destruction = false) {
+    for (std::set<cold_invalid_data *>::const_iterator it = registry().begin();
+         it != registry().end(); ++it)
+      if ((*it)->owner_ == owner && !(terminal_destruction && (*it)->terminal_)) (*it)->fail(reason);
+  }
+  static void unreviewed_transfer() {
+    if (any()) (*registry().begin())->fail("cold_unreviewed_host_transfer");
+  }
+  static void direct_backing_transfer() {
+    for (std::set<cold_invalid_data *>::const_iterator it = registry().begin();
+         it != registry().end(); ++it)
+      if ((*it)->terminal_ || (*it)->stage_ != IDLE || (*it)->exposed_)
+        (*it)->fail("cold_host_transfer_during_unfinished_assignment");
+    // The reviewed callers read/write memory_space backing bytes directly.
+    // They neither consult cold DATA cells nor convert them to logical block0.
+    // Any subsequent perf/tag fill is a separate, guarded metadata operation.
+  }
+  static void reject_new_cause() {
+    if (any()) (*registry().begin())->fail("cold_pending_conflicting_fault_cause");
+  }
+
+ private:
+  enum Stage { IDLE, FILL, STORE };
+  const void *owner_;
+  uint64_t instance_, epoch_, slot_, allocated_lines_;
+  unsigned line_bytes_, cache_type_, bit_;
+  uint64_t origin_version_, version_, execution_;
+  unsigned mask_;
+  Stage stage_;
+  unsigned assignment_begin_, assignment_count_;
+  uint64_t request_;
+  bool exposed_, terminal_;
+  std::string component_, realization_;
+  static std::set<cold_invalid_data *> &registry() {
+    static std::set<cold_invalid_data *> *value = new std::set<cold_invalid_data *>;
+    return *value;
+  }
+  void advance() {
+    if (execution_ == UINT64_MAX) invalid_configuration("cold_execution_overflow");
+    ++execution_;
+  }
+  void kill(const char *event, unsigned begin, unsigned count) {
+    const unsigned before = mask_;
+    mask_ = 0; advance();
+    note(event, begin, count, before, 0);
+    registry().erase(this); stage_ = IDLE; request_ = 0; exposed_ = false;
+  }
+  void note(const char *event, unsigned begin, unsigned count,
+      unsigned before, unsigned after) const {
+    printf("GPUFI_CACHE_COLD event=%s ack_schema=cache-invalid-pending-v2 realizer_version=2 component=%s cache_instance=%llu geometry_epoch=%llu line=%llu allocated_lines=%llu line_bytes=%u cache_type=%u data_bit=%u origin_version=%llu allocation_version=%llu execution=%llu byte_start=%u bytes=%u request_lifetime=%llu pending_before=%02x pending_after=%02x realization_id=%s\n",
+        event, component_.c_str(), (unsigned long long)instance_,
+        (unsigned long long)epoch_, (unsigned long long)slot_,
+        (unsigned long long)allocated_lines_, line_bytes_, cache_type_, bit_,
+        (unsigned long long)origin_version_, (unsigned long long)version_,
+        (unsigned long long)execution_, begin, count,
+        (unsigned long long)request_, before, after, realization_.c_str());
+    fflush(stdout);
+  }
+  static void invalid_configuration(const char *reason) {
+    fprintf(stderr,"GPUFI_INVALID_CONFIGURATION reason=%s\n",reason); fflush(stderr); abort();
+  }
+  void fail(const char *reason) const {
+    cache_approximation(reason, component_.empty() ? "cache" : component_.c_str(), realization_);
+  }
+};
+}  // namespace sara_fault
+#endif
