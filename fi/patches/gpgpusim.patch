+#ifndef SARA_PTX_LM_CONVERSION_OPS_H
+#define SARA_PTX_LM_CONVERSION_OPS_H
+#include <cstdint>
+
+namespace sara_ptx {
+// Exact raw-word cvt.rni.s32.f32. PTX defines NaN->0 and default integer
+// clamping. No host float-to-int cast, signed overflow or host FP state.
+inline uint32_t cvt_f32_s32_rni_bits(uint32_t input) {
+    const bool negative=(input & 0x80000000u)!=0;
+    const unsigned exponent=(input>>23)&255u;
+    const uint32_t fraction=input&0x007fffffu;
+    if (exponent==255u && fraction) return 0;
+    const int power=int(exponent)-127;
+    if (power>=31) return negative ? 0x80000000u : 0x7fffffffu;
+    if (power < -1) return 0;  // Includes all binary32 subnormals.
+    const uint32_t significand=fraction|0x00800000u;
+    uint32_t magnitude;
+    if (power>=23) {
+        magnitude=significand<<unsigned(power-23);  // Shift <=7, result <2^31.
+    } else {
+        const unsigned shift=unsigned(23-power);  // 1..24.
+        magnitude=significand>>shift;
+        const uint32_t remainder=significand&((uint32_t(1)<<shift)-1);
+        const uint32_t midpoint=uint32_t(1)<<(shift-1);
+        if (remainder>midpoint || (remainder==midpoint && (magnitude&1))) ++magnitude;
+    }
+    return negative ? uint32_t(0)-magnitude : magnitude;
+}
+
+// Exact cvt.rzi.u32.f32 (CUDA11.8 PTX7.8, 9.7.8.18): NaN->0,
+// truncation toward zero, default destination-range clamp including infinities.
+// Integer raw words only: no host float cast, FP flags, ambient rounding or DAZ.
+inline uint32_t cvt_f32_u32_rzi_bits(uint32_t input) {
+    const unsigned exponent=(input>>23)&255u;
+    const uint32_t fraction=input&0x007fffffu;
+    if (exponent==255u && fraction) return 0;
+    if (input&0x80000000u) return 0;  // Negative finite/infinity and -zero clamp.
+    const int power=int(exponent)-127;
+    if (power<0) return 0;  // Both zeros, subnormals and positive values <1.
+    if (power>=32) return 0xffffffffu;  // Includes +infinity.
+    const uint32_t significand=fraction|0x00800000u;
+    return power>=23 ? significand<<unsigned(power-23) : significand>>unsigned(23-power);
+}
+
+// Exact raw-word cvt.rn.f32.f64. Gradual binary32 underflow is computed in
+// integer units of 2^-149. The simulator chooses a canonical quiet NaN;
+// ISA controls assert only NaN class, not a hardware payload convention.
+inline uint32_t cvt_f64_f32_rn_bits(uint64_t input) {
+    const uint32_t sign=uint32_t(input>>32)&0x80000000u;
+    const unsigned exponent=unsigned((input>>52)&2047u);
+    const uint64_t fraction=input&UINT64_C(0x000fffffffffffff);
+    if (exponent==2047u) return fraction ? 0x7fc00000u : sign|0x7f800000u;
+    if (exponent==0) return sign;  // All f64 subnormals are below half a f32 ULP at zero.
+    int power=int(exponent)-1023;
+    if (power < -150) return sign;
+    if (power > 127) return sign|0x7f800000u;
+    const uint64_t significand=fraction|UINT64_C(0x0010000000000000);
+    const unsigned shift=power < -126 ? unsigned(-power-97) : 29u;  // 29..53.
+    uint64_t rounded=significand>>shift;
+    const uint64_t remainder=significand&((uint64_t(1)<<shift)-1);
+    const uint64_t midpoint=uint64_t(1)<<(shift-1);
+    if (remainder>midpoint || (remainder==midpoint && (rounded&1))) ++rounded;
+    if (power < -126) return sign|uint32_t(rounded);  // May carry into min normal.
+    if (rounded==(uint64_t(1)<<24)) { rounded>>=1; ++power; }
+    if (power>127) return sign|0x7f800000u;
+    return sign|(uint32_t(power+127)<<23)|(uint32_t(rounded)&0x007fffffu);
+}
+}  // namespace sara_ptx
+#endif
