+#ifndef SARA_PTX_SHUFFLE_OPS_H
+#define SARA_PTX_SHUFFLE_OPS_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string>
+namespace sara_ptx {
+enum shuffle_mode { shuffle_up, shuffle_down, shuffle_bfly, shuffle_idx };
+struct shuffle_selection { unsigned source; bool in_range; };
+inline shuffle_selection select_shuffle_lane(shuffle_mode mode, unsigned lane,
+                                             uint32_t b, uint32_t c) {
+  const unsigned delta=b&31, clamp=c&31, segment=(c>>8)&31;
+  const unsigned maximum=(lane&segment)|(clamp&(~segment&31));
+  const unsigned minimum=lane&segment;
+  int source=0; bool valid=false;
+  switch(mode) {
+    case shuffle_up: source=static_cast<int>(lane)-delta; valid=source>=static_cast<int>(maximum); break;
+    case shuffle_down: source=lane+delta; valid=source<=static_cast<int>(maximum); break;
+    case shuffle_bfly: source=lane^delta; valid=source<=static_cast<int>(maximum); break;
+    case shuffle_idx: source=minimum|(delta&(~segment&31)); valid=source<=static_cast<int>(maximum); break;
+  }
+  shuffle_selection result={valid?static_cast<unsigned>(source):lane,valid};
+  return result;
+}
+// Per dynamically executed full-warp instruction, never a PC-only cache.
+struct shuffle_snapshot {
+  shuffle_snapshot():active(false),group_id(0),pc(0),mode(shuffle_up),source_uid(-1) {}
+  bool active;
+  uint64_t group_id,pc;
+  shuffle_mode mode;
+  int source_uid;
+  std::string source_register;
+  uint32_t values[32],b[32],c[32],membermask[32],thread_uid[32];
+  shuffle_selection selection[32];
+};
+struct shuffle_trace_info {
+  shuffle_trace_info():snapshot(NULL),lane(0),data_uid(-1),predicate_uid(-1),
+    data_old_valid(false),predicate_old_valid(false),data_old(0),predicate_old(0) {}
+  const shuffle_snapshot *snapshot;
+  unsigned lane;
+  int data_uid,predicate_uid;
+  std::string data_register,predicate_register;
+  bool data_old_valid,predicate_old_valid;
+  uint64_t data_old,predicate_old;
+};
+}  // namespace sara_ptx
+#endif
