+    size_t bytes = (size_t)kb * 1024;
+    m_event_max = bytes / sizeof(regfile_trace_event_v1);
+    if (m_event_max == 0) m_event_max = 1;
+    m_buffer.reserve(m_event_max);
+    m_enabled = true;
+  }
+
+  FILE *m_fp;
+  bool m_enabled;
+  size_t m_event_max;
+  std::vector<regfile_trace_event_v1> m_buffer;
+};
