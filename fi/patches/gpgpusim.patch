+  uint64_t block_, version_, execution_;
+  unsigned line_bytes_;
+  int scope_;
+  bool writeback_sensitive_;
+  std::string component_;
+  std::map<unsigned, overlay_byte> bytes_;
+  static std::set<cache_overlay *> &registry() {
+    static std::set<cache_overlay *> *value = new std::set<cache_overlay *>;
+    return *value;
+  }
+  void update_registry() {
+    if (bytes_.empty()) registry().erase(this);
+    else registry().insert(this);
+  }
+  void note(const char *event, unsigned begin, unsigned count) const {
+    printf("GPUFI_CACHE_COPY status=%s component=%s scope=%d block_addr=%llu version=%llu byte_start=%u bytes=%u realization_id=%s\n",
+           event, component(), scope_, static_cast<unsigned long long>(block_),
+           static_cast<unsigned long long>(version_), begin, count, realization().c_str());
+    fflush(stdout);
+  }
+};
