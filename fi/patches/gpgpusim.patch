+    // Validation-only walk log. Production classification/pairing uses the
+    // closed population stream and event/launch geometry, not this duplicate.
+    const char *validation_log = getenv("SARA_POPULATION_REFERENCE_ACTIVE_THREADS");
+    if (validation_log && strcmp(validation_log, "0") == 0) return false;
+    if (validation_log && strcmp(validation_log, "1") != 0) {
+      fprintf(stderr, "GPUFI_INVALID_CONFIGURATION option=SARA_POPULATION_REFERENCE_ACTIVE_THREADS\n");
+      exit(EXIT_FAILURE);
+    }
+    return true;
+  }
+
+  void log(const gpgpu_sim_config &cfg, unsigned long long cycle,
+           const std::vector<ptx_thread_info *> &active_threads,
+           const std::vector<unsigned> *shared_scope_thread_uids = NULL) {
+    if (!is_enabled(cfg)) return;
+    if (!m_enabled) init(cfg);
+    if (!m_enabled) return;
+
+    fprintf(m_fp, "{\"cycle\":%llu,\"active_threads_size\":%u",
+            cycle, (unsigned)active_threads.size());
+    write_thread_uid_ranges(m_fp, "active_thread_ranges", active_threads);
+    if (shared_scope_thread_uids != NULL) {
+      fprintf(m_fp, ",\"shared_scope_thread_ids\":[");
+      for (size_t i = 0; i < shared_scope_thread_uids->size(); ++i) {
+        if (i) fputc(',', m_fp);
+        fprintf(m_fp, "%u", (*shared_scope_thread_uids)[i]);
+      }
+      fprintf(m_fp, "]");
+    }
+    fprintf(m_fp, "}\n");
+  }
+
+  ~exact_active_threads_logger() {
+    if (m_fp) fclose(m_fp);
+  }
+
+ private:
+  static void write_thread_uid_ranges(
+      FILE *fp, const char *field_name,
+      const std::vector<ptx_thread_info *> &threads) {
+    // Lossless [start,count] runs preserve simulator walk order while avoiding
+    // per-cycle dumps of dense active_thread_ids arrays.
+    fprintf(fp, ",\"%s\":[", field_name);
+    bool first_range = true;
+    size_t i = 0;
+    while (i < threads.size()) {
+      unsigned start = threads[i]->get_uid();
+      unsigned prev = start;
+      size_t count = 1;
+      ++i;
+      while (i < threads.size()) {
+        unsigned uid = threads[i]->get_uid();
+        if (uid != prev + 1) break;
+        prev = uid;
+        ++count;
+        ++i;
+      }
+      if (!first_range) fputc(',', fp);
+      fprintf(fp, "[%u,%u]", start, (unsigned)count);
+      first_range = false;
+    }
+    fprintf(fp, "]");
+  }
+
+  void init(const gpgpu_sim_config &cfg) {
+    const char *base = cfg.exact_trace_file();
+    if (!base || !base[0]) {
+      m_enabled = false;
+      return;
+    }
+    std::string path(base);
+    path += ".active_threads.jsonl";
+    m_fp = fopen(path.c_str(), "w");
+    if (!m_fp) {
+      fprintf(stderr,
+              "GPGPU-Sim: failed to open exact active-thread log '%s'\n",
+              path.c_str());
+      m_enabled = false;
+      return;
+    }
+    m_enabled = true;
+  }
+
+  FILE *m_fp;
+  bool m_enabled;
+};
+
+static exact_active_threads_logger g_exact_active_threads_logger;
