+#ifndef SARA_FAULT_BIT_OPS_H
+#define SARA_FAULT_BIT_OPS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+// Public FI options use one-based bit positions; storage offsets are zero-based.
+// Accessing an object's representation through unsigned char avoids alignment,
+// strict-aliasing, and 64-bit shifts on 32/128-bit operands.
+namespace sara_fault {
+inline bool access_covers_bit(uint64_t bit, uint64_t access_start,
+                              uint64_t access_width) {
+  return bit >= access_start && bit - access_start < access_width;
+}
+
+inline bool zero_based_bit(uint64_t option_bit, uint64_t width,
+                           uint64_t *bit) {
+  if (option_bit == 0 || option_bit > width || bit == NULL) return false;
+  *bit = option_bit - 1;
+  return true;
+}
+
+inline bool flip_bit(void *storage, size_t storage_bytes, unsigned width_bits,
+                     uint64_t option_bit) {
+  uint64_t bit = 0;
+  if (storage == NULL || width_bits > storage_bytes * 8 ||
+      !zero_based_bit(option_bit, width_bits, &bit)) return false;
+  unsigned char *bytes = static_cast<unsigned char *>(storage);
+  bytes[bit / 8] ^= static_cast<unsigned char>(1U << (bit % 8));
+  return true;
+}
+
+inline bool memory_bit(uint64_t option_bit, size_t block_bytes,
+                       uint64_t *block, size_t *byte, unsigned *bit) {
+  if (!option_bit || !block_bytes || !block || !byte || !bit) return false;
+  const uint64_t zero = option_bit - 1;
+  *block = zero / (static_cast<uint64_t>(block_bytes) * 8);
+  *byte = static_cast<size_t>((zero / 8) % block_bytes);
+  *bit = static_cast<unsigned>(zero % 8);
+  return true;
+}
+
+struct cache_bit {
+  uint64_t line;
+  bool is_tag;
+  unsigned bit;  // tag storage bit (63 downward), or zero-based data bit
+};
+
+// The original injector's explicit layout is tag-first: 57 tag bits, then data.
+inline bool decode_cache_bit(uint64_t option_bit, uint64_t lines,
+                             unsigned data_bits, unsigned tag_bits,
+                             cache_bit *out) {
+  if (!out || !data_bits || tag_bits > 64 || !lines) return false;
+  const uint64_t line_bits = static_cast<uint64_t>(data_bits) + tag_bits;
+  if (lines > UINT64_MAX / line_bits) return false;
+  uint64_t zero = 0;
+  if (!zero_based_bit(option_bit, lines * line_bits, &zero)) return false;
+  out->line = zero / line_bits;
+  const unsigned in_line = static_cast<unsigned>(zero % line_bits);
+  out->is_tag = in_line < tag_bits;
+  out->bit = out->is_tag ? 63U - in_line : in_line - tag_bits;
+  return true;
+}
+}  // namespace sara_fault
+#endif
