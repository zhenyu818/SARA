+inline std::string quoted(const std::string &value) {
+  const char *digits = "0123456789abcdef"; std::string out = "\"";
+  for (size_t i = 0; i < value.size(); ++i) {
+    const unsigned char c = static_cast<unsigned char>(value[i]);
+    if (c == '"' || c == '\\') { out += '\\'; out += c; }
+    else if (c < 32 || c >= 127) { out += "\\u00"; out += digits[c >> 4]; out += digits[c & 15]; }
+    else out += c;
+  }
+  return out + '"';
+}
+inline std::string hexbytes(const unsigned char *data, size_t size) {
+  const char *digits = "0123456789abcdef"; std::string out; out.reserve(size * 2);
+  for (size_t i = 0; i < size; ++i) { out += digits[data[i] >> 4]; out += digits[data[i] & 15]; }
+  return out;
+}
