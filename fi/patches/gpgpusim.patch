+// Actual persistent shared object identity, separate from its current CTA owner.
+// Observational only: acquire never reads/writes/initializes simulated bytes.
+#ifndef SARA_SHARED_OWNER_IDENTITY_H
+#define SARA_SHARED_OWNER_IDENTITY_H
+#include <cstdint>
+#include <limits>
+#include <map>
+namespace sara_shared {
+struct owner_identity {
+  uint64_t object_uid, owner_epoch;
+  unsigned allocator_slot;
+  owner_identity() : object_uid(0), owner_epoch(0), allocator_slot(0) {}
+};
+class owner_registry {
+ public:
+  owner_registry() : next_object_(0) {}
+  bool acquire(const void *actual_object, unsigned slot, owner_identity *out) {
+    if (!actual_object || !out) return false;
+    std::map<unsigned, const void *>::const_iterator bound = slots_.find(slot);
+    if (bound != slots_.end() && bound->second != actual_object) return false;
+    std::map<const void *, owner_identity>::iterator found = objects_.find(actual_object);
+    if (found != objects_.end() && found->second.allocator_slot != slot) return false;
+    if (found == objects_.end()) {
+      if (next_object_ == std::numeric_limits<uint64_t>::max()) return false;
+      owner_identity created; created.object_uid = ++next_object_; created.allocator_slot = slot;
+      found = objects_.insert(std::make_pair(actual_object, created)).first;
+      slots_.insert(std::make_pair(slot, actual_object));
+    }
+    if (found->second.owner_epoch == std::numeric_limits<uint64_t>::max()) return false;
+    ++found->second.owner_epoch;
+    *out = found->second;
+    return true;
+  }
+ private:
+  uint64_t next_object_;
+  std::map<unsigned, const void *> slots_;
+  std::map<const void *, owner_identity> objects_;
+};
+}  // namespace sara_shared
+#endif
