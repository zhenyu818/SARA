+# Detect Git branch and commit #.  Some packaged/container runs mount only the
+# source tree without the .git directory; keep build-string generation quiet in
+# that case instead of letting git fall back to "diff --no-index" and reject
+# repository-only options such as --cached.
+GIT_WORK_TREE_AVAILABLE := $(shell git -C "$(GPGPUSIM_ROOT)" rev-parse --is-inside-work-tree >/dev/null 2>&1 && echo 1 || echo 0)
+ifeq ($(GIT_WORK_TREE_AVAILABLE),1)
+GIT_COMMIT := $(shell git -C "$(GPGPUSIM_ROOT)" log --abbrev-commit -n 1 | head -1 | sed -re 's/commit (.*)/\1/')
+GIT_FILES_CHANGED_A := $(shell git -C "$(GPGPUSIM_ROOT)" diff --numstat 2>/dev/null | wc | sed -re 's/^\s+([0-9]+).*/\1./')
+GIT_FILES_CHANGED := $(GIT_FILES_CHANGED_A)$(shell git -C "$(GPGPUSIM_ROOT)" diff --numstat --cached 2>/dev/null | wc | sed -re 's/^\s+([0-9]+).*/\1/')
+else
+GIT_COMMIT := nogit
+GIT_FILES_CHANGED := 0.0
+endif
