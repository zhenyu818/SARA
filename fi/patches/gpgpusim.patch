+#ifndef SARA_CACHE_INSTRUCTION_CONTEXT_H
+#define SARA_CACHE_INSTRUCTION_CONTEXT_H
+#include "host_copy_observer.h"
+namespace sara_cache_witness {
+inline bool enabled() { sara_host_copy::collector *c = sara_host_copy::get(); return c && c->cache_state_enabled(); }
+struct instruction_context {
+  instruction_context() : active(false), uid(0), issue(0) {}
+  bool active; unsigned uid; uint64_t issue;
+};
+inline instruction_context &current_instruction() { static thread_local instruction_context value; return value; }
+class instruction_scope {
+ public:
+  instruction_scope(bool active, unsigned uid, uint64_t issue) : active_(active) {
+    if (active_) { prior_ = current_instruction(); current_instruction().active = true;
+      current_instruction().uid = uid; current_instruction().issue = issue; }
+  }
+  ~instruction_scope() { if (active_) current_instruction() = prior_; }
+ private: bool active_; instruction_context prior_;
+};
+inline uint64_t &current_timing_parent() { static thread_local uint64_t value = 0; return value; }
+class timing_scope {
+ public:
+  timing_scope(bool active, uint64_t request) : active_(active), prior_(0) {
+    if (active_) { prior_ = current_timing_parent(); current_timing_parent() = request; }
+  }
+  ~timing_scope() { if (active_) current_timing_parent() = prior_; }
+ private: bool active_; uint64_t prior_;
+};
+} // namespace sara_cache_witness
+#endif
