+// addition/product is evaluated, including min/max and arbitrary faulted bits.
+inline uint64_t add_s64_bits(uint64_t a,uint64_t b) { return a+b; }
+inline uint32_t mad_lo_s32_bits(uint32_t a,uint32_t b,uint32_t c) {
+    return uint32_t(uint64_t(a)*uint64_t(b)+uint64_t(c));
+}
