+std::string function_info::trace_static_cfg_metadata(bool gerem_minimal) const {
+  std::vector<sara_cfg::instruction> rows;
+  if (m_instr_mem != NULL && m_n > 0 && m_n <= m_instr_mem_size) {
+    for (uint64_t offset = 0; offset < m_n;) {
+      const ptx_instruction *instruction = m_instr_mem[offset];
+      if (instruction == NULL || instruction->is_label() || !instruction->inst_size() ||
+          instruction->inst_size() > 8 || instruction->inst_size() > m_n - offset) break;
+      sara_cfg::instruction row;
+      row.pc = instruction->get_PC();
+      row.size = instruction->inst_size();
+      row.base_opcode = instruction->get_opcode_cstr();
+      row.opcode = extract_opcode_token(instruction);
+      if (!gerem_minimal) {
+      row.full32_operands_json = trace_full32_operands(instruction);
+      row.bfi_operands_json = trace_bfi_operands(instruction);
+      row.sfu_unchanged_effect_json = trace_sfu_unchanged_effect(instruction);
+      row.scalar_pure_effect_json = trace_scalar_pure_effect(instruction);
+      }
+      row.predicate = instruction->has_pred();
+      row.exit_modifier = instruction->is_exit();
+      row.source_file = instruction->source_file();
+      row.source_line = instruction->source_line();
+      row.memory_read = instruction->has_memory_read();
+      row.memory_write = instruction->has_memory_write();
+      if (instruction->get_opcode() == BRA_OP && instruction->get_num_operands() > 0) {
+        const operand_info &target = instruction->dst();
+        if (target.is_label() && target.get_symbol() != NULL && target.get_symbol()->is_label()) {
+          row.target_valid = true;
+          row.target = target.get_symbol()->get_address();
+        }
+      }
+      rows.push_back(row);
+      offset += row.size;
+    }
+  }
+  const sara_cfg::result result = sara_cfg::complete_static_table(rows, m_start_PC, m_n);
+  std::ostringstream out;
+  out << "{\"schema\":\"sara-function-static-cfg-v1\",\"source\":\"actual_assembled_ptx_instruction_memory\","
+      << "\"function_name\":\"" << json_escape(m_name) << "\",\"entry_point\":" << (m_entry_point ? "true" : "false")
+      << ",\"start_pc\":\"" << hex_u64(m_start_PC) << "\",\"extent_bytes\":" << m_n
+      << ",\"complete_for_gerem\":" << (result.complete ? "true" : "false")
+      << ",\"instruction_count\":" << result.instructions.size() << ",\"issues\":[";
+  for (size_t i = 0; i < result.issues.size(); ++i) {
+    if (i) out << ',';
+    out << '\"' << json_escape(result.issues[i]) << '\"';
+  }
+  out << "],\"instructions\":[";
+  for (size_t i = 0; i < result.instructions.size(); ++i) {
+    const sara_cfg::instruction &row = result.instructions[i];
+    if (i) out << ',';
+    out << "{\"pc\":\"" << hex_u64(row.pc) << "\",\"size_bytes\":" << row.size
+        << ",\"base_opcode\":\"" << json_escape(row.base_opcode) << "\",\"opcode\":\"" << json_escape(row.opcode)
+        << "\",\"kind\":\"" << row.kind << "\",\"has_predicate\":" << (row.predicate ? "true" : "false")
+        << ",\"memory_read\":" << (row.memory_read ? "true" : "false")
+        << ",\"memory_write\":" << (row.memory_write ? "true" : "false");
+    if (!gerem_minimal)
+      out << ",\"source_file\":\"" << json_escape(row.source_file) << "\",\"source_line\":" << row.source_line;
+    out << ",\"unsupported\":\"" << json_escape(row.unsupported) << '\"';
+    if (!gerem_minimal) {
+    out << ",\"loaded_full32_operands\":" << (row.full32_operands_json.empty() ? "null" : row.full32_operands_json);
+    out << ",\"loaded_bfi_operands\":" << (row.bfi_operands_json.empty() ? "null" : row.bfi_operands_json);
+    out << ",\"loaded_sfu_unchanged_effect\":" << (row.sfu_unchanged_effect_json.empty() ? "null" : row.sfu_unchanged_effect_json);
+    out << ",\"loaded_scalar_pure_effect\":" << (row.scalar_pure_effect_json.empty() ? "null" : row.scalar_pure_effect_json);
+    }
+    out << ",\"next_pc\":";
+    if (row.next_valid) out << '\"' << hex_u64(row.next) << '\"'; else out << "null";
+    out << ",\"taken_target_pc\":";
+    if (row.taken_valid) out << '\"' << hex_u64(row.taken) << '\"'; else out << "null";
+    out << ",\"fallthrough_pc\":";
+    if (row.fallthrough_valid) out << '\"' << hex_u64(row.fallthrough) << '\"'; else out << "null";
+    out << '}';
+  }
+  out << "]}";
+  return out.str();
+}
