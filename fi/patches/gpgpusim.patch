+static int set_host_fp_rounding_mode(unsigned rounding_mode) {
+  int orig_rm = fegetround();
+  switch (rounding_mode) {
+    case RN_OPTION:
+      fesetround(FE_TONEAREST);
+      break;
+    case RZ_OPTION:
+      fesetround(FE_TOWARDZERO);
+      break;
+    case RM_OPTION:
+      fesetround(FE_DOWNWARD);
+      break;
+    case RP_OPTION:
+      fesetround(FE_UPWARD);
+      break;
+    default:
+      assert(0);
+      break;
+  }
+  return orig_rm;
