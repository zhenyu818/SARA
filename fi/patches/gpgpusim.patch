+// Exact BFI operand facts only; semantics remain in the separate integer model.
+static std::string trace_bfi_operands(const ptx_instruction *instruction) {
+  if (instruction->get_opcode() != BFI_OP) return "null";
+  if (instruction->get_scalar_type().size() != 1) return "null";
+  const unsigned type = instruction->get_type();
+  const unsigned width = type == B32_TYPE ? 32 : 64;
+  const std::string opcode = type == B32_TYPE ? "bfi.b32" : "bfi.b64";
+  if ((type != B32_TYPE && type != B64_TYPE) || instruction->get_num_operands() != 5 ||
+      instruction->is_exit() || !instruction->get_options().empty() ||
+      instruction->has_memory_read() || instruction->has_memory_write() ||
+      extract_opcode_token(instruction) != opcode || instruction->latency != 1 ||
+      instruction->initiation_interval != 1 || instruction->op != ALU_OP) return "null";
+  if (instruction->has_pred() && instruction->get_pred_mod() != -1) return "null";
+  const symbol *pred = instruction->has_pred() ? instruction->get_pred().get_symbol() : NULL;
+  if (instruction->has_pred() && (!pred || !pred->is_reg() || !pred->uid() || !pred->type() ||
+      pred->type()->get_key().scalar_type() != PRED_TYPE)) return "null";
+  const operand_info &destination = instruction->dst();
+  if (!destination.is_reg() || destination.is_vector() || destination.get_addr_space() != undefined_space ||
+      destination.get_operand_lohi() != 0 || destination.get_operand_neg() || destination.is_neg_pred() ||
+      destination.get_double_operand_type() != 0) return "null";
+  const symbol *reg = destination.get_symbol();
+  if (!reg || !reg->is_reg() || reg->name() == "_" || !reg->uid() || !reg->type() || reg->get_size_in_bytes() * 8 != width ||
+      reg->type()->get_key().scalar_type() == PRED_TYPE) return "null";
+  std::ostringstream out;
+  out << "{\"schema\":\"sara-assembled-bfi-operands-v1\",\"opcode\":\"" << opcode
+      << "\",\"source_line_projection\":\"existing_ptx_ir_removes_tabs_v1\",\"assembled_source_line\":\""
+      << json_escape(instruction->get_source()) << "\",\"memory\":false,\"control\":false,"
+      << "\"implicit_state\":false,\"latency\":1,\"initiation_interval\":1,"
+      << "\"route\":\"ALU\",\"predicate\":";
+  if (pred) out << "{\"name\":\"" << json_escape(pred->name()) << "\",\"register_uid\":" << pred->uid()
+                << ",\"modifier\":-1,\"negated\":" << (instruction->get_pred_neg() ? "true" : "false") << "}";
+  else out << "null";
+  out << ",\"sources\":[";
+  const operand_info *sources[] = {&instruction->src1(), &instruction->src2(), &instruction->src3(), &instruction->src4()};
+  const char *roles[] = {"source", "base", "position", "length"};
+  for (unsigned source = 0; source < 4; ++source) {
+    const operand_info &operand = *sources[source];
+    const unsigned bits = source < 2 ? width : 32;
+    if (operand.is_vector() || operand.get_addr_space() != undefined_space || operand.get_operand_lohi() != 0 ||
+        operand.get_operand_neg() || operand.is_neg_pred() || operand.get_double_operand_type() != 0) return "null";
+    if (source) out << ',';
+    out << "{\"role\":\"" << roles[source] << "\",\"width_bits\":" << bits;
+    if (operand.is_reg()) {
+      const symbol *input = operand.get_symbol();
+      if (!input || !input->is_reg() || input->name() == "_" || !input->uid() || !input->type() || input->get_size_in_bytes() * 8 != bits ||
+          input->type()->get_key().scalar_type() == PRED_TYPE) return "null";
+      out << ",\"kind\":\"register\",\"name\":\"" << json_escape(input->name())
+          << "\",\"register_uid\":" << input->uid();
+    } else if (operand.is_literal() && (operand.get_type() == int_t || operand.get_type() == unsigned_t)) {
+      const unsigned long long value = bits == 32 ? operand.get_literal_value().u32 : operand.get_literal_value().u64;
+      if (source >= 2 && value > 255) return "null";  // ptxas requires literal controls in [0,255].
+      out << ",\"kind\":\"literal\",\"value\":\"" << hex_u64(value) << "\"";
+    } else return "null";
+    out << '}';
+  }
+  out << "],\"destinations\":[{\"width_bits\":" << width << ",\"name\":\"" << json_escape(reg->name())
+      << "\",\"register_uid\":" << reg->uid() << "}]}";
+  return out.str();
+}
