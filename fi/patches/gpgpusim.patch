+// Three unchanged-input forms, U32 conversion and separately admitted S32 DIV/REM.
+// This observer records actual effects; it grants no numeric replay authority.
+// Exact options and real typed operands exclude hidden carry/memory/control.
+// Six exact complete-LM unchanged-input effects. This observer supplies no
+// numeric mutant evaluator, application issuer, population filtering or rule.
+static std::string trace_complete_lm_pure_effect(const ptx_instruction *instruction) {
+  const std::string opcode=extract_opcode_token(instruction);
+  const bool s64_f64=opcode=="cvt.rn.f64.s64", f32_s32=opcode=="cvt.rni.s32.f32";
+  const bool f64_f32=opcode=="cvt.rn.f32.f64", rzi_f32=opcode=="cvt.rzi.f32.f32";
+  const bool multiply=opcode=="mul.f64", compare=opcode=="setp.neu.f32";
+  const bool convert=s64_f64 || f32_s32 || f64_f32 || rzi_f32;
+  if ((!convert && !multiply && !compare) || instruction->is_exit() || instruction->is_neg() ||
+      instruction->has_memory_read() || instruction->has_memory_write() ||
+      !instruction->latency || !instruction->initiation_interval) return "null";
+  const unsigned sources=convert?1:2, dst_bits=compare?1:(s64_f64 || multiply?64:32);
+  const unsigned src_bits=s64_f64 || f64_f32 || multiply?64:32;
+  const unsigned dst_scalar=compare?PRED_TYPE:s64_f64 || multiply?F64_TYPE:f32_s32?S32_TYPE:F32_TYPE;
+  const unsigned src_scalar=s64_f64?S64_TYPE:f64_f32 || multiply?F64_TYPE:F32_TYPE;
+  const char *dst_type=compare?"pred":s64_f64 || multiply?"f64":f32_s32?"s32":"f32";
+  const char *src_type=s64_f64?"s64":f64_f32 || multiply?"f64":"f32";
+  const std::list<int> options=instruction->get_options();
+  const int option=s64_f64 || f64_f32?RN_OPTION:f32_s32?RNI_OPTION:rzi_f32?RZI_OPTION:NEU_OPTION;
+  if (instruction->get_num_operands()!=sources+1 || instruction->get_scalar_type().size()!=(convert?2u:1u) ||
+      (multiply?!options.empty():(options.size()!=1 || options.front()!=option)) ||
+      instruction->get_opcode()!=(convert?CVT_OP:multiply?MUL_OP:SETP_OP) ||
+      instruction->get_type()!=(compare?F32_TYPE:dst_scalar) ||
+      (convert && instruction->get_type2()!=src_scalar) ||
+      (compare && instruction->get_cmpop()!=NEU_OPTION) ||
+      instruction->op!=(multiply?DP_OP:ALU_OP)) return "null";
+  if (instruction->has_pred() && instruction->get_pred_mod()!=-1) return "null";
+  const symbol *predicate=instruction->has_pred()?instruction->get_pred().get_symbol():NULL;
+  if (instruction->has_pred() && (!predicate || !predicate->is_reg() || !predicate->uid() ||
+      !predicate->type() || predicate->type()->get_key().scalar_type()!=PRED_TYPE)) return "null";
+  for (unsigned n=0;n<=sources;++n) {
+    const operand_info &operand=instruction->operand_lookup(n);
+    if (operand.is_vector() || operand.get_addr_space()!=undefined_space || operand.get_operand_lohi() ||
+        operand.get_operand_neg() || operand.is_neg_pred() || operand.get_double_operand_type()) return "null";
+  }
+  const operand_info &dst=instruction->dst();const symbol *write=dst.is_reg()?dst.get_symbol():NULL;
+  if (!write || !write->is_reg() || !write->uid() || write->name()=="_" || !write->type() ||
+      (compare?write->type()->get_key().scalar_type()!=PRED_TYPE:
+        (write->type()->get_key().scalar_type()==PRED_TYPE || write->get_size_in_bytes()*8!=dst_bits))) return "null";
+  std::ostringstream out;
+  out << "{\"schema\":\"sara-assembled-scalar-pure-effect-v1\",\"opcode\":\"" << opcode
+      << "\",\"source_line_projection\":\"existing_ptx_ir_removes_tabs_v1\",\"assembled_source_line\":\""
+      << json_escape(instruction->get_source()) << "\",\"memory\":false,\"control\":false,\"implicit_state\":false,"
+      << "\"route\":\"" << (multiply?"DP":"ALU") << "\",\"latency\":" << instruction->latency
+      << ",\"initiation_interval\":" << instruction->initiation_interval << ",\"predicate\":";
+  if (predicate) out << "{\"name\":\"" << json_escape(predicate->name()) << "\",\"register_uid\":" << predicate->uid()
+      << ",\"modifier\":-1,\"negated\":" << (instruction->get_pred_neg()?"true":"false") << '}';
+  else out << "null";
+  out << ",\"sources\":[";
+  for (unsigned n=0;n<sources;++n) {
+    const operand_info &operand=instruction->operand_lookup(n+1);if(n)out << ',';
+    out << "{\"role\":\"operand\",\"operand_index\":" << n+1 << ",\"scalar_type\":\"" << src_type
+        << "\",\"width_bits\":" << src_bits;
+    if (operand.is_reg()) {
+      const symbol *read=operand.get_symbol();
+      if (!read || !read->is_reg() || !read->uid() || read->name()=="_" || !read->type() ||
+          read->type()->get_key().scalar_type()==PRED_TYPE || read->get_size_in_bytes()*8!=src_bits) return "null";
+      out << ",\"kind\":\"register\",\"name\":\"" << json_escape(read->name()) << "\",\"register_uid\":" << read->uid();
+    } else if (!convert && operand.is_literal() && operand.get_type()==(multiply?double_op_t:float_op_t)) {
+      out << ",\"kind\":\"literal\",\"value\":\"" << hex_u64(multiply?operand.get_literal_value().u64:operand.get_literal_value().u32) << '"';
+    } else return "null";
+    out << '}';
+  }
+  out << "],\"destinations\":[{\"scalar_type\":\"" << dst_type << "\",\"width_bits\":" << dst_bits
+      << ",\"name\":\"" << json_escape(write->name()) << "\",\"register_uid\":" << write->uid() << "}]}";
+  return out.str();
+}
