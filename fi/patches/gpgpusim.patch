+// Exact hook storage mapping; disabled mode returns before topology, cursor,
+// getters, allocation of the stream or its maps, formatting and writer locks.
+void gpgpu_sim::collect_cache_state(uint64_t cycle) {
+  if (!m_config.cache_state_ledger() || !sara_host_copy::get()) return;
+  static sara_cache_records::state_stream *stream = new sara_cache_records::state_stream;
+  const uint64_t cursor = sara_exact_trace_instruction_cursor();
+  static bool topology_written = false;
+  if (!topology_written) {
+    std::ostringstream topology; topology << "\"owners\":["; bool comma = false;
+    for (unsigned c = 0; c < m_shader_config->n_simt_clusters; ++c)
+      for (unsigned local = 0; local < m_shader_config->n_simt_cores_per_cluster; ++local) {
+        if (comma) topology << ','; comma = true;
+        topology << sara_host_copy::quoted("l1d:" + std::to_string(m_shader_config->cid_to_sid(local, c)));
+      }
+    for (unsigned bank = 0; bank < m_memory_config->m_n_mem_sub_partition; ++bank) {
+      if (comma) topology << ','; comma = true;
+      topology << sara_host_copy::quoted("l2:" + std::to_string(bank));
+    }
+    topology << ']'; sara_host_copy::get()->cache_event("cache_topology", cursor, topology.str()); topology_written = true;
+  }
+  stream->begin(cycle, cursor);
+  for (unsigned cluster = 0; cluster < m_shader_config->n_simt_clusters; ++cluster) {
+    simt_core_cluster *c = m_cluster[cluster];
+    for (unsigned local = 0; local < m_shader_config->n_simt_cores_per_cluster; ++local) {
+      const unsigned expected_sm = m_shader_config->cid_to_sid(local, cluster);
+      shader_core_ctx *core = c ? c->get_core()[local] : NULL;
+      baseline_cache *cache = core && core->m_ldst_unit ? core->m_ldst_unit->m_L1D : NULL;
+      const bool disabled = m_shader_config->m_L1D_config.disabled();
+      const unsigned actual_sm = core ? core->get_sid() : expected_sm;
+      if (core && actual_sm != expected_sm) sara_host_copy::get()->unmodeled("cache_SM_topology_mismatch", actual_sm, expected_sm, cursor);
+      stream->owner("l1d:" + std::to_string(expected_sm), "l1d", actual_sm, disabled,
+                    disabled || !cache ? NULL : cache->m_tag_array, disabled ? NULL : (cache ? &cache->m_config : &m_shader_config->m_L1D_config), core != NULL);
+    }
+  }
+  const bool l2_disabled = m_memory_config->m_L2_config.disabled();
+  for (unsigned bank = 0; bank < m_memory_config->m_n_mem_sub_partition; ++bank) {
+    // Configured-disabled m_L2cache is not guaranteed initialized; never read it.
+    l2_cache *cache = l2_disabled || !m_memory_sub_partition[bank] ? NULL : m_memory_sub_partition[bank]->m_L2cache;
+    stream->owner("l2:" + std::to_string(bank), "l2", bank, l2_disabled,
+                  cache ? cache->m_tag_array : NULL, l2_disabled ? NULL : (cache ? &cache->m_config : &m_memory_config->m_L2_config));
+  }
+  stream->end();
+}
