+typedef std::tuple<unsigned, unsigned, uint64_t, uint64_t, uint64_t> cache_read_key;
+// (shader, hardware warp, PC, instruction issue cycle, logical block address)
+struct cache_read_observation {
+  cache_read_observation() : level(0), slot(0), version(0), execution(0), tag(0), mask(0), thread(0), kernel(0) {}
+  unsigned level;
+  uintptr_t slot;
+  uint64_t version, execution, tag;
+  unsigned char mask;
+  std::string realization;
+  uint64_t thread, kernel;
+};
+
+inline bool live_cache_error() {
+  if (!cache_overlay::copies().empty()) return true;
+  for (std::set<const cache_payload *>::const_iterator payload = inflight_cache_payloads().begin();
+       payload != inflight_cache_payloads().end(); ++payload)
+    if (!(*payload)->empty()) return true;
+  return false;
+}
+
+inline std::string active_cache_realization() {
+  if (!cache_overlay::copies().empty()) return (*cache_overlay::copies().begin())->realization();
+  for (std::set<const cache_payload *>::const_iterator payload = inflight_cache_payloads().begin();
+       payload != inflight_cache_payloads().end(); ++payload)
+    if (!(*payload)->empty()) return (*payload)->begin()->second.realization;
+  return std::string();
+}
+
+inline std::string cache_transfer_conflict(uint64_t address, uint64_t count) {
+  if (!count) return std::string();
+  const std::set<cache_overlay *> &copies = cache_overlay::copies();
+  for (std::set<cache_overlay *>::const_iterator copy = copies.begin(); copy != copies.end(); ++copy) {
+    const cache_payload payload = (*copy)->snapshot(0, (*copy)->line_bytes());
+    for (cache_payload::const_iterator byte = payload.begin(); byte != payload.end(); ++byte)
+      if (byte->first >= address && byte->first - address < count) return byte->second.realization;
+  }
+  for (std::set<const cache_payload *>::const_iterator payload = inflight_cache_payloads().begin();
+       payload != inflight_cache_payloads().end(); ++payload)
+    for (cache_payload::const_iterator byte = (*payload)->begin(); byte != (*payload)->end(); ++byte)
+      if (byte->first >= address && byte->first - address < count) return byte->second.realization;
+  return std::string();
+}
+
+inline void guard_resident_cache_transfer(uint64_t address, uint64_t count, const char *reason) {
+  const std::string id = cache_transfer_conflict(address, count);
+  if (!id.empty()) cache_approximation(reason, id.find("l1d:") == 0 ? "l1d" : "l2", id);
+}
+
+inline void guard_cache_transfer(uint64_t address, uint64_t count, const char *reason) {
+  if (count) cold_invalid_data::unreviewed_transfer();
+  guard_resident_cache_transfer(address, count, reason);
+}
+inline void guard_direct_backing_cache_transfer(uint64_t address, uint64_t count, const char *reason) {
+  if (count) cold_invalid_data::direct_backing_transfer();
+  guard_resident_cache_transfer(address, count, reason);
+}
