+    std::numeric_limits<float>::is_iec559 && std::numeric_limits<float>::digits==24 &&
+    std::numeric_limits<double>::is_iec559 && std::numeric_limits<double>::digits==53,
+    "PTX RN arithmetic requires IEEE binary32/binary64 host operations");
+static_assert(FLT_EVAL_METHOD==0,"PTX RN arithmetic requires evaluation at the declared host precision");
+inline uint32_t add_rn_f32_bits(uint32_t a,uint32_t b) {
+    const uint32_t aa=a&0x7fffffffu,bb=b&0x7fffffffu;
+    if (aa>0x7f800000u || bb>0x7f800000u ||
+        (aa==0x7f800000u && bb==0x7f800000u && ((a^b)&0x80000000u))) return 0x7fc00000u;
+    if (aa==0x7f800000u) return a;
+    if (bb==0x7f800000u) return b;
+    ScopedRounding rounding(FE_TONEAREST);
+    float x,y;std::memcpy(&x,&a,4);std::memcpy(&y,&b,4);
+    volatile float first=x,second=y;
+    volatile float result=first+second;
+    const float copy=result;uint32_t bits;std::memcpy(&bits,&copy,4);return bits;
+}
+// Subtraction is addition after an exact raw sign toggle. Reuse the same
+// single-RN arithmetic, gradual underflow and complete host-state isolation.
+inline uint32_t sub_rn_f32_bits(uint32_t a,uint32_t b) {
+    return add_rn_f32_bits(a,b^0x80000000u);
+}
+inline uint32_t mul_rn_f32_bits(uint32_t a,uint32_t b) {
+    const uint32_t aa=a&0x7fffffffu,bb=b&0x7fffffffu,sign=(a^b)&0x80000000u;
+    if (aa>0x7f800000u || bb>0x7f800000u ||
+        (aa==0x7f800000u && bb==0) || (bb==0x7f800000u && aa==0)) return 0x7fc00000u;
+    if (aa==0x7f800000u || bb==0x7f800000u) return sign|0x7f800000u;
+    ScopedRounding rounding(FE_TONEAREST);
+    float x,y;std::memcpy(&x,&a,4);std::memcpy(&y,&b,4);
+    volatile float first=x,second=y;
+    volatile float result=first*second;
+    const float copy=result;uint32_t bits;std::memcpy(&bits,&copy,4);return bits;
+}
+inline uint64_t mul_rn_f64_bits(uint64_t a,uint64_t b) {
+    const uint64_t aa=a&UINT64_C(0x7fffffffffffffff),bb=b&UINT64_C(0x7fffffffffffffff);
+    const uint64_t infinity=UINT64_C(0x7ff0000000000000),sign=(a^b)&UINT64_C(0x8000000000000000);
+    if (aa>infinity || bb>infinity || (aa==infinity && bb==0) || (bb==infinity && aa==0))
+        return UINT64_C(0x7ff8000000000000);
+    if (aa==infinity || bb==infinity) return sign|infinity;
+    ScopedRounding rounding(FE_TONEAREST);
+    double x,y;std::memcpy(&x,&a,8);std::memcpy(&y,&b,8);
+    volatile double first=x,second=y;
+    volatile double result=first*second;
+    const double copy=result;uint64_t bits;std::memcpy(&bits,&copy,8);return bits;
+}
