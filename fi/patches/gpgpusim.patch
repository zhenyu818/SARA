+// Direct immutable slots, not tag_array::probe: that const API also runs FI
+// registry/alias guards. This witness observes candidates without those calls.
+inline std::string slot_state(const tag_array *tags, const cache_config &cfg, unsigned slot) {
+  const cache_block_t *line = tags->get_block(slot);
+  std::ostringstream out; out << "{\"copy\":" << identity(tags, cfg, slot) << ",\"sector_state\":[";
+  const unsigned count = cfg.m_cache_type == NORMAL ? 1 : SECTOR_CHUNCK_SIZE;
+  for (unsigned index = 0; index < count; ++index) {
+    if (index) out << ','; mem_access_sector_mask_t mask; mask.set(index);
+    out << "{\"status\":" << line->get_status(mask) << ",\"readable\":"
+        << (line->is_readable(mask) ? "true" : "false") << '}';
+  }
+  out << "]}"; return out.str();
+}
+inline std::string candidate(const tag_array *tags, const cache_config &cfg, uint64_t address) {
+  if (!tags || cfg.disabled()) return "{\"route_disabled\":true,\"probe_status\":null,\"copy\":null}";
+  const unsigned sector = cfg.m_cache_type == NORMAL ? 0 :
+      (address % cfg.get_line_sz()) / (cfg.get_line_sz() / SECTOR_CHUNCK_SIZE);
+  mem_access_sector_mask_t mask; mask.set(sector);
+  const uint64_t set = cfg.set_index(address), tag = cfg.tag(address);
+  unsigned status = MISS, found = static_cast<unsigned>(-1); bool all_reserved = true;
+  for (unsigned way = 0; way < cfg.m_assoc; ++way) {
+    const unsigned index = static_cast<unsigned>(set * cfg.m_assoc + way);
+    const cache_block_t *line = tags->get_block(index);
+    if (!line->is_reserved_line()) all_reserved = false;
+    if (line->m_tag != tag) continue;
+    const cache_block_state state = line->get_status(mask);
+    if (state == RESERVED) { status = HIT_RESERVED; found = index; break; }
+    if (state == VALID || (state == MODIFIED && line->is_readable(mask))) { status = HIT; found = index; break; }
+    if (state == MODIFIED || (line->is_valid_line() && state == INVALID)) { status = SECTOR_MISS; found = index; break; }
+  }
+  if (found == static_cast<unsigned>(-1) && all_reserved) status = RESERVATION_FAIL;
+  std::ostringstream out; out << "{\"route_disabled\":false,\"write_policy\":" << cfg.get_write_policy()
+      << ",\"probe_status\":" << status << ",\"copy\":";
+  if (found == static_cast<unsigned>(-1)) out << "null"; else out << identity(tags, cfg, found);
+  out << '}'; return out.str();
+}
+inline std::string payload(const sara_fault::cache_payload &bytes) {
+  std::ostringstream out; out << '[';
+  for (sara_fault::cache_payload::const_iterator i = bytes.begin(); i != bytes.end(); ++i) {
+    if (i != bytes.begin()) out << ',';
+    out << "{\"address\":" << i->first << ",\"mask\":" << static_cast<unsigned>(i->second.mask)
+        << ",\"realization_id\":" << sara_host_copy::quoted(i->second.realization) << '}';
+  } out << ']'; return out.str();
+}
+inline std::string ranges(const cache_config &cfg, const cache_block_t *line, mem_fetch *mf) {
+  std::ostringstream out; out << '[';
+  if (cfg.m_cache_type == NORMAL) out << '[' << line->m_block_addr << ',' << cfg.get_line_sz() << ']';
+  else {
+    bool comma = false; const uint64_t count = cfg.get_line_sz() / SECTOR_CHUNCK_SIZE;
+    for (unsigned s = 0; s < SECTOR_CHUNCK_SIZE; ++s) if (mf->get_access_sector_mask().test(s)) {
+      if (comma) out << ','; comma = true; out << '[' << line->m_block_addr + s * count << ',' << count << ']';
+    }
+  } out << ']'; return out.str();
+}
+inline std::string request(mem_fetch *mf) {
+  mem_fetch *instruction_owner = mf;
+  while (instruction_owner->get_inst().empty() && instruction_owner->get_original_mf()) {
+    mem_fetch *prior = instruction_owner->get_original_mf();
+    if (prior->observation_lifetime() >= instruction_owner->observation_lifetime())
+      sara_host_copy::fail("nondecreasing_actual_instruction_request_ancestry");
+    instruction_owner = prior;
+  }
+  std::ostringstream out; out << "\"request_lifetime\":" << mf->observation_lifetime()
+      << ",\"root_lifetime\":" << mf->observation_root_lifetime() << ",\"request_uid\":" << mf->get_request_uid() << ",\"original_request_lifetime\":"
+      << (mf->get_original_mf() ? mf->get_original_mf()->observation_lifetime() : 0)
+      << ",\"request_address\":" << mf->get_addr() << ",\"request_access_type\":" << mf->get_access_type()
+      << ",\"sm\":" << mf->get_sid() << ",\"warp\":" << mf->get_wid() << ",\"subpartition\":" << mf->get_sub_partition_id();
+  out << ",\"instruction_request_lifetime\":" << instruction_owner->observation_lifetime();
+  if (!instruction_owner->get_inst().empty()) out << ",\"dynamic_warp_instruction_uid\":" << instruction_owner->get_inst().get_uid()
+      << ",\"instruction_pc\":" << instruction_owner->get_inst().pc << ",\"instruction_issue\":" << instruction_owner->get_inst().get_issue_cycle();
+  else out << ",\"dynamic_warp_instruction_uid\":null,\"instruction_pc\":null,\"instruction_issue\":null";
+  return out.str();
+}
+inline void response(tag_array *tags, const cache_config &cfg, unsigned slot, mem_fetch *mf, uint64_t cycle, uint64_t cursor) {
+  sara_host_copy::collector *writer = sara_host_copy::get(); if (!writer) return;
+  const cache_block_t *line = tags->get_block(slot);
+  std::ostringstream out; out << request(mf) << ",\"cycle\":" << cycle << ",\"component\":\"l2\",\"source\":" << identity(tags, cfg, slot)
+      << ",\"ranges\":" << ranges(cfg, line, mf) << ",\"payload\":" << payload(mf->m_fault_payload)
+      << ",\"source_payload\":" << payload(line->m_fault_overlay.snapshot(0, cfg.get_line_sz())) << ",\"forwarded_bytes\":[";
+  for (size_t i = 0; i < mf->m_observed_forwarded_bytes.size(); ++i) { if (i) out << ','; out << mf->m_observed_forwarded_bytes[i]; }
+  out << ']';
+  const uint64_t event = writer->cache_event("cache_response", cursor, out.str());
+  mf->m_observed_cache_sources.clear(); mf->m_observed_cache_sources.push_back(event);
+}
+inline void fill(tag_array *tags, const cache_config &cfg, unsigned slot, mem_fetch *mf, const char *component, unsigned service_time, const sara_fault::cache_payload &before, uint64_t cycle, uint64_t cursor) {
+  sara_host_copy::collector *writer = sara_host_copy::get(); if (!writer) return;
+  const cache_block_t *line = tags->get_block(slot);
+  std::ostringstream out; out << request(mf) << ",\"component\":" << sara_host_copy::quoted(component)
+      << ",\"service_time_u32\":" << service_time << ",\"global_cycle\":"
+      << (cycle == UINT64_MAX ? "null" : std::to_string(cycle)) << ",\"destination\":" << identity(tags, cfg, slot)
+      << ",\"ranges\":" << ranges(cfg, line, mf) << ",\"source_events\":[";
+  for (size_t i = 0; i < mf->m_observed_cache_sources.size(); ++i) { if (i) out << ','; out << mf->m_observed_cache_sources[i]; }
+  out << "],\"backing_source\":" << (mf->m_observed_cache_sources.empty() ? "true" : "false")
+      << ",\"transport_payload\":" << payload(mf->m_fault_payload)
+      << ",\"destination_before_payload\":" << payload(before)
+      << ",\"destination_payload\":" << payload(line->m_fault_overlay.snapshot(0, cfg.get_line_sz()));
+  const uint64_t event = writer->cache_event("cache_fill", cursor, out.str());
+  // L2 miss responses carry the actual fill as their producer. L1 consumes it.
+  if (std::string(component) == "l2") { mf->m_observed_cache_sources.clear(); mf->m_observed_cache_sources.push_back(event); }
+}
+inline void access(tag_array *tags, const cache_config &cfg, unsigned slot, mem_fetch *mf,
+    unsigned level, cache_request_status probe, cache_request_status accepted, uint64_t cycle, uint64_t cursor, const std::string &before) {
+  sara_host_copy::collector *writer = sara_host_copy::get(); if (!writer) return;
+  std::ostringstream out; out << request(mf) << ",\"component\":\"" << (level == 1 ? "l1d" : "l2") << "\",\"cycle\":" << cycle
+      << ",\"request_block\":" << cfg.block_addr(mf->get_addr()) << ",\"before_copy\":" << before << ",\"write\":" << (mf->get_is_write() ? "true" : "false") << ",\"probe_status\":" << probe << ",\"accepted_status\":" << accepted
+      << ",\"byte_mask\":" << sara_host_copy::quoted(mf->get_access_byte_mask().to_string())
+      << ",\"sector_mask\":" << mf->get_access_sector_mask().to_ulong();
+  if (slot != static_cast<unsigned>(-1)) out << ",\"selected_copy\":" << identity(tags, cfg, slot);
+  else out << ",\"selected_copy\":null";
+  writer->cache_event("cache_access", cursor, out.str());
