@@ -0,0 +1,58 @@
+#ifndef SARA_PTX_COMMON_SCALAR_OPS_H
+#define SARA_PTX_COMMON_SCALAR_OPS_H
+// Only the actually emitted max.f32 / cvt.sat.f32.f32 / div.rn.f32 forms.
+// PTX7.8 CUDA11.8 9.7.3.8/12 and 9.7.8.18. No replay permission.
+#include "ptx_fp_ops.h"
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#if defined(__FAST_MATH__)
+#error "PTX scalar semantics require IEEE arithmetic, not fast-math"
+#endif
+namespace sara_ptx {
+static_assert(std::numeric_limits<float>::is_iec559 && sizeof(float)==4,
+              "common scalar PTX requires binary32");
+inline bool scalar_nan32(uint32_t x) { return (x & 0x7fffffffu)>0x7f800000u; }
+inline uint32_t scalar_max_f32(uint32_t a, uint32_t b) {
+  // Integer ordering avoids inherited DAZ/FTZ and preserves every finite bit.
+  if (scalar_nan32(a)) return scalar_nan32(b) ? 0x7fc00000u : b;
+  if (scalar_nan32(b)) return a;
+  if ((a & 0x7fffffffu)==0 && (b & 0x7fffffffu)==0) return a & b;
+  const uint32_t ka=(a & 0x80000000u) ? ~a : a ^ 0x80000000u;
+  const uint32_t kb=(b & 0x80000000u) ? ~b : b ^ 0x80000000u;
+  return ka>kb ? a : b;
+}
+inline uint32_t scalar_cvt_sat_f32(uint32_t a) {
+  if (scalar_nan32(a)) return 0;
+  // Preserve -0 (inside the interval); no claim that .sat specifies its sign.
+  if (a & 0x80000000u) return (a & 0x7fffffffu)==0 ? a : 0;
+  return a>0x3f800000u ? 0x3f800000u : a;
+}
+inline uint32_t scalar_div_rn_f32(uint32_t a, uint32_t b) {
+  const uint32_t aa=a & 0x7fffffffu, bb=b & 0x7fffffffu;
+  const uint32_t sign=(a ^ b) & 0x80000000u;
+  if (scalar_nan32(a) || scalar_nan32(b) || (aa==0 && bb==0) ||
+      (aa==0x7f800000u && bb==0x7f800000u)) return 0x7fc00000u;
+  if (aa==0x7f800000u || bb==0) return sign | 0x7f800000u;
+  if (aa==0 || bb==0x7f800000u) return sign;
+  ScopedRounding rounding(FE_TONEAREST);
+  float fa,fb; std::memcpy(&fa,&a,4); std::memcpy(&fb,&b,4);
+  volatile float numerator=fa, denominator=fb;
+  volatile float result=numerator/denominator;
+  const float copy=result; uint32_t bits; std::memcpy(&bits,&copy,4); return bits;
+}
+inline bool scalar_s32_divrem_supported(int32_t a, int32_t b) {
+  return b!=0 && !(a==(std::numeric_limits<int32_t>::min)() && b==-1);
+}
+inline int32_t scalar_div_s32(int32_t a, int32_t b) {
+  if (!scalar_s32_divrem_supported(a,b)) throw std::domain_error("PTX signed32 division outside modeled domain");
+  return a/b;
+}
+inline int32_t scalar_rem_s32(int32_t a, int32_t b) {
+  if (!scalar_s32_divrem_supported(a,b)) throw std::domain_error("PTX signed32 remainder outside modeled domain");
+  // Explicit chosen simulator convention; PTX negative remainder is machine-dependent.
+  return a%b;
+}
+}
+#endif
