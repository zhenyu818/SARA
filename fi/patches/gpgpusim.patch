+void local_global_write_l2_bf (ptx_thread_info *thread, ptx_reg_t &data, size_t size, addr_t addr, memory_space_t space) {
+  if (!space.is_global() && !space.is_local()) return;
+
+  gpgpu_sim *gpu_sim = (gpgpu_sim *)(thread->m_gpu);
+  if (gpu_sim->cache_fault_model_active) return;
+
+  if (gpu_sim->l2_enabled) {
+    l1_cache *L1D = (l1_cache *) find_l1(thread, gpu_sim, 0);
+    if (fault_bypasses_l1d(thread, L1D, space)) {
+      check_and_apply_l2_bf(thread, addr, data, size, true, false, false, false);
+      return;
+    }
+    if (L1D != NULL) {
+      unsigned chunk_idx = (addr % L1D->m_config.get_line_sz()) / (L1D->m_config.get_line_sz()/SECTOR_CHUNCK_SIZE);
+      mem_access_sector_mask_t mask = mem_access_sector_mask_t();
+      mask.set(chunk_idx);
+
+      unsigned index = static_cast<unsigned>(-1);
+      enum cache_request_status probe_status = L1D->m_tag_array->probe(addr, index, mask, false, NULL);
+
+      const enum write_policy_t policy = L1D->m_config.get_write_policy();
+      const bool write_reaches_l2 = policy == WRITE_THROUGH || policy == WRITE_EVICT ||
+          (policy == LOCAL_WB_GLOBAL_WT && space.is_global()) ||
+          (probe_status != HIT && probe_status != HIT_RESERVED);
+      if (write_reaches_l2 && probe_status != RESERVATION_FAIL) {
+        check_and_apply_l2_bf(thread, addr, data, size, true, false, false, false);
+      }
+    }
+  }
