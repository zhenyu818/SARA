+// Read only actual assembled operands; never infer instruction semantics from
+// source text (one inline source line may contain many instructions).
+static std::string trace_full32_operands(const ptx_instruction *instruction) {
+  if (instruction->get_opcode() != SHFL_OP) return "null";
+  if (instruction->get_type() != B32_TYPE || instruction->get_scalar_type().size() != 1 ||
+      instruction->get_num_operands() != 5 || instruction->has_pred() ||
+      extract_opcode_token(instruction) != "shfl.sync.down.b32") return "null";
+  unsigned syncs = 0, downs = 0;
+  const std::list<int> options = instruction->get_options();
+  for (std::list<int>::const_iterator option = options.begin(); option != options.end(); ++option) {
+    if (*option == SYNC_OPTION) ++syncs;
+    else if (*option == DOWN_OPTION) ++downs;
+    else return "null";
+  }
+  if (syncs != 1 || downs != 1) return "null";
+  const operand_info &destination = instruction->dst();
+  if (destination.get_addr_space() != undefined_space || destination.get_operand_lohi() != 0 ||
+      destination.get_operand_neg() || destination.is_neg_pred()) return "null";
+  const symbol *data = NULL, *predicate = NULL;
+  if (destination.is_reg() && destination.get_double_operand_type() == 0)
+    data = destination.get_symbol();
+  else if (destination.is_vector() && destination.get_vect_nelem() == 2 && destination.get_double_operand_type() == -2) {
+    data = destination.vec_symbol(0); predicate = destination.vec_symbol(1);
+  } else return "null";
+  if (!data || !data->is_reg() || data->get_size_in_bytes() != 4 || !data->type() ||
+      data->type()->get_key().scalar_type() == PRED_TYPE ||
+      (predicate && (!predicate->is_reg() || !predicate->type() ||
+                     predicate->type()->get_key().scalar_type() != PRED_TYPE))) return "null";
+  const operand_info *sources[] = {&instruction->src1(), &instruction->src2(), &instruction->src3(), &instruction->src4()};
+  const char *roles[] = {"data", "b", "c", "membermask"};
+  std::ostringstream out;
+  out << "{\"schema\":\"sara-assembled-full32-operands-v1\",\"opcode\":\"shfl.sync.down.b32\",\"mode\":\"down\","
+      << "\"source_line_projection\":\"existing_ptx_ir_removes_tabs_v1\",\"assembled_source_line\":\""
+      << json_escape(instruction->get_source()) << "\",\"sources\":[";
+  for (unsigned source = 0; source < 4; ++source) {
+    const operand_info &operand = *sources[source];
+    if (operand.get_addr_space() != undefined_space || operand.get_operand_lohi() != 0 || operand.get_operand_neg() ||
+        operand.is_neg_pred() || operand.get_double_operand_type() != 0) return "null";
+    if (source) out << ',';
+    out << "{\"role\":\"" << roles[source] << "\",\"width_bits\":32";
+    if (operand.is_reg()) {
+      const symbol *reg = operand.get_symbol();
+      if (!reg || !reg->is_reg() || !reg->type() || reg->get_size_in_bytes() != 4 ||
+          reg->type()->get_key().scalar_type() == PRED_TYPE) return "null";
+      out << ",\"kind\":\"register\",\"name\":\"" << json_escape(reg->name()) << "\",\"register_uid\":" << reg->uid();
+    } else if (source && (operand.get_type() == int_t || operand.get_type() == unsigned_t)) {
+      out << ",\"kind\":\"literal\",\"value\":" << operand.get_literal_value().u32;
+    } else return "null";
+    out << '}';
+  }
+  out << "],\"destinations\":[{\"role\":\"data\",\"width_bits\":32,\"name\":\"" << json_escape(data->name())
+      << "\",\"register_uid\":" << data->uid() << '}';
+  if (predicate) out << ",{\"role\":\"in_range_predicate\",\"width_bits\":1,\"name\":\"" << json_escape(predicate->name())
+                     << "\",\"register_uid\":" << predicate->uid() << ",\"value_encoding\":\"gpgpu_sim_zero_flag\"}";
+  out << "]}";
+  return out.str();
+}
