+inline void mark_all(const tag_array *tags, unsigned count) {
+  sara_host_copy::collector *writer = sara_host_copy::get();
+  if (writer && writer->cache_state_enabled() && changed_slot_profile())
+    for (unsigned slot = 0; slot < count; ++slot) changed_slots()[tags].insert(slot);
