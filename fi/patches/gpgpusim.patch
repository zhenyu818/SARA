+#ifndef SARA_POPULATION_INVENTORY_H
+#define SARA_POPULATION_INVENTORY_H
+
+#include <stdint.h>
+#include <stdarg.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <zlib.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <limits>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace sara_population {
+
+inline std::string quote(const std::string &value) {
+  static const char *hex = "0123456789abcdef";
+  std::string result = "\"";
+  for (size_t i = 0; i < value.size(); ++i) {
+    const unsigned char byte = static_cast<unsigned char>(value[i]);
+    if (byte == '"' || byte == '\\') { result += '\\'; result += byte; }
+    else if (byte < 32) {
+      result += "\\u00"; result += hex[byte >> 4]; result += hex[byte & 15];
+    } else result += byte;
+  }
+  return result + '"';
+}
+
+struct member {
+  std::string key, body;
+  uint64_t bits;
+  bool rf;
+  member(const std::string &k, const std::string &b, uint64_t n, bool is_rf)
+      : key(k), body(b), bits(n), rf(is_rf) {}
+};
+
+// Contains only the current membership state. Closed spans stream to disk;
+// no future-consumer event is consulted and no full per-cycle dump is retained.
+class interval_stream {
+ public:
+  interval_stream() : file_(NULL), gzip_(NULL), seen_(false), finished_(false), compressed_mode_(false), compact_mode_(false),
+      component_filter_("all"), first_(0), last_(0), ticks_(0), zero_ticks_(0), rf_mass_(0), smem_mass_(0),
+      spans_(0), bytes_(0), active_rf_bits_(0), active_smem_bits_(0) {}
+  ~interval_stream() {
+    finish();
+    if (file_ && fclose(file_)) { perror("population close"); abort(); }
+    if (gzip_ && gzclose(gzip_) != Z_OK) { fprintf(stderr, "population gzip close failed\n"); abort(); }
+  }
+  bool enabled() const { return file_ != NULL || gzip_ != NULL; }
+  bool compact() const { return compact_mode_; }
+  bool includes_rf() const { return component_filter_ != "smem"; }
+  bool includes_smem() const { return component_filter_ != "rf"; }
+  void open(const char *path, const std::string &header_fields) {
+    if (enabled() || finished_) { fprintf(stderr, "population stream reopened\n"); abort(); }
+    const char *codec = getenv("SARA_POPULATION_CODEC");
+    if (codec && codec[0] && std::string(codec) != "plain" && std::string(codec) != "gzip") {
+      fprintf(stderr, "unsupported population codec\n"); abort();
+    }
+    compressed_mode_ = codec && std::string(codec) == "gzip";
+    const char *format = getenv("SARA_POPULATION_FORMAT");
+    if (format && format[0] && std::string(format) != "legacy-v1" && std::string(format) != "compact-v2") {
+      fprintf(stderr, "unsupported population format\n"); abort();
+    }
+    compact_mode_ = format && std::string(format) == "compact-v2";
+    if (compact_mode_) {
+      const char *component = getenv("SARA_POPULATION_COMPONENT");
+      component_filter_ = component && component[0] ? component : "all";
+      if (component_filter_ != "rf" && component_filter_ != "smem" && component_filter_ != "all") {
+        fprintf(stderr, "unsupported population component filter\n"); abort();
+      }
+    }
+    path_ = path;
+    if (compressed_mode_) {
+      const int descriptor = ::open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+      if (descriptor < 0) { perror("population gzip output"); abort(); }
+      gzip_ = gzdopen(descriptor, "wb1");
+      if (!gzip_) { ::close(descriptor); fprintf(stderr, "population gzdopen failed\n"); abort(); }
+    } else {
+      file_ = fopen(path, "wx");
+      if (!file_) { perror("population inventory output"); abort(); }
+    }
+    if (compact_mode_)
+      print("{\"kind\":\"header\",\"schema\":\"sara-allocated-population-compact-v2\",\"component_filter\":%s,%s}\n",
+            quote(component_filter_).c_str(), header_fields.c_str());
+    else
+      print( "{\"kind\":\"header\",\"schema\":\"sara-allocated-population-v1\",%s}\n", header_fields.c_str());
+  }
+  void block(const std::string &reason) {
+    if (blockers_.insert(reason).second)
+      print( "{\"kind\":\"blocker\",\"reason\":%s}\n", quote(reason).c_str());
+  }
+  void tick(uint64_t cycle, const std::vector<member> &members) {
+    advance_tick(cycle);
+    active_rf_bits_ = active_smem_bits_ = 0;
+    std::set<std::string> present;
+    for (size_t i = 0; i < members.size(); ++i) {
+      const member &item = members[i];
+      if ((item.rf && !includes_rf()) || (!item.rf && !includes_smem())) {
+        fprintf(stderr, "population component outside declared filter\n"); abort();
+      }
+      if (!present.insert(item.key).second) { fprintf(stderr, "duplicate population member key\n"); abort(); }
+      uint64_t &mass = item.rf ? rf_mass_ : smem_mass_;
+      if (item.bits > UINT64_MAX - mass) { fprintf(stderr, "population mass overflow\n"); abort(); }
+      mass += item.bits;
+      uint64_t &active_bits = item.rf ? active_rf_bits_ : active_smem_bits_;
+      if (item.bits > UINT64_MAX - active_bits) { fprintf(stderr, "population active mass overflow\n"); abort(); }
+      active_bits += item.bits;
+      std::map<std::string, active>::iterator old = active_.find(item.key);
+      if (old != active_.end() && old->second.body != item.body) {
+        close(old->second, cycle); active_.erase(old); old = active_.end();
+      }
+      if (old == active_.end()) active_[item.key] = active(cycle, item.body);
+    }
+    for (std::map<std::string, active>::iterator it = active_.begin(); it != active_.end();) {
+      if (!present.count(it->first)) { close(it->second, cycle); active_.erase(it++); }
+      else ++it;
+    }
+    if (members.empty()) ++zero_ticks_;
+  }
+  // Called only after all observer-relevant mutations were invalidated. It
+  // advances every real hook tick, including empty phases, without walking or
+  // comparing an unchanged directory and without reserializing descriptors.
+  void repeat_tick(uint64_t cycle) {
+    if (!seen_) { fprintf(stderr, "population repeat before directory\n"); abort(); }
+    advance_tick(cycle);
+    if (active_rf_bits_ > UINT64_MAX - rf_mass_ || active_smem_bits_ > UINT64_MAX - smem_mass_) {
+      fprintf(stderr, "population repeated mass overflow\n"); abort();
+    }
+    rf_mass_ += active_rf_bits_; smem_mass_ += active_smem_bits_;
+    if (active_.empty()) ++zero_ticks_;
+  }
+  void finish() {
+    if (!enabled() || finished_) return;
+    finished_ = true;
+    if (!seen_ || last_ == UINT64_MAX) { block("missing_or_overflowed_hook_window"); return; }
+    const uint64_t stop = last_ + 1;
+    for (std::map<std::string, active>::const_iterator it = active_.begin(); it != active_.end(); ++it)
+      close(it->second, stop);
+    active_.clear();
+    print( "{\"kind\":\"footer\",\"collection_closed\":true,\"first_cycle\":%llu,\"cycle_stop\":%llu,\"hook_ticks\":%llu,\"zero_member_ticks\":%llu,\"rf_bit_cycles\":%llu,\"smem_bit_cycles\":%llu,\"spans\":%llu,\"blocker_count\":%zu%s}\n",
+        number(first_), number(stop), number(ticks_), number(zero_ticks_), number(rf_mass_), number(smem_mass_), number(spans_), blockers_.size(),
+        compact_mode_ ? (",\"descriptors\":" + std::to_string(descriptors_.size())).c_str() : "");
+    if (compressed_mode_) {
+      gzFile compressed = gzip_; gzip_ = NULL;
+      if (gzclose(compressed) != Z_OK) { fprintf(stderr, "population gzip CRC/close failed\n"); abort(); }
+      FILE *receipt = fopen((path_ + ".storage.json").c_str(), "wx");
+      if (!receipt) { perror("population gzip storage receipt"); abort(); }
+      const int written = fprintf(receipt,
+          "{\"schema\":\"sara-population-storage-v1\",\"codec\":\"gzip\",\"uncompressed_bytes\":%llu,\"spans\":%llu,\"collection_closed\":true,\"close_succeeded\":true}\n",
+          number(bytes_), number(spans_));
+      const bool failed = written < 0 || fflush(receipt) || ferror(receipt);
+      const int closed = fclose(receipt);
+      if (failed || closed) { fprintf(stderr, "population gzip storage receipt failed\n"); abort(); }
+    } else if (fflush(file_) != 0 || ferror(file_)) { perror("population stream flush"); abort(); }
+  }
+
+ private:
+  struct active {
+    active() : start(0) {}
+    active(uint64_t cycle, const std::string &value) : start(cycle), body(value) {}
+    uint64_t start;
+    std::string body;
+  };
+  FILE *file_;
+  gzFile gzip_;
+  bool seen_, finished_, compressed_mode_, compact_mode_;
+  std::string component_filter_;
+  std::string path_;
+  uint64_t first_, last_, ticks_, zero_ticks_, rf_mass_, smem_mass_, spans_, bytes_;
+  uint64_t active_rf_bits_, active_smem_bits_;
+  std::map<std::string, active> active_;
+  std::set<std::string> blockers_;
+  std::map<std::string, uint64_t> descriptors_;
+  static unsigned long long number(uint64_t value) { return static_cast<unsigned long long>(value); }
+  void advance_tick(uint64_t cycle) {
+    if (!enabled() || finished_) { fprintf(stderr, "invalid population tick\n"); abort(); }
+    if (seen_ && (last_ == UINT64_MAX || cycle != last_ + 1)) block("noncontiguous_hook_cycles");
+    if (seen_ && cycle <= last_) { fprintf(stderr, "nonmonotonic population cycle\n"); abort(); }
+    if (!seen_) first_ = cycle;
+    seen_ = true; last_ = cycle;
+    if (ticks_ == UINT64_MAX) { fprintf(stderr, "population tick counter overflow\n"); abort(); }
+    ++ticks_;
+  }
+  void print(const char *format, ...) {
+    va_list arguments, length_arguments;
+    va_start(arguments, format);
+    if (!compressed_mode_) {
+      const int written = vfprintf(file_, format, arguments); va_end(arguments);
+      if (written < 0 || static_cast<uint64_t>(written) > UINT64_MAX - bytes_) {
+        fprintf(stderr, "population plain write/counter failed\n"); abort();
+      }
+      bytes_ += static_cast<uint64_t>(written); return;
+    }
+    va_copy(length_arguments, arguments);
+    const int length = vsnprintf(NULL, 0, format, length_arguments);
+    va_end(length_arguments);
+    if (length < 0 || length > 1024 * 1024 || static_cast<uint64_t>(length) > UINT64_MAX - bytes_) {
+      va_end(arguments); fprintf(stderr, "population output record/counter budget exceeded\n"); abort();
+    }
+    // Gzip is optional transport only. The JSON bytes and all selector epochs
+    // are identical. No logical span is merged, filtered or truncated here.
+    if (compressed_mode_ && bytes_ + length > 1024ULL * 1024 * 1024) {
+      va_end(arguments); fprintf(stderr, "population gzip decoded-byte budget exceeded\n"); abort();
+    }
+    std::vector<char> text(static_cast<size_t>(length) + 1);
+    if (vsnprintf(&text[0], text.size(), format, arguments) != length) {
+      va_end(arguments); fprintf(stderr, "population output formatting failed\n"); abort();
+    }
+    va_end(arguments);
+    if (compressed_mode_) {
+      if (gzwrite(gzip_, &text[0], static_cast<unsigned>(length)) != length) {
+        fprintf(stderr, "population gzip write failed\n"); abort();
+      }
+    } else if (fwrite(&text[0], 1, static_cast<size_t>(length), file_) != static_cast<size_t>(length)) {
+      perror("population write"); abort();
+    }
+    bytes_ += static_cast<uint64_t>(length);
+  }
+  void close(const active &item, uint64_t stop) {
+    if (stop <= item.start) { fprintf(stderr, "empty population interval\n"); abort(); }
+    if (compact_mode_) {
+      std::map<std::string, uint64_t>::iterator descriptor = descriptors_.find(item.body);
+      if (descriptor == descriptors_.end()) {
+        const uint64_t id = descriptors_.size();
+        descriptor = descriptors_.insert(std::make_pair(item.body, id)).first;
+        print("{\"kind\":\"descriptor\",\"id\":%llu,%s}\n", number(id), item.body.c_str());
+      }
+      print("{\"kind\":\"span\",\"descriptor\":%llu,\"cycle_start\":%llu,\"cycle_stop\":%llu}\n",
+            number(descriptor->second), number(item.start), number(stop));
+    } else
+      print( "{\"kind\":\"span\",\"cycle_start\":%llu,\"cycle_stop\":%llu,%s}\n",
+              number(item.start), number(stop), item.body.c_str());
+    ++spans_;
+  }
+};
+
+}  // namespace sara_population
+#endif
