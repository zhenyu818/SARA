+// Byte snapshots surround the original helper loop. They never create an
+// instruction event or alter its counter, and run only with the observer on.
+class observed_host_copy {
+ public:
+  observed_host_copy(gpgpu_t *gpu, memory_space *memory, const char *kind,
+      uint64_t src, uint64_t dst, size_t count, bool src_device, bool dst_device, uint64_t symbol_handle = 0, uint64_t symbol_offset = 0)
+      : observer_(sara_host_copy::get()), memory_(memory), source_(src), destination_(dst),
+        count_(count), source_device_(src_device), destination_device_(dst_device), kind_(kind) {
+    if (!observer_) return;
+    const gpgpu_sim *actual = gpu->gpgpu_ctx->the_gpgpusim->g_the_gpu;
+    token_ = observer_->copy_begin(kind, src, dst, count,
+        actual->gpu_sim_cycle + actual->gpu_tot_sim_cycle, sara_exact_trace_instruction_cursor(), symbol_handle, symbol_offset);
+    if (token_.capture) {
+      before_source_ = snapshot(src, src_device);
+      // Host output buffers need not be initialized. Never read their old bytes.
+      if (dst_device) before_destination_ = snapshot(dst, true);
+    }
+  }
+  void finish() {
+    if (!observer_) return;
+    const std::string after_source = token_.capture ? snapshot(source_, source_device_) : "";
+    const std::string after_destination = token_.capture ? snapshot(destination_, destination_device_) : "";
+    observer_->copy_end(token_, before_source_, before_destination_, after_source,
+                        after_destination, sara_exact_trace_instruction_cursor());
+  }
+ private:
+  std::string snapshot(uint64_t address, bool device) {
+    if (!device && kind_ == "memset") {
+      std::vector<unsigned char> bytes(count_, static_cast<unsigned char>(source_));
+      return sara_host_copy::hexbytes(&bytes[0], count_);
+    }
+    if (!device) return sara_host_copy::hexbytes(reinterpret_cast<const unsigned char *>(address), count_);
+    std::vector<unsigned char> bytes(count_); memory_->read(address, count_, &bytes[0]);
+    return sara_host_copy::hexbytes(&bytes[0], count_);
+  }
+  sara_host_copy::collector *observer_; memory_space *memory_; uint64_t source_, destination_; size_t count_;
+  bool source_device_, destination_device_; std::string kind_; sara_host_copy::copy_token token_;
+  std::string before_source_, before_destination_;
+};
