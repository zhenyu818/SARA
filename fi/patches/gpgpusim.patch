+#ifndef SARA_PTX_CARRY_OPS_H
+#define SARA_PTX_CARRY_OPS_H
+
+#include <cstdint>
+#include <stdexcept>
+
+namespace sara_ptx {
+
+// PTX add.cc/addc/sub.cc/subc use an implicit per-thread CC.CF.  Subtraction
+// stores borrow-out, not the PTXPlus predicate register's no-borrow flag.
+struct extended_result {
+  uint64_t bits;
+  bool cf;
+};
+
+inline uint64_t extended_mask(unsigned width) {
+  if (width != 32 && width != 64)
+    throw std::invalid_argument("PTX extended arithmetic requires 32 or 64 bits");
+  return width == 64 ? ~uint64_t(0) : (uint64_t(1) << 32) - 1;
+}
+
+inline extended_result extended_add(uint64_t a, uint64_t b, unsigned width,
+                                    bool carry_in) {
+  const uint64_t mask = extended_mask(width);
+  a &= mask;
+  b &= mask;
+  const uint64_t sum = (a + b) & mask;
+  const uint64_t result = (sum + uint64_t(carry_in)) & mask;
+  return extended_result{result, (sum < a) || (result < sum)};
+}
+
+inline extended_result extended_sub(uint64_t a, uint64_t b, unsigned width,
+                                    bool borrow_in) {
+  const uint64_t mask = extended_mask(width);
+  a &= mask;
+  b &= mask;
+  const uint64_t difference = (a - b) & mask;
+  const uint64_t result = (difference - uint64_t(borrow_in)) & mask;
+  return extended_result{result, (a < b) || (difference < uint64_t(borrow_in))};
+}
+
+class carry_flag {
+ public:
+  carry_flag() : m_valid(false), m_value(false) {}
+  bool valid() const { return m_valid; }
+  bool value() const {
+    if (!m_valid) throw std::logic_error("uninitialized PTX CC.CF");
+    return m_value;
+  }
+  void write(bool value) { m_value = value; m_valid = true; }
+  void invalidate() { m_valid = false; }
+
+  extended_result add(uint64_t a, uint64_t b, unsigned width,
+                      bool consume_cf, bool write_cf) {
+    const extended_result result = extended_add(a, b, width, consume_cf && value());
+    if (write_cf) write(result.cf);
+    return result;
+  }
+  extended_result sub(uint64_t a, uint64_t b, unsigned width,
+                      bool consume_cf, bool write_cf) {
+    const extended_result result = extended_sub(a, b, width, consume_cf && value());
+    if (write_cf) write(result.cf);
+    return result;
+  }
+
+ private:
+  bool m_valid;
+  bool m_value;
+};
+
+}  // namespace sara_ptx
+#endif
