+void read_colon_option(std::vector<unsigned> &result_vector, char *option) {
+  if (!option || !*option) return;
+  std::istringstream tokens(option);
+  std::string token;
+  while (std::getline(tokens, token, ':')) {
+    char *end = NULL;
+    errno = 0;
+    unsigned long value = strtoul(token.c_str(), &end, 0);
+    if (token.empty() || token[0] == '-' || errno || !end || *end || value > UINT_MAX) {
+      printf("GPUFI_FAULT status=rejected reason=malformed_option\n");
+      result_vector.clear();
+      return;
+    }
+    result_vector.push_back(static_cast<unsigned>(value));
+  }
+}
+
+unsigned first_colon_value(const char *option, unsigned fallback) {
+  if (option == NULL || option[0] == '\0') return fallback;
+  std::string raw(option);
+  size_t pos = raw.find(':');
+  std::string head = raw.substr(0, pos);
+  if (head.empty()) return fallback;
+  return (unsigned)strtoul(head.c_str(), NULL, 0);
+}
