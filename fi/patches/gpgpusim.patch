+#ifndef SARA_CACHE_VALID_RESIDENT_GUARD_H
+#define SARA_CACHE_VALID_RESIDENT_GUARD_H
+
+#include <ctype.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+#include "gpu-cache.h"
+#include "fault_bit_ops.h"
+
+// Opt-in admission for the separate current-valid-resident cohort.  This
+// observer never probes, changes cache state, chooses a prediction or searches
+// for a replacement point.  An empty option preserves the original FI path.
+namespace sara_valid_resident {
+inline void fail(const char *reason) {
+  fprintf(stderr, "GPUFI_INVALID_CONFIGURATION reason=valid_resident_%s\n", reason);
+  fflush(stderr); abort();
+}
+inline std::string decimal(uint64_t value) { std::ostringstream out; out << value; return out.str(); }
+inline bool hash64(const std::string &value) {
+  if (value.size() != 64) return false;
+  for (size_t i = 0; i < value.size(); ++i)
+    if (!((value[i] >= '0' && value[i] <= '9') || (value[i] >= 'a' && value[i] <= 'f'))) return false;
+  return true;
+}
+
+// The contract is a small, flat JSON object with ASCII identifier strings,
+// unsigned decimal scalars and unsigned arrays.  Reject duplicate/extra keys,
+// escapes, floats, signs, booleans, nested objects and trailing material.  A
+// general-purpose permissive JSON parser is unnecessary for this fixed API.
+class json_reader {
+ public:
+  struct value {
+    value() : type(0), number(0) {}
+    unsigned type; uint64_t number; std::string text; std::vector<uint64_t> array;
+  };
+  explicit json_reader(const std::string &input) : input_(input), position_(0) {
+    space(); token('{'); space();
+    if (peek() == '}') fail("empty_contract");
+    while (true) {
+      std::string key = string(); space(); token(':'); space(); value item;
+      if (peek() == '"') { item.type = 1; item.text = string(); }
+      else if (peek() == '[') {
+        item.type = 2; token('['); space();
+        if (peek() == ']') fail("empty_array");
+        while (true) {
+          if (item.array.size() >= 4) fail("oversized_array");
+          item.array.push_back(number()); space();
+          if (peek() == ']') { token(']'); break; }
+          token(','); space();
+        }
+      } else { item.type = 0; item.number = number(); }
+      if (!fields_.insert(std::make_pair(key, item)).second) fail("duplicate_contract_key");
+      space();
+      if (peek() == '}') { token('}'); break; }
+      token(','); space();
+    }
+    space(); if (position_ != input_.size()) fail("contract_trailing_material");
+  }
+  uint64_t take_number(const char *name) { value item = take(name); if (item.type != 0) fail("contract_number_type"); return item.number; }
+  std::string take_string(const char *name) { value item = take(name); if (item.type != 1) fail("contract_string_type"); return item.text; }
+  std::vector<uint64_t> take_array(const char *name) { value item = take(name); if (item.type != 2) fail("contract_array_type"); return item.array; }
+  void complete() { if (!fields_.empty()) fail("unexpected_contract_key"); }
+ private:
+  char peek() const { return position_ < input_.size() ? input_[position_] : '\0'; }
+  void space() { while (position_ < input_.size() && isspace(static_cast<unsigned char>(input_[position_]))) ++position_; }
+  void token(char expected) { if (peek() != expected) fail("contract_json_syntax"); ++position_; }
+  std::string string() {
+    space(); token('"'); std::string result;
+    while (peek() && peek() != '"') {
+      const unsigned char c = static_cast<unsigned char>(peek());
+      if (!(isalnum(c) || c == '_' || c == '-' || c == '.' || c == ':' || c == '/')) fail("contract_identifier");
+      result.push_back(peek()); ++position_;
+      if (result.size() > 128) fail("contract_identifier_length");
+    }
+    token('"'); return result;
+  }
+  uint64_t number() {
+    if (peek() < '0' || peek() > '9') fail("contract_unsigned_decimal");
+    if (peek() == '0' && position_+1 < input_.size() && input_[position_+1] >= '0' && input_[position_+1] <= '9')
+      fail("contract_leading_zero");
+    uint64_t result = 0;
+    while (peek() >= '0' && peek() <= '9') {
+      const unsigned digit = peek() - '0';
+      if (result > (UINT64_MAX - digit) / 10) fail("contract_integer_overflow");
+      result = result * 10 + digit; ++position_;
+    }
+    return result;
+  }
+  value take(const char *name) {
+    std::map<std::string, value>::iterator found = fields_.find(name);
+    if (found == fields_.end()) fail("missing_contract_key");
+    value result = found->second; fields_.erase(found); return result;
+  }
+  const std::string &input_; size_t position_; std::map<std::string, value> fields_;
+};
+
+class guard {
+ public:
+  guard() : enabled_(false), verified_(false), cycle_(0), bit_(0), scope_(0), cluster_(0), core_(0),
+      line_(0), active_lines_(0), allocated_(0), bytes_(0), type_(0), instance_(0), epoch_(0),
+      version_(0), block_(0), tag_(0) {}
+  void configure(const char *path, unsigned profile, bool probe, uint64_t selected_cycle,
+      const char *components, const char *l1_bits, const char *l2_bits,
+      const char *l1_shaders, const char *kernel) {
+    if (!path || !*path) return;
+    if (enabled_) fail("contract_configured_twice");
+    FILE *file = fopen(path, "rb"); if (!file) fail("contract_open");
+    char buffer[16385]; const size_t size = fread(buffer, 1, sizeof(buffer), file);
+    const bool io_error = ferror(file); const int closed = fclose(file);
+    if (io_error || closed || size == 0 || size > 16384) fail("contract_size_or_read");
+    const std::string input(buffer, size); json_reader reader(input);
+    if (reader.take_string("schema") != "sara-cache-valid-resident-site-v1") fail("contract_schema");
+    component_ = reader.take_string("component"); kind_ = reader.take_string("kind");
+    population_ = reader.take_string("population_fingerprint"); id_ = reader.take_string("contract_id");
+    if (!hash64(population_) || !hash64(id_)) fail("contract_digest_shape");
+    cycle_ = reader.take_number("cycle"); bit_ = reader.take_number("bit");
+    scope_ = reader.take_number("scope"); cluster_ = reader.take_number("cluster"); core_ = reader.take_number("core");
+    line_ = reader.take_number("line"); active_lines_ = reader.take_number("active_lines");
+    allocated_ = reader.take_number("actual_allocated_lines"); bytes_ = reader.take_number("line_bytes");
+    type_ = reader.take_number("cache_type"); instance_ = reader.take_number("cache_instance");
+    epoch_ = reader.take_number("geometry_epoch"); version_ = reader.take_number("allocation_version");
+    block_ = reader.take_number("block"); tag_ = reader.take_number("tag");
+    if (reader.take_number("tag_bits") != 57) fail("contract_tag_width");
+    status_ = reader.take_array("sector_status"); readable_ = reader.take_array("sector_readable"); reader.complete();
+    const unsigned count = type_ == 0 ? 1 : type_ == 1 ? SECTOR_CHUNCK_SIZE : 0;
+    if (!count || !bytes_ || bytes_ % count || !active_lines_ || active_lines_ > allocated_ || line_ >= active_lines_
+        || !instance_ || !epoch_ || !version_ || status_.size() != count || readable_.size() != count
+        || cycle_ > UINT32_MAX || !bit_ || bit_ > UINT32_MAX || scope_ > UINT32_MAX || cluster_ > UINT32_MAX
+        || core_ > UINT32_MAX || active_lines_ > UINT32_MAX || bytes_ > UINT32_MAX / 8)
+      fail("contract_geometry");
+    bool any_valid = false;
+    for (unsigned sector = 0; sector < count; ++sector) {
+      if (status_[sector] > 3 || readable_[sector] > 1) fail("contract_sector_state");
+      any_valid = any_valid || valid(status_[sector]);
+    }
+    if (component_ != "l1d" && component_ != "l2") fail("contract_component");
+    if (kind_ != "tag" && kind_ != "data") fail("contract_kind");
+    if (component_ == "l2" && (cluster_ || core_)) fail("contract_L2_scope");
+    const uint64_t line_bits = 57 + bytes_ * 8;
+    if (component_ == "l2" && scope_ > (UINT64_MAX-line_)/active_lines_) fail("contract_coordinate_overflow");
+    const uint64_t slot = component_ == "l1d" ? line_ : scope_*active_lines_+line_;
+    if (slot > UINT64_MAX / line_bits || bit_-1 < slot*line_bits || bit_-1-slot*line_bits >= line_bits)
+      fail("contract_bit_coordinate");
+    const uint64_t inside = bit_-1-slot*line_bits;
+    if (kind_ == "tag") { if (inside >= 57 || !any_valid) fail("contract_tag_not_valid"); }
+    else if (inside < 57 || !valid(status_[(inside-57)/(bytes_*8/count)])) fail("contract_data_not_valid");
+    const char *selected_bits = component_ == "l1d" ? l1_bits : l2_bits;
+    if (profile != 0 || probe || selected_cycle != cycle_ || !components || !selected_bits || !kernel
+        || std::string(kernel) != "0" || std::string(components) != (component_ == "l1d" ? "3" : "6")
+        || std::string(selected_bits) != decimal(bit_)
+        || (component_ == "l1d" && (!l1_shaders || std::string(l1_shaders) != decimal(scope_))))
+      fail("contract_dispatch_options");
+    enabled_ = true;
+  }
+
+  bool enabled() const { return enabled_; }
+  void pre_flip(const char *component, uint64_t cycle, uint64_t scope, uint64_t cluster, uint64_t core,
+      tag_array *tags, const cache_config &cfg, unsigned line_index, uint64_t option_bit,
+      const sara_fault::cache_bit &location) {
+    if (!enabled_) return;
+    if (verified_) fail("multiple_flip_attempts");
+    if (!component || component_ != component || cycle != cycle_ || scope != scope_ || cluster != cluster_
+        || core != core_ || line_index != line_ || option_bit != bit_ || location.line != line_
+        || location.is_tag != (kind_ == "tag") || !tags) fail("preflip_point_identity");
+    const uint64_t inside = (bit_-1) % (57+bytes_*8);
+    if (location.bit != (location.is_tag ? 63-inside : inside-57)) fail("preflip_decoded_bit");
+    tags->fault_check_allocation(); const sara_cache::allocation_shape &allocation = tags->actual_allocation();
+    const std::map<const void *, sara_fault::tag_cache_owner> &owners = sara_fault::tag_cache_owners();
+    std::map<const void *, sara_fault::tag_cache_owner>::const_iterator owner = owners.find(tags);
+    if (owner == owners.end() || !(owner->second.geometry == cfg.fault_tag_geometry())
+        || owner->second.instance != instance_ || owner->second.epoch != epoch_
+        || cfg.get_num_lines() != active_lines_ || allocation.lines != allocated_
+        || cfg.get_line_sz() != bytes_ || allocation.line_bytes != bytes_ || allocation.cache_type != type_)
+      fail("preflip_geometry_or_epoch");
+    cache_block_t *line = tags->get_block(line_index);
+    if (line->m_fault_overlay.version() != version_ || line->m_block_addr != block_ || line->m_tag != tag_)
+      fail("preflip_copy_version_or_tag");
+    bool any_valid = false;
+    for (unsigned sector = 0; sector < status_.size(); ++sector) {
+      mem_access_sector_mask_t mask; mask.set(sector);
+      const unsigned status = line->get_status(mask); const bool readable = line->is_readable(mask);
+      if (status != status_[sector] || static_cast<unsigned>(readable) != readable_[sector]) fail("preflip_sector_state");
+      any_valid = any_valid || valid(status);
+    }
+    if (location.is_tag) { if (!any_valid) fail("preflip_tag_not_valid"); }
+    else {
+      const unsigned sector = location.bit / (bytes_*8/status_.size());
+      if (sector >= status_.size() || !valid(status_[sector])) fail("preflip_data_not_valid");
+    }
+    // A separate receipt avoids manufacturing an additional fault ACK.  The
+    // ordinary subsequent TAG/DATA ACK must still prove the requested flip.
+    std::ostringstream statuses, readable;
+    for (unsigned sector = 0; sector < status_.size(); ++sector) {
+      if (sector) { statuses << ','; readable << ','; }
+      statuses << status_[sector]; readable << readable_[sector];
+    }
+    printf("GPUFI_VALID_RESIDENT status=verified schema=sara-cache-valid-resident-site-v1 contract_id=%s "
+           "population_fingerprint=%s component=%s kind=%s cycle=%llu bit=%llu scope=%llu cluster=%llu core=%llu "
+           "line=%llu active_lines=%llu actual_allocated_lines=%llu line_bytes=%llu cache_type=%llu tag_bits=57 "
+           "cache_instance=%llu geometry_epoch=%llu allocation_version=%llu block=%llu tag=%llu sector_status=%s sector_readable=%s\n",
+           id_.c_str(), population_.c_str(), component_.c_str(), kind_.c_str(),
+           static_cast<unsigned long long>(cycle_), static_cast<unsigned long long>(bit_),
+           static_cast<unsigned long long>(scope_), static_cast<unsigned long long>(cluster_), static_cast<unsigned long long>(core_),
+           static_cast<unsigned long long>(line_), static_cast<unsigned long long>(active_lines_), static_cast<unsigned long long>(allocated_),
+           static_cast<unsigned long long>(bytes_), static_cast<unsigned long long>(type_), static_cast<unsigned long long>(instance_),
+           static_cast<unsigned long long>(epoch_), static_cast<unsigned long long>(version_), static_cast<unsigned long long>(block_),
+           static_cast<unsigned long long>(tag_), statuses.str().c_str(), readable.str().c_str());
+    fflush(stdout); verified_ = true;
+  }
+  void finish_cycle(uint64_t cycle) const {
+    if (enabled_ && cycle >= cycle_ && !verified_) fail("selected_hook_not_verified");
+  }
+ private:
+  static bool valid(unsigned status) { return status == VALID || status == MODIFIED; }
+  bool enabled_, verified_;
+  std::string component_, kind_, population_, id_;
+  uint64_t cycle_, bit_, scope_, cluster_, core_, line_, active_lines_, allocated_, bytes_, type_,
+      instance_, epoch_, version_, block_, tag_;
+  std::vector<uint64_t> status_, readable_;
+};
+inline guard &selected() { static guard instance; return instance; }
+}  // namespace sara_valid_resident
+#endif
