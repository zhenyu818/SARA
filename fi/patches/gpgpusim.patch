+static std::string json_escape(const std::string &in) {
+  std::ostringstream os;
+  for (size_t i = 0; i < in.size(); ++i) {
+    const unsigned char c = static_cast<unsigned char>(in[i]);
+    switch (c) {
+      case '\\':
+        os << "\\\\";
+        break;
+      case '"':
+        os << "\\\"";
+        break;
+      case '\b':
+        os << "\\b";
+        break;
+      case '\f':
+        os << "\\f";
+        break;
+      case '\n':
+        os << "\\n";
+        break;
+      case '\r':
+        os << "\\r";
+        break;
+      case '\t':
+        os << "\\t";
+        break;
+      default:
+        if (c < 0x20) {
+          char buf[7];
+          snprintf(buf, sizeof(buf), "\\u%04x", static_cast<unsigned>(c));
+          os << buf;
+        } else {
+          os << static_cast<char>(c);
+        }
+        break;
+    }
+  }
+  return os.str();
+}
+
+static std::string hex_u64(unsigned long long v) {
+  char buf[32];
+  snprintf(buf, sizeof(buf), "0x%016llx", v);
+  return std::string(buf);
+}
+
+static std::string hex_u32(unsigned v) {
+  char buf[32];
+  snprintf(buf, sizeof(buf), "0x%08x", v);
+  return std::string(buf);
+}
+
+static int clamp_width_bits(int width_bits) {
+  if (width_bits <= 0) return 1;
+  if (width_bits > 64) return 64;
+  return width_bits;
+}
