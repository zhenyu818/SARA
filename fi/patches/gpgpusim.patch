+namespace {
+
+struct exact_memory_range_entry {
+  unsigned long long base;
+  size_t size;
+  unsigned long long start_cycle;
+  bool has_end_cycle;
+  unsigned long long end_cycle;
+};
+
+typedef std::vector<exact_memory_range_entry> exact_memory_range_list_t;
+
+static sara_host_copy::collector *host_copy_observer(CUctx_st *context) {
+  if (!context || !context->get_device()) return NULL;
+  gpgpu_sim *gpu = context->get_device()->get_gpgpu();
+  if (!gpu) return NULL;
+  const gpgpu_functional_sim_config &cfg = gpu->get_config();
+  sara_host_copy::configure(cfg.host_copy_ledger_file(), cfg.exact_trace_file(), cfg.exact_trace_enabled(), cfg.exact_trace_jsonl(), cfg.host_copy_ledger_budget_bytes(), cfg.cache_state_ledger());
+  return sara_host_copy::get();
+}
+static uint64_t begin_host_copy(gpgpu_context *ctx, const char *api, void *dst, const void *src,
+                               size_t count, cudaMemcpyKind kind, CUstream_st *stream) {
+  sara_host_copy::collector *observer = host_copy_observer(GPGPUSim_Context(ctx));
+  if (!observer) return 0;
+  std::string observed_kind;
+  if (kind == cudaMemcpyHostToDevice) observed_kind = "h2d";
+  else if (kind == cudaMemcpyDeviceToHost) observed_kind = "d2h";
+  else if (kind == cudaMemcpyDeviceToDevice) observed_kind = "d2d";
+  else if (kind == cudaMemcpyDefault) observed_kind = (size_t)src >= GLOBAL_HEAP_START ?
+      ((size_t)dst >= GLOBAL_HEAP_START ? "d2d" : "d2h") : "h2d";
+  else observed_kind = "unsupported";
+  return observer->api_begin(api, observed_kind, (size_t)src, (size_t)dst, count,
+                            stream == NULL, stream ? stream->get_uid() : 0, sara_exact_trace_instruction_cursor());
+}
+static void finish_host_copy(uint64_t id) {
+  sara_host_copy::collector *observer = sara_host_copy::get();
+  if (observer && id) observer->api_return(id, 0, sara_exact_trace_instruction_cursor());
+}
+
+static std::map<std::string, exact_memory_range_list_t>
+    g_exact_trace_memory_ranges;
+static std::map<std::string, std::map<unsigned long long, size_t> >
+    g_exact_trace_open_ranges;
+static std::map<std::string, unsigned long long> g_exact_trace_shared_limits;
+
+static std::string exact_hex_u64(unsigned long long v) {
+  char buf[32];
+  snprintf(buf, sizeof(buf), "0x%016llx", v);
+  return std::string(buf);
+}
+
+static unsigned long long exact_trace_cycle(CUctx_st *context) {
+  if (context == NULL || context->get_device() == NULL) return 0;
+  gpgpu_sim *gpu = context->get_device()->get_gpgpu();
+  if (gpu == NULL) return 0;
+  return gpu->gpu_sim_cycle + gpu->gpu_tot_sim_cycle;
+}
+
+static unsigned long long exact_trace_shared_mem_limit(CUctx_st *context) {
+  if (context == NULL || context->get_device() == NULL) return 0;
+  gpgpu_sim *gpu = context->get_device()->get_gpgpu();
+  if (gpu == NULL) return 0;
+  const int per_block = gpu->shared_mem_per_block();
+  if (per_block <= 0) return 0;
+  return (unsigned long long)per_block;
+}
+
+static bool exact_trace_sidecar_path(CUctx_st *context, std::string &trace_key,
+                                     std::string &sidecar_path) {
+  if (context == NULL || context->get_device() == NULL) return false;
+  gpgpu_sim *gpu = context->get_device()->get_gpgpu();
+  if (gpu == NULL) return false;
+
+  const gpgpu_functional_sim_config &cfg = gpu->get_config();
+  if (!cfg.exact_trace_enabled()) return false;
+
+  const char *trace_file = cfg.exact_trace_file();
+  if (trace_file == NULL || !trace_file[0]) return false;
+
+  trace_key = std::string(trace_file);
+  sidecar_path = trace_key + ".memory_ranges.json";
+  return true;
+}
+
+static void exact_trace_write_sidecar(const std::string &trace_key,
+                                      const std::string &sidecar_path,
+                                      const exact_memory_range_list_t &ranges) {
+  FILE *fp = fopen(sidecar_path.c_str(), "w");
+  if (!fp) {
+    fprintf(stderr,
+            "GPGPU-Sim: failed to open exact memory-range sidecar '%s'\n",
+            sidecar_path.c_str());
+    return;
+  }
+
+  fputs("{\n  \"memory_ranges\": [\n", fp);
+  bool first = true;
+  for (size_t i = 0; i < ranges.size(); ++i) {
+    const exact_memory_range_entry &r = ranges[i];
+    if (!first) fputs(",\n", fp);
+    first = false;
+    const std::string base_hex = exact_hex_u64(r.base);
+    fprintf(fp,
+            "    {\"space\":\"global\",\"base\":\"%s\",\"size\":%llu,"
+            "\"start_cycle\":%llu",
+            base_hex.c_str(), (unsigned long long)r.size, r.start_cycle);
+    if (r.has_end_cycle) {
+      fprintf(fp, ",\"end_cycle\":%llu", r.end_cycle);
+    }
+    fputs("}", fp);
+  }
+
+  std::map<std::string, unsigned long long>::const_iterator it_shared =
+      g_exact_trace_shared_limits.find(trace_key);
+  if (it_shared != g_exact_trace_shared_limits.end() && it_shared->second > 0) {
+    if (!first) fputs(",\n", fp);
+    fprintf(
+        fp,
+        "    {\"space\":\"shared\",\"base\":\"0x0000000000000000\",\"size\":%llu}",
+        it_shared->second);
+  }
+
+  fputs("\n  ]\n}\n", fp);
+  fclose(fp);
+}
+
+static void exact_trace_log_malloc(CUctx_st *context, void *dev_ptr,
+                                   size_t size, const char *allocator = "unclassified_allocator") {
+  if (dev_ptr == NULL || size == 0) return;
+  sara_host_copy::collector *observer = host_copy_observer(context);
+  if (observer) observer->allocate((size_t)dev_ptr, size, allocator, sara_exact_trace_instruction_cursor());
+
+  std::string trace_key;
+  std::string sidecar_path;
+  if (!exact_trace_sidecar_path(context, trace_key, sidecar_path)) return;
+
+  exact_memory_range_list_t &ranges = g_exact_trace_memory_ranges[trace_key];
+  std::map<unsigned long long, size_t> &open =
+      g_exact_trace_open_ranges[trace_key];
+
+  const unsigned long long base = (unsigned long long)dev_ptr;
+  const unsigned long long cycle = exact_trace_cycle(context);
+  const unsigned long long shared_limit = exact_trace_shared_mem_limit(context);
+  if (shared_limit > 0) {
+    g_exact_trace_shared_limits[trace_key] = shared_limit;
+  }
+
+  std::map<unsigned long long, size_t>::iterator it = open.find(base);
+  if (it != open.end()) {
+    const size_t old_index = it->second;
+    if (old_index < ranges.size()) {
+      exact_memory_range_entry &old = ranges[old_index];
+      if (!old.has_end_cycle) {
+        old.has_end_cycle = true;
+        old.end_cycle = cycle;
+      }
+    }
+    open.erase(it);
+  }
+
+  exact_memory_range_entry entry;
+  entry.base = base;
+  entry.size = size;
+  entry.start_cycle = cycle;
+  entry.has_end_cycle = false;
+  entry.end_cycle = 0;
+  ranges.push_back(entry);
+  open[base] = ranges.size() - 1;
+  exact_trace_write_sidecar(trace_key, sidecar_path, ranges);
+}
+
+static void exact_trace_log_free(CUctx_st *context, void *dev_ptr, const char *allocator = "unclassified_allocator") {
+  if (dev_ptr == NULL) return;
+  sara_host_copy::collector *observer = host_copy_observer(context);
+  if (observer) observer->release((size_t)dev_ptr, allocator, sara_exact_trace_instruction_cursor());
+
+  std::string trace_key;
+  std::string sidecar_path;
+  if (!exact_trace_sidecar_path(context, trace_key, sidecar_path)) return;
+
+  exact_memory_range_list_t &ranges = g_exact_trace_memory_ranges[trace_key];
+  std::map<unsigned long long, size_t> &open =
+      g_exact_trace_open_ranges[trace_key];
+
+  const unsigned long long base = (unsigned long long)dev_ptr;
+  const unsigned long long cycle = exact_trace_cycle(context);
+  const unsigned long long shared_limit = exact_trace_shared_mem_limit(context);
+  if (shared_limit > 0) {
+    g_exact_trace_shared_limits[trace_key] = shared_limit;
+  }
+  std::map<unsigned long long, size_t>::iterator it = open.find(base);
+  if (it == open.end()) return;
+
+  const size_t index = it->second;
+  if (index < ranges.size()) {
+    exact_memory_range_entry &entry = ranges[index];
+    if (!entry.has_end_cycle) {
+      entry.has_end_cycle = true;
+      entry.end_cycle = cycle;
+    }
+  }
+  open.erase(it);
+  exact_trace_write_sidecar(trace_key, sidecar_path, ranges);
+}
