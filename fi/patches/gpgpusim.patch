+    TRACE_TYPE(F64_TYPE, "f64") TRACE_TYPE(FF64_TYPE, "ff64")
+    TRACE_TYPE(PRED_TYPE, "pred") TRACE_TYPE(TEXREF_TYPE, "texref")
+    TRACE_TYPE(SAMPLERREF_TYPE, "samplerref") TRACE_TYPE(SURFREF_TYPE, "surfref")
+    default: return "unsupported_type_" + std::to_string(type);
+  }
+#undef TRACE_TYPE
+}
+
+static std::string extract_opcode_token(const ptx_instruction *pI) {
+  // Source lines can contain an entire inline-PTX block. They do not identify
+  // the instruction at this PC and must never be used to infer its semantics.
+  sara_ptx::trace_opcode_fields fields;
+  fields.base = pI->get_opcode_cstr();
+  fields.is_volatile = pI->trace_is_volatile();
+  const memory_space_t space = pI->get_space();
+  switch (space.get_type()) {
+    case undefined_space: case generic_space: break;
+    case global_space: fields.space = "global"; break;
+    case shared_space: fields.space = "shared"; break;
+    case local_space: fields.space = "local"; break;
+    case const_space:
+      fields.space = space.get_bank() == 0 ? "const" : "unsupported_const_bank_" + std::to_string(space.get_bank());
+      break;
+    case param_space_unclassified: case param_space_kernel: case param_space_local:
+      fields.space = "param"; break;
+    default: fields.space = "unsupported_space_" + std::to_string(space.get_type());
+  }
+  const std::list<int> options = pI->get_options();
+  for (std::list<int>::const_iterator it = options.begin(); it != options.end(); ++it)
+    fields.options.push_back(trace_option_token(*it));
+  if (pI->trace_vector_spec() >= 0)
+    fields.options.push_back(trace_option_token(pI->trace_vector_spec()));
+  const std::list<int> wmma = pI->get_wmma_options();
+  for (std::list<int>::const_iterator it = wmma.begin(); it != wmma.end(); ++it)
+    fields.options.push_back("unsupported_wmma_option_" + std::to_string(*it));
+  const std::list<int> types = pI->get_scalar_type();
+  for (std::list<int>::const_iterator it = types.begin(); it != types.end(); ++it)
+    fields.types.push_back(trace_type_token(*it));
+  return sara_ptx::structured_trace_opcode(fields);
+}
+
+static const char *space_to_string(const memory_space_t &space) {
+  switch (space.get_type()) {
+    case global_space:
+      return "global";
+    case local_space:
+      return "local";
+    case shared_space:
+      return "shared";
+    case const_space:
+      return "const";
+    case tex_space:
+      return "tex";
+    case surf_space:
+      return "surf";
+    case param_space_local:
+      return "param_local";
+    case param_space_kernel:
+      return "param_kernel";
+    case param_space_unclassified:
+      return "param";
+    case undefined_space:
+    default:
+      return "undefined";
+  }
+}
+
+class exact_trace_writer {
+ public:
+  exact_trace_writer()
+      : m_fp(NULL), m_enabled(false), m_jsonl(false), m_first_event(true),
+        m_closed(false), m_static_cfg_enabled(false), m_gzip_enabled(false) {}
+
+  void log(const gpgpu_functional_sim_config &cfg,
+           const std::string &json_event, ptx_thread_info &thread, addr_t pc,
+           const function_info *executed_function) {
+    if (!cfg.exact_trace_enabled()) return;
+    std::lock_guard<std::mutex> lock(m_lock);
+    if (m_closed) fail("instruction arrived after trace close");
+    if (!m_enabled) init(cfg);
+    if (!m_enabled) fail("exact tracing requested without an open output");
+    if (m_static_cfg_enabled != cfg.exact_trace_static_cfg()) fail("static CFG mode changed during capture");
+    if (m_static_cfg_enabled) {
+      if (executed_function == NULL) fail("missing actual executed function for static CFG");
+      const std::pair<unsigned, addr_t> key(thread.get_kernel().get_uid(), executed_function->get_start_PC());
+      if (!m_static_cfg.count(key)) m_static_cfg[key] = executed_function->trace_static_cfg_metadata();
+    }
+    if (thread.trace_attempt_overflow()) fail("thread attempt counter overflow");
+    const uint64_t ordinal = thread.get_trace_attempt_count();
+    if (!ordinal || json_event.empty() || json_event[0] != '{')
+      fail("invalid instruction event/counter");
+    const unsigned uid = thread.get_uid();
+    if (!uid) fail("invalid thread identity");
+    thread_summary &summary = m_threads[uid];
+    if (!summary.events) {
+      summary.kernel = thread.get_kernel().get_uid();
+      summary.thread = uid;
+      summary.cta = thread.get_ctaid();
+      summary.tid = thread.get_tid();
+      summary.first_pc = pc;
+      summary.entry_pc = thread.get_kernel().entry()->get_start_PC();
+      kernel_summary &kernel = m_kernels[summary.kernel];
+      if (!kernel.uid) {
+        kernel.uid = summary.kernel;
+        kernel.grid = thread.get_kernel().get_grid_dim();
+        kernel.block = thread.get_kernel().get_cta_dim();
+        kernel.entry_pc = summary.entry_pc;
+      }
+    }
+    if (summary.completed || ordinal != summary.events + 1 ||
+        summary.kernel != thread.get_kernel().get_uid() ||
+        !same_dim(summary.cta, thread.get_ctaid()) ||
+        !same_dim(summary.tid, thread.get_tid()))
+      fail("non-contiguous thread instruction capture");
+    m_global.next();
+    if (m_global.overflow) fail("global event ordinal overflow");
+    ++summary.events;
+    summary.last_pc = pc;
+    summary.last_attempt = ordinal;
+    if (thread.is_done()) {
+      summary.completed = true;
+      // Read the independently incremented execution counter at termination;
+      // never infer it from the number of successfully serialized events.
+      summary.terminal_attempt = thread.get_trace_attempt_count();
+    }
+    std::ostringstream prefix;
+    prefix << "{\"event_ordinal\":" << m_global.value
+           << ",\"thread_instruction_ordinal\":" << ordinal << ",";
+    if (!m_jsonl && !m_first_event) write(",\n");
+    write(prefix.str());
+    write(json_event.substr(1));
+    if (m_jsonl) write("\n");
+    m_first_event = false;
+  }
+
+  void kernel_completed(kernel_info_t &kernel) {
+    std::lock_guard<std::mutex> lock(m_lock);
+    if (!output_open()) return;  // No events means no completeness certificate.
+    std::map<unsigned, kernel_summary>::iterator found = m_kernels.find(kernel.get_uid());
+    if (found == m_kernels.end() || found->second.completed || !kernel.is_finished())
+      fail("kernel completion notification inconsistent with capture");
+    kernel_summary &summary = found->second;
+    if (!same_dim(summary.grid, kernel.get_grid_dim()) ||
+        !same_dim(summary.block, kernel.get_cta_dim()))
+      fail("kernel geometry changed during capture");
+    const uint64_t expected = geometry_count(summary.grid, summary.block);
+    uint64_t actual = 0;
+    std::set<std::string> logical_threads;
+    for (std::map<unsigned, thread_summary>::const_iterator it = m_threads.begin();
+         it != m_threads.end(); ++it) {
+      const thread_summary &thread = it->second;
+      if (thread.kernel != summary.uid) continue;
+      if (!thread.completed || thread.terminal_attempt != thread.events ||
+          thread.last_attempt != thread.terminal_attempt || thread.first_pc != summary.entry_pc ||
+          !inside(thread.cta, summary.grid) || !inside(thread.tid, summary.block))
+        fail("finished kernel lacks complete terminal thread capture");
+      std::ostringstream identity;
+      identity << thread.cta.x << ',' << thread.cta.y << ',' << thread.cta.z << ':'
+               << thread.tid.x << ',' << thread.tid.y << ',' << thread.tid.z;
+      if (!logical_threads.insert(identity.str()).second)
+        fail("duplicate logical thread in completed kernel");
+      ++actual;
+    }
+    if (!expected || actual != expected) fail("completed kernel thread geometry is incomplete");
+    summary.expected_threads = expected;
+    summary.completed = true;
+    flush_output("kernel trace flush failed");
+  }
+
+  uint64_t instruction_cursor() {
+    std::lock_guard<std::mutex> lock(m_lock);
+    return m_global.value;
+  }
+
+  void close() {
+    std::lock_guard<std::mutex> lock(m_lock);
+    if (!output_open()) {
+      // Explicit value-free storage EFM collection does not create an exact
+      // instruction trace. Preserve the same drained API/kernel lifetime seal.
+      sara_host_copy::collector *observer = sara_host_copy::get();
+      if (observer && observer->needs_standalone_close()) {
+        sara_host_copy::seal();
+        sara_host_copy::finish("", 0, 0);
+      }
+      return;
+    }
+    const std::string footer = capture_footer();
+    // Lock order is raw writer -> ledger, never the reverse. Seal only here,
+    // after all normal API returns; kernel_completed() never closes the ledger.
+    const std::string host_checkpoint = sara_host_copy::seal();
+    if (!m_jsonl) write("\n  ],\n  \"capture_footer\":" + footer +
+        (host_checkpoint == "null" ? "" : ",\n  \"host_copy_checkpoint\":" + host_checkpoint) + "\n}\n");
+    flush_output("trace flush/fsync failed");
+    if (m_gzip_enabled) {
+      try { m_gzip.close(); } catch (const std::exception &error) { fail(error.what()); }
+    } else {
+      FILE *closing = m_fp;
+      m_fp = NULL;
+      if (fclose(closing) != 0) fail("trace fclose failed");
+    }
+    m_enabled = false;
+    m_closed = true;
+    if (m_hash.overflow() || m_hash.hex_digest().empty()) fail("trace hash length overflow");
+    const std::string host_binding = sara_host_copy::finish(m_hash.hex_digest(), m_hash.bytes(), m_global.value);
+    std::ostringstream sidecar;
+    const std::string cfg_binding = write_static_cfg();
+    sidecar << "{\"schema\":\"sara-trace-completeness-v1\","
+            << "\"trace_schema\":\"sara-exact-trace-v2\","
+            << "\"format\":\"" << (m_jsonl ? "jsonl" : "json") << "\","
+            << "\"trace_bytes\":" << m_hash.bytes() << ','
+            << "\"trace_sha256\":\"" << m_hash.hex_digest() << "\","
+            << "\"trace_close_succeeded\":true,\"capture_footer\":" << footer;
+    if (m_gzip_enabled) {
+      sidecar << ",\"storage\":{\"schema\":\"sara-exact-trace-storage-v1\",\"codec\":\"gzip\","
+              << "\"physical_bytes\":" << m_gzip.physical_bytes()
+              << ",\"physical_sha256\":\"" << m_gzip.physical_sha256() << "\","
+              << "\"decoded_bytes\":" << m_hash.bytes()
+              << ",\"decoded_sha256\":\"" << m_hash.hex_digest() << "\",\"close_succeeded\":true}";
+    }
+    if (m_static_cfg_enabled) sidecar << ",\"static_cfg_binding\":" << cfg_binding;
+    if (host_binding != "null") sidecar << ",\"host_copy_binding\":" << host_binding;
+    sidecar << "}\n";
+    atomic_sidecar(sidecar.str());
+  }
+
+  ~exact_trace_writer() { close(); }
+
+ private:
+  struct thread_summary {
+    thread_summary() : kernel(0), thread(0), first_pc(0), last_pc(0), entry_pc(0),
+      events(0), last_attempt(0), terminal_attempt(0), completed(false) {}
+    unsigned kernel, thread;
+    dim3 cta, tid;
+    addr_t first_pc, last_pc, entry_pc;
+    uint64_t events, last_attempt, terminal_attempt;
+    bool completed;
+  };
+  struct kernel_summary {
+    kernel_summary() : uid(0), entry_pc(0), expected_threads(0), completed(false) {}
+    unsigned uid;
+    dim3 grid, block;
+    addr_t entry_pc;
+    uint64_t expected_threads;
+    bool completed;
+  };
+  static bool same_dim(dim3 left, dim3 right) {
+    return left.x == right.x && left.y == right.y && left.z == right.z;
+  }
+  static bool inside(dim3 point, dim3 bound) {
+    return point.x < bound.x && point.y < bound.y && point.z < bound.z;
+  }
+  uint64_t geometry_count(dim3 grid, dim3 block) {
+    const unsigned values[] = {grid.x, grid.y, grid.z, block.x, block.y, block.z};
+    uint64_t result = 1;
+    for (unsigned i = 0; i < 6; ++i) {
+      if (!values[i] || result > UINT64_MAX / values[i]) fail("kernel geometry overflow");
+      result *= values[i];
+    }
+    return result;
+  }
+  void write(const std::string &text) {
+    if (m_gzip_enabled) {
+      try { m_gzip.write(text.data(), text.size()); } catch (const std::exception &error) { fail(error.what()); }
+    } else if (!m_fp || fwrite(text.data(), 1, text.size(), m_fp) != text.size())
+      fail("trace write failed");
+    m_hash.update(text.data(), text.size());
+    if (m_hash.overflow()) fail("trace hash length overflow");
+  }
+  bool output_open() const { return m_fp != NULL || m_gzip.is_open(); }
+  void flush_output(const char *reason) {
+    if (m_gzip_enabled) {
+      try { m_gzip.flush(); } catch (const std::exception &error) { fail(error.what()); }
+    } else checked_flush(m_fp, reason);
+  }
+  void checked_flush(FILE *file, const char *reason) {
+    if (ferror(file) || fflush(file) != 0 || fsync(fileno(file)) != 0) fail(reason);
+  }
+  void atomic_sidecar(const std::string &text) {
+    std::string temporary = m_sidecar + ".tmp.XXXXXX";
+    std::vector<char> name(temporary.begin(), temporary.end());
+    name.push_back('\0');
+    int fd = mkstemp(&name[0]);
+    if (fd < 0) fail("cannot create completeness sidecar temporary");
+    m_temporary = &name[0];
+    FILE *file = fdopen(fd, "w");
+    if (!file) {
+      ::close(fd);
+      fail("cannot open completeness sidecar stream");
+    }
+    if (fwrite(text.data(), 1, text.size(), file) != text.size())
+      fail("completeness sidecar write failed");
+    checked_flush(file, "completeness sidecar flush/fsync failed");
+    if (fclose(file) != 0) fail("completeness sidecar fclose failed");
+    if (rename(m_temporary.c_str(), m_sidecar.c_str()) != 0)
+      fail("completeness sidecar atomic rename failed");
+    m_temporary.clear();
+    const size_t separator = m_sidecar.find_last_of('/');
+    const std::string parent = separator == std::string::npos ? "." :
+      (separator == 0 ? "/" : m_sidecar.substr(0, separator));
+    fd = open(parent.c_str(), O_RDONLY | O_DIRECTORY);
+    if (fd < 0) fail("cannot open completeness sidecar directory");
+    const int sync_status = fsync(fd);
+    const int close_status = ::close(fd);
+    if (sync_status != 0 || close_status != 0) fail("completeness directory fsync/close failed");
+  }
+  std::string capture_footer() const {
+    bool complete = !m_kernels.empty();
+    for (std::map<unsigned, kernel_summary>::const_iterator it = m_kernels.begin();
+         it != m_kernels.end(); ++it) complete = complete && it->second.completed;
+    std::ostringstream out;
+    out << "{\"schema\":\"sara-trace-capture-footer-v1\",\"capture_complete\":"
+        << (complete ? "true" : "false") << ",\"total_events\":" << m_global.value
+        << ",\"counter_overflow\":false,\"io_error\":false,\"kernels\":[";
+    bool first = true;
+    for (std::map<unsigned, kernel_summary>::const_iterator it = m_kernels.begin();
+         it != m_kernels.end(); ++it) {
+      const kernel_summary &kernel = it->second;
+      if (!first) out << ',';
+      first = false;
+      out << "{\"kernel_uid\":" << kernel.uid << ",\"normal_completion\":"
+          << (kernel.completed ? "true" : "false")
+          << ",\"completion_source\":\"stream_manager_kernel_is_finished\",\"grid\":["
+          << kernel.grid.x << ',' << kernel.grid.y << ',' << kernel.grid.z << "],\"block\":["
+          << kernel.block.x << ',' << kernel.block.y << ',' << kernel.block.z << ']'
+          << ",\"entry_pc\":\"" << hex_u64(kernel.entry_pc) << "\",\"expected_threads\":"
+          << kernel.expected_threads << '}';
+    }
+    out << "],\"normal_kernel_uids\":[";
+    first = true;
+    for (std::map<unsigned, kernel_summary>::const_iterator it = m_kernels.begin();
+         it != m_kernels.end(); ++it) {
+      if (!it->second.completed) continue;
+      if (!first) out << ',';
+      first = false;
+      out << it->first;
+    }
+    out << "],\"threads\":[";
+    first = true;
+    for (std::map<unsigned, thread_summary>::const_iterator it = m_threads.begin();
+         it != m_threads.end(); ++it) {
+      const thread_summary &thread = it->second;
+      if (!first) out << ',';
+      first = false;
+      out << "{\"kernel_uid\":" << thread.kernel << ",\"thread_id\":" << thread.thread
+          << ",\"logical_cta\":[" << thread.cta.x << ',' << thread.cta.y << ',' << thread.cta.z
+          << "],\"logical_tid\":[" << thread.tid.x << ',' << thread.tid.y << ',' << thread.tid.z
+          << "],\"first_pc\":\"" << hex_u64(thread.first_pc) << "\",\"last_pc\":\""
+          << hex_u64(thread.last_pc) << "\",\"entry_pc\":\"" << hex_u64(thread.entry_pc)
+          << "\",\"event_count\":" << thread.events << ",\"final_attempt_count\":"
+          << thread.terminal_attempt << ",\"terminated\":" << (thread.completed ? "true" : "false") << '}';
+    }
+    out << "]}";
+    return out.str();
+  }
+  std::string write_static_cfg() {
+    if (!m_static_cfg_enabled) return "null";
+    if (m_static_cfg.empty()) fail("static CFG collection is empty");
+    std::ostringstream body;
+    body << "{\"schema\":\"sara-assembled-static-cfg-v1\",\"functions\":[";
+    bool first = true;
+    for (std::map<std::pair<unsigned, addr_t>, std::string>::const_iterator it = m_static_cfg.begin();
+         it != m_static_cfg.end(); ++it) {
+      if (!first) body << ',';
+      first = false;
+      body << "{\"kernel_uid\":" << it->first.first << ",\"function\":" << it->second << '}';
+    }
+    body << "]}\n";
+    const std::string bytes = body.str();
+    FILE *file = fopen(m_static_cfg_file.c_str(), "w");
+    if (!file) fail("cannot open static CFG companion");
+    if (fwrite(bytes.data(), 1, bytes.size(), file) != bytes.size()) fail("static CFG write failed");
+    checked_flush(file, "static CFG flush/fsync failed");
+    if (fclose(file) != 0) fail("static CFG fclose failed");
+    sara_trace::sha256 hash;
+    hash.update(bytes.data(), bytes.size());
+    if (hash.overflow()) fail("static CFG hash overflow");
+    std::ostringstream binding;
+    binding << "{\"schema\":\"sara-static-cfg-close-binding-v1\","
+            << "\"trace_companion_suffix\":\".static_cfg.json\",\"bytes\":" << bytes.size()
+            << ",\"sha256\":\"" << hash.hex_digest() << "\",\"close_succeeded\":true}";
+    return binding.str();
+  }
+  void init(const gpgpu_functional_sim_config &cfg) {
+    const char *path = cfg.exact_trace_file();
+    if (!path || !path[0]) fail("exact trace path is empty");
+    m_sidecar = std::string(path) + ".completeness.json";
+    m_static_cfg_enabled = cfg.exact_trace_static_cfg();
+    if (m_static_cfg_enabled) {
+      m_static_cfg_file = std::string(path) + ".static_cfg.json";
+      if (unlink(m_static_cfg_file.c_str()) != 0 && errno != ENOENT) fail("cannot remove stale static CFG companion");
+    }
+    if (unlink(m_sidecar.c_str()) != 0 && errno != ENOENT)
+      fail("cannot remove a stale completeness sidecar");
+    const std::string codec = cfg.exact_trace_codec() ? cfg.exact_trace_codec() : "";
+    if (codec != "plain" && codec != "gzip") fail("unrecognized exact trace codec");
+    m_gzip_enabled = codec == "gzip";
+    if (m_gzip_enabled) {
+      try { m_gzip.open(path); } catch (const std::exception &error) { fail(error.what()); }
+    } else {
+      m_fp = fopen(path, "w");
+      if (!m_fp) fail("cannot open exact trace output");
+    }
+    m_jsonl = cfg.exact_trace_jsonl();
+    m_first_event = true;
+    if (!m_jsonl) write("{\n  \"trace_schema\":\"sara-exact-trace-v2\",\n  \"events\": [\n");
+    m_enabled = true;
+  }
+  void fail(const char *reason) {
+    fprintf(stderr, "GPGPU-Sim: exact trace completeness failed: %s (errno=%d)\n", reason, errno);
+    fflush(stderr);
+    if (!m_sidecar.empty()) unlink(m_sidecar.c_str());
+    if (!m_temporary.empty()) unlink(m_temporary.c_str());
+    // No recursive static-destruction close after a capture/I/O failure.
+    _exit(EXIT_FAILURE);
+  }
+  FILE *m_fp;
+  bool m_enabled, m_jsonl, m_first_event, m_closed;
+  std::string m_sidecar, m_temporary;
+  bool m_static_cfg_enabled;
+  bool m_gzip_enabled;
+  sara_trace::gzip_storage m_gzip;
+  std::string m_static_cfg_file;
+  std::map<std::pair<unsigned, addr_t>, std::string> m_static_cfg;
+  sara_trace::sha256 m_hash;
+  sara_trace::attempt_counter m_global;
+  std::map<unsigned, thread_summary> m_threads;
+  std::map<unsigned, kernel_summary> m_kernels;
+  std::mutex m_lock;
+};
+
+static exact_trace_writer g_exact_trace_writer;
+
+// Scoped value-free GEREM SMEM profile. No arithmetic or simulated bytes change.
+// This stream is separate from SARA's numeric trace and stores each static CFG
+// once, plus only executed shared-memory accesses. A missing close is rejected.
+class gerem_smem_writer {
+ public:
+  gerem_smem_writer() : file_(NULL), records_(0), previous_(0), first_(0) {}
+  static const char *path() {
+    static const char *value = getenv("SARA_GEREM_SMEM_TRACE_FILE");
+    return value;
+  }
+  void log(ptx_thread_info &thread, const function_info *function,
+           const ptx_instruction *instruction, uint64_t cycle,
+           addr_t pc, addr_t address, unsigned bytes, bool write) {
+    if (!path() || !path()[0]) return;
+    std::lock_guard<std::mutex> guard(lock_);
+    if (!function || !instruction || !bytes || bytes > 8 ||
+        instruction->get_opcode() == ATOM_OP || instruction->get_opcode() == RED_OP)
+      fail("unmodeled shared access in minimal storage profile");
+    if (!file_) {
+      file_ = fopen(path(), "wx");
+      if (!file_) fail("cannot open fresh minimal shared profile");
+      const char *source = getenv("SARA_SOURCE_FINGERPRINT");
+      if (!source || !source[0]) fail("missing compiled-source fingerprint");
+      std::ostringstream header;
+      header << "{\"kind\":\"header\",\"schema\":\"sara-gerem-shared-def-use-v1\","
+             << "\"source_fingerprint\":\"" << json_escape(source) << "\","
+             << "\"values_collected\":false,\"shared_identity_contract\":"
+             << "\"actual_allocator_persistent_object_owner_epoch_v1\"}\n";
+      append(header.str());
+    }
+    if (records_ && cycle < previous_) fail("shared access cycles not ordered");
+    const unsigned kernel = thread.get_kernel().get_uid();
+    const std::pair<unsigned, addr_t> key(kernel, function->get_start_PC());
+    if (functions_.insert(key).second) {
+      std::ostringstream cfg;
+      cfg << "{\"kind\":\"static_cfg\",\"kernel_uid\":" << kernel
+          << ",\"function\":" << function->trace_static_cfg_metadata(true) << "}\n";
+      append(cfg.str());
+    }
+    if (!records_) first_ = cycle;
+    previous_ = cycle;
+    const sara_shared::owner_identity &owner = thread.shared_owner_identity();
+    if (!owner.object_uid || !owner.owner_epoch) fail("shared owner identity missing");
+    std::ostringstream event;
+    event << "{\"kind\":\"access\",\"ordinal\":" << ++records_
+          << ",\"cycle\":" << cycle << ",\"kernel_uid\":" << kernel
+          << ",\"thread_id\":" << thread.get_uid()
+          << ",\"sm_id\":" << thread.get_hw_sid()
+          << ",\"cta_id\":" << thread.get_hw_ctaid()
+          << ",\"object_uid\":" << owner.object_uid
+          << ",\"owner_epoch\":" << owner.owner_epoch
+          << ",\"allocator_slot\":" << owner.allocator_slot
+          << ",\"pc\":\"" << hex_u64(pc)
+          << "\",\"function_start_pc\":\"" << hex_u64(function->get_start_PC())
+          << "\",\"opcode\":\"" << json_escape(extract_opcode_token(instruction))
+          << "\",\"write\":" << (write ? "true" : "false")
+          << ",\"mem_addr\":" << address << ",\"size_bytes\":" << bytes << "}\n";
+    append(event.str());
+  }
+  ~gerem_smem_writer() {
+    if (!file_) return;
+    std::ostringstream footer;
+    footer << "{\"kind\":\"footer\",\"records\":" << records_
+           << ",\"functions\":" << functions_.size()
+           << ",\"first_cycle\":" << first_ << ",\"last_cycle\":" << previous_
+           << ",\"prefix_bytes\":" << hash_.bytes()
+           << ",\"prefix_sha256\":\"" << hash_.hex_digest()
+           << "\",\"producer_complete\":true}\n";
+    const std::string text = footer.str();
+    if (fwrite(text.data(), 1, text.size(), file_) != text.size() ||
+        fflush(file_) != 0 || fsync(fileno(file_)) != 0 || fclose(file_) != 0)
+      fail("shared profile close failed");
+    file_ = NULL;
+  }
+ private:
+  void append(const std::string &text) {
+    if (fwrite(text.data(), 1, text.size(), file_) != text.size()) fail("shared profile write failed");
+    hash_.update(text.data(), text.size());
+    if (hash_.overflow()) fail("shared profile hash overflow");
+  }
+  static void fail(const char *why) {
+    fprintf(stderr, "GPGPU-Sim: GEREM minimal SMEM capture failed: %s\n", why);
+    fflush(stderr);
+    _exit(EXIT_FAILURE);
+  }
+  FILE *file_;
+  uint64_t records_, previous_, first_;
+  sara_trace::sha256 hash_;
+  std::set<std::pair<unsigned, addr_t> > functions_;
+  std::mutex lock_;
+};
+static gerem_smem_writer g_gerem_smem_writer;
