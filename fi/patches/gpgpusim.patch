+#ifndef SARA_PTX_INTEGER_LITERAL_H
+#define SARA_PTX_INTEGER_LITERAL_H
+
+#include <stdint.h>
+#include <limits.h>
+
+namespace sara_ptx {
+
+// A POD token payload, separate from opcode/option integers in YYSTYPE.
+// PTX integer literals have 64-bit magnitude. Unary minus is modulo 2^64;
+// the original sign/magnitude also lets narrower parser interfaces reject
+// values they cannot represent instead of silently truncating them.
+struct integer_literal {
+  uint64_t bits;
+  uint64_t magnitude;
+  bool negative;
+  bool is_unsigned;
+};
+
+inline bool parse_integer_literal(const char *text, integer_literal *result) {
+  if (!text || !result || !*text) return false;
+  const char *cursor = text;
+  const bool negative = *cursor == '-';
+  if (*cursor == '-' || *cursor == '+') ++cursor;
+  unsigned base = 10;
+  if (cursor[0] == '0' && (cursor[1] == 'x' || cursor[1] == 'X')) {
+    base = 16;
+    cursor += 2;
+  } else if (cursor[0] == '0' && (cursor[1] == 'b' || cursor[1] == 'B')) {
+    base = 2;
+    cursor += 2;
+  } else if (cursor[0] == '0' && cursor[1] >= '0' && cursor[1] <= '9') {
+    base = 8;
+  }
+  uint64_t magnitude = 0;
+  bool any_digit = false;
+  for (; *cursor && *cursor != 'U'; ++cursor) {
+    unsigned digit;
+    if (*cursor >= '0' && *cursor <= '9') digit = *cursor - '0';
+    else if (*cursor >= 'a' && *cursor <= 'f') digit = *cursor - 'a' + 10;
+    else if (*cursor >= 'A' && *cursor <= 'F') digit = *cursor - 'A' + 10;
+    else return false;
+    if (digit >= base || magnitude > (UINT64_MAX - digit) / base) return false;
+    magnitude = magnitude * base + digit;
+    any_digit = true;
+  }
+  const bool suffix_unsigned = *cursor == 'U';
+  if (!any_digit || (suffix_unsigned && cursor[1]) || (!suffix_unsigned && *cursor))
+    return false;
+  result->bits = negative ? uint64_t(0) - magnitude : magnitude;
+  result->magnitude = magnitude;
+  result->negative = negative;
+  result->is_unsigned = suffix_unsigned || magnitude > INT64_MAX;
+  return true;
+}
+
+inline bool integer_literal_to_int(const integer_literal &value, int *result) {
+  if (!result) return false;
+  if (!value.negative) {
+    if (value.magnitude > static_cast<uint64_t>(INT_MAX)) return false;
+    *result = static_cast<int>(value.magnitude);
+  } else {
+    const uint64_t minimum_magnitude = static_cast<uint64_t>(INT_MAX) + 1;
+    if (value.magnitude > minimum_magnitude) return false;
+    *result = value.magnitude == minimum_magnitude
+                  ? INT_MIN : -static_cast<int>(value.magnitude);
+  }
+  return true;
+}
+
+}  // namespace sara_ptx
+#endif
