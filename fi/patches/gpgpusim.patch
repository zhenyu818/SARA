+#ifndef SARA_CACHE_ALLOCATION_BOUNDS_H
+#define SARA_CACHE_ALLOCATION_BOUNDS_H
+#include <stdint.h>
+#include <limits.h>
+#include <stdexcept>
+namespace sara_cache {
+// Describes the actual constructor allocation; never recomputed from config.
+struct allocation_shape {
+  unsigned lines, line_bytes, cache_type;
+  allocation_shape(unsigned n, unsigned bytes, unsigned type)
+      : lines(n), line_bytes(bytes), cache_type(type) {
+    if (!n || !bytes) throw std::invalid_argument("empty cache allocation");
+  }
+  bool admits(uint64_t sets, uint64_t ways, unsigned bytes, unsigned type) const {
+    return sets && ways && sets <= UINT_MAX / ways && sets * ways <= lines &&
+           bytes == line_bytes && type == cache_type;
+  }
+  bool contains(uint64_t index) const { return index < lines; }
+};
+inline unsigned allocation_lines(uint64_t sets, uint64_t ways, uint64_t multiplier) {
+  if (!sets || !ways || !multiplier || sets > UINT_MAX / ways ||
+      sets * ways > UINT_MAX / multiplier)
+    throw std::invalid_argument("cache allocation size overflow");
+  return static_cast<unsigned>(sets * ways * multiplier);
+}
+}  // namespace sara_cache
+#endif
