+// A full real-slot walk at each actual hook. Equal snapshots are RLE changes;
+// hook records retain every real cycle and exact raw capacity independently.
+class state_stream {
+ public:
+  state_stream() : hooks_(0), last_cycle_(0), total_bits_(0) {}
+  void begin(uint64_t cycle, uint64_t cursor) {
+    writer_ = sara_host_copy::get(); if (!writer_) return;
+    sara_host_copy::increment(hooks_); cycle_ = cycle; cursor_ = cursor; present_.clear(); hook_bits_ = 0; unresolved_bits_ = 0;
+    if (hooks_ > 1 && (last_cycle_ == UINT64_MAX || cycle != last_cycle_ + 1))
+      writer_->unmodeled("cache_hook_clock_gap_or_repeat", cycle, 0, cursor);
+    last_cycle_ = cycle;
+  }
+  void owner(const std::string &key, const char *component, unsigned scope, bool disabled,
+      const tag_array *tags, const cache_config *cfg, bool scope_known = true) {
+    if (!writer_) return;
+    std::ostringstream out; out << "\"owner_key\":" << sara_host_copy::quoted(key) << ",\"component\":" << sara_host_copy::quoted(component)
+        << ",\"scope\":" << (scope_known ? std::to_string(scope) : "null") << ",\"disabled\":" << (disabled ? "true" : "false");
+    if (changed_slot_profile()) {
+      const std::string presence = std::to_string(disabled) + ":" + std::to_string(tags != NULL) + ":" + std::to_string(cfg != NULL);
+      if (owner_presence_.count(key) && owner_presence_[key] != presence)
+        sara_host_copy::fail("production_changed_slot_capture_owner_presence_changed");
+      owner_presence_[key] = presence;
+    }
+    if (disabled) { out << ",\"present\":false,\"active_lines\":0,\"actual_backing_capacity_known\":false"; change(key, "cache_owner", out.str()); return; }
+    if (!tags || !cfg) { out << ",\"present\":false,\"active_lines\":null";
+      if (cfg) {
+        const uint64_t expected = static_cast<uint64_t>(cfg->get_num_lines()) * (57ULL + 8ULL * cfg->get_line_sz());
+        if (expected > UINT64_MAX - unresolved_bits_) sara_host_copy::fail("cache_unresolved_mass_overflow");
+        unresolved_bits_ += expected; out << ",\"unresolved_expected_bits\":" << expected;
+      } else out << ",\"unresolved_expected_bits\":null";
+      change(key, "cache_owner", out.str());
+      writer_->unmodeled("configured_cache_owner_missing", scope, 0, cursor_); return; }
+    tags->fault_check_allocation(); const sara_cache::allocation_shape &a = tags->actual_allocation();
+    out << ",\"present\":true,\"active_lines\":" << cfg->get_num_lines() << ",\"actual_allocated_lines\":" << a.lines
+        << ",\"line_bytes\":" << a.line_bytes << ",\"cache_type\":" << a.cache_type
+        << ",\"actual_backing_capacity_known\":true,\"active_index_allocation_validated\":true";
+    const bool changes = changed_slot_profile();
+    const sara_fault::tag_cache_owner &registry_owner = sara_fault::tag_cache_owners().at(tags);
+    const std::string topology = out.str() + ":" + std::to_string(registry_owner.instance) + ":" + std::to_string(registry_owner.epoch);
+    const bool initial = fixed_topologies_.find(key) == fixed_topologies_.end();
+    if (changes && !initial && fixed_topologies_[key] != topology)
+      sara_host_copy::fail("production_changed_slot_capture_requires_fixed_owner_geometry");
+    fixed_topologies_[key] = topology;
+    change(key, "cache_owner", out.str());
+    const uint64_t per_line = 57ULL + static_cast<uint64_t>(a.line_bytes) * 8;
+    if (cfg->get_num_lines() > UINT64_MAX / per_line || cfg->get_num_lines() * per_line > UINT64_MAX - hook_bits_)
+      sara_host_copy::fail("cache_bit_mass_overflow");
+    hook_bits_ += cfg->get_num_lines() * per_line;
+    std::set<unsigned> selected;
+    if (!changes || initial) {
+      for (unsigned i = 0; i < cfg->get_num_lines(); ++i) selected.insert(i);
+    } else selected.swap(changed_slots()[tags]);
+    if (changes && initial) changed_slots()[tags].clear();
+    for (std::set<unsigned>::const_iterator selected_slot = selected.begin(); selected_slot != selected.end(); ++selected_slot) {
+      const unsigned i = *selected_slot;
+      if (i >= cfg->get_num_lines()) sara_host_copy::fail("changed_slot_outside_actual_owner");
+      const cache_block_t *line = tags->get_block(i); std::ostringstream row;
+      row << "\"owner_key\":" << sara_host_copy::quoted(key) << ",\"copy\":" << identity(tags, *cfg, i)
+          << ",\"allocation_time_stored_u64_from_u32\":" << line->get_alloc_time() << ",\"last_access_time_stored_u64_from_u32\":" << line->get_last_access_time()
+          << ",\"sector_state\":[";
+      const unsigned sectors = cfg->m_cache_type == NORMAL ? 1 : SECTOR_CHUNCK_SIZE;
+      for (unsigned j = 0; j < sectors; ++j) { if (j) row << ','; mem_access_sector_mask_t m; m.set(j);
+        row << "{\"status\":" << line->get_status(m) << ",\"readable\":" << (line->is_readable(m) ? "true" : "false") << '}'; }
+      row << ']'; change(key + ":" + std::to_string(i), "cache_slot", row.str());
+    }
+  }
+  void end() {
+    if (!writer_) return;
+    const bool changes = changed_slot_profile();
+    if (!changes) {
+      for (std::map<std::string, std::string>::iterator i = prior_.begin(); i != prior_.end();) {
+        if (!present_.count(i->first)) { writer_->cache_event("cache_removed", cursor_, "\"key\":" + sara_host_copy::quoted(i->first) + ",\"hook\":" + std::to_string(hooks_)); prior_.erase(i++); }
+        else ++i;
+      }
+    }
+    if (hook_bits_ > UINT64_MAX - total_bits_) sara_host_copy::fail("cache_total_bit_mass_overflow"); total_bits_ += hook_bits_;
+    std::ostringstream row; row << "\"hook\":" << hooks_ << ",\"cycle\":" << cycle_ << ",\"active_bit_count\":" << hook_bits_
+      << ",\"cumulative_bit_cycles\":" << total_bits_ << ",\"unresolved_expected_bits\":" << unresolved_bits_ << ",\"state_keys\":" << (changes ? prior_.size() : present_.size());
+    writer_->cache_event("cache_hook", cursor_, row.str());
+  }
+ private:
+  void change(const std::string &key, const char *kind, const std::string &body) {
+    if (!present_.insert(key).second) sara_host_copy::fail("duplicate_cache_owner_or_slot");
+    std::map<std::string, std::string>::iterator i = prior_.find(key);
+    if (i == prior_.end() || i->second != body) {
+      writer_->cache_event(kind, cursor_, "\"key\":" + sara_host_copy::quoted(key) + ",\"hook\":" + std::to_string(hooks_) + ",\"cycle\":" + std::to_string(cycle_) + ',' + body);
+      prior_[key] = body;
+    }
+  }
+  sara_host_copy::collector *writer_ = NULL; uint64_t hooks_, last_cycle_, total_bits_, cycle_, cursor_, hook_bits_, unresolved_bits_;
+  std::map<std::string, std::string> prior_, fixed_topologies_, owner_presence_; std::set<std::string> present_;
+};
+}  // namespace sara_cache_records
