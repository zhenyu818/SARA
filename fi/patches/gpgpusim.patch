+#define SARA_PTX_FP_OPS_H
+
+// Scalar FMA semantics for the simulator, separately testable without CUDA.
+// PTX ISA 7.8 (CUDA 11.8), sections 9.7.3.6--7. Never replace fma by a*b+c:
+// the intermediate product must not be rounded or overflow independently.
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <cfenv>
+#include <stdexcept>
+#if defined(__SSE__)
+#include <xmmintrin.h>
+#endif
+
+namespace sara_ptx {
+class ScopedRounding {
+    fenv_t saved_;
+#if defined(__SSE__)
+    unsigned saved_mxcsr_;
+#endif
+public:
+    explicit ScopedRounding(int mode) {
+#if defined(__SSE__)
+        saved_mxcsr_ = _mm_getcsr();
+#endif
+        if (feholdexcept(&saved_) || fesetround(mode))
+            throw std::runtime_error("host cannot implement the requested PTX rounding mode");
+#if defined(__SSE__)
+        // Apply PTX FTZ explicitly; do not inherit the host's FTZ/DAZ policy.
+        _mm_setcsr(_mm_getcsr() & ~((1u << 15) | (1u << 6)));
+#endif
+    }
+    ~ScopedRounding() {
+        fesetenv(&saved_);
+#if defined(__SSE__)
+        _mm_setcsr(saved_mxcsr_);
+#endif
+    }
+private:
+    ScopedRounding(const ScopedRounding &);
+    ScopedRounding &operator=(const ScopedRounding &);
+};
+
+inline float flush_subnormal(float value) {
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+    if ((bits & 0x7f800000u) == 0 && (bits & 0x007fffffu)) {
+        bits &= 0x80000000u;
+        std::memcpy(&value, &bits, sizeof(bits));
+    }
+    return value;
+}
+
+inline float fused_f32(float a, float b, float c, int mode, bool ftz, bool sat) {
+    ScopedRounding rounding(mode);
+    if (ftz) {
+        a = flush_subnormal(a);
+        b = flush_subnormal(b);
+        c = flush_subnormal(c);
+    }
+    // An indirect call prevents constant folding or accidental contraction
+    // decisions from substituting another rounding sequence at -O3.
+    float (*volatile operation)(float, float, float) = ::fmaf;
+    float result = operation(a, b, c);
+    if (ftz) result = flush_subnormal(result);
+    if (sat) {
+        if (std::isnan(result) || result < 0.0f) result = 0.0f;
+        else if (result > 1.0f) result = 1.0f;
+    }
+    return result;
+}
+
+inline double fused_f64(double a, double b, double c, int mode) {
+    ScopedRounding rounding(mode);
+    double (*volatile operation)(double, double, double) = ::fma;
+    return operation(a, b, c);
+}
+}  // namespace sara_ptx
