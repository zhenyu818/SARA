+// Default-off independent tiny reference; does not share the collector walk.
+#include "population_reference_ticks.h"
+
+static sara_population::interval_stream g_population_inventory;
+static std::set<unsigned> g_population_kernels;
+struct population_rf_descriptors {
+  population_rf_descriptors() : epoch(UINT64_MAX) {}
+  uint64_t epoch;
+  std::vector<sara_population::member> members;
+};
+static std::map<unsigned, population_rf_descriptors> g_population_rf_descriptors;
+static uint64_t g_population_rf_epoch = 0, g_population_smem_epoch = 0;
+static bool g_population_directory_seen = false;
+
+static std::string population_cta(ptx_thread_info *thread) {
+  const dim3 cta = thread->get_ctaid();
+  std::ostringstream text;
+  text << cta.x << "," << cta.y << "," << cta.z;
+  return text.str();
+}
+
+static std::string population_context(ptx_thread_info *thread, bool acknowledgement) {
+  std::ostringstream text;
+  text << "\"thread\":" << (acknowledgement ? sara_population::quote(std::to_string(thread->get_uid())) : std::to_string(thread->get_uid()))
+       << ",\"kernel\":" << (acknowledgement ? sara_population::quote(std::to_string(thread->get_kernel().get_uid())) : std::to_string(thread->get_kernel().get_uid()))
+       << ",\"sm\":" << (acknowledgement ? sara_population::quote(std::to_string(thread->get_hw_sid())) : std::to_string(thread->get_hw_sid()))
+       << ",\"cta_slot\":" << (acknowledgement ? sara_population::quote(std::to_string(thread->get_cta_uid())) : std::to_string(thread->get_cta_uid()));
+  if (acknowledgement) text << ",\"cta\":" << sara_population::quote(population_cta(thread));
+  return text.str();
+}
+
+// This observer deliberately uses the injector's exact active-thread/shared-
+// scope walk. It does not derive storage membership from instruction consumers.
+static void collect_population_inventory(const gpgpu_sim_config &cfg,
+    const shader_core_config *shader, simt_core_cluster **clusters, uint64_t cycle) {
+  if (!cfg.population_output() || !cfg.population_output()[0]) return;
+  if (!g_population_inventory.enabled()) {
+    std::ostringstream header;
+    header << "\"phase\":\"after_all_core_instruction_events_at_cycle\","
+           << "\"model\":\"active-allocated-simulator-rf-smem-single-bit-v1\","
+           << "\"coordinate_system\":\"simulator_hook_allocated_storage\","
+           << "\"time_basis\":\"simulator_global_cycle\","
+           << "\"num_shaders\":" << shader->num_shader()
+           << ",\"smem_limit_bytes\":" << shader->gpgpu_shmem_per_block
+           << ",\"smem_page_bytes\":16384,\"smem_initialization\":\"lazy_zero_page_retained_across_cta\""
+           << ",\"shared_identity_contract\":\"actual_allocator_persistent_object_owner_epoch_v1\"";
+    g_population_inventory.open(cfg.population_output(), header.str());
+    if (!cfg.population_fault_free_options())
+      g_population_inventory.block("collection_requires_fault_free_profile0_perthread_allkernels");
+    if (cfg.population_has_termination_limit())
+      g_population_inventory.block("simulation_termination_limit_configured");
+  }
+  const bool compact = g_population_inventory.compact();
+  bool literal_walk = false;
+  {
+    sara_population::directory().enabled = true;
+    const char *mode = getenv("SARA_POPULATION_DIRECTORY");
+    if (mode && mode[0] && std::string(mode) != "events" && std::string(mode) != "walk") {
+      fprintf(stderr, "unsupported population directory observation\n"); abort();
+    }
+    // Both formats observe the same complete directory. Legacy FI records keep
+    // their numeric selectors: any global mutation rebuilds the entire walk,
+    // including indices of otherwise unchanged surviving threads/scopes.
+    // The per-thread descriptor cache below remains analysis-only (compact).
+    // The literal complete walk is an explicit correctness reference.
+    literal_walk = mode && std::string(mode) == "walk";
+    const sara_population::directory_state &state = sara_population::directory();
+    if (!literal_walk && g_population_directory_seen &&
+        (!g_population_inventory.includes_rf() || g_population_rf_epoch == state.rf) &&
+        (!g_population_inventory.includes_smem() || g_population_smem_epoch == state.smem)) {
+      g_population_inventory.repeat_tick(cycle); return;
+    }
+    g_population_rf_epoch = state.rf; g_population_smem_epoch = state.smem;
+    g_population_directory_seen = true;
+  }
+  tr1_hash_map<unsigned, std::vector<std::vector<ptx_thread_info*> > > active;
+  find_active_kernels_warps(active, shader, clusters);
+  std::vector<unsigned> all_kernels(1, 0);
+  std::vector<ptx_thread_info *> threads, scopes;
+  std::vector<memory_space *> memories;
+  find_active_threads(threads, active, all_kernels);
+  if (g_population_inventory.includes_smem())
+    find_active_shared_memories(memories, scopes, active, all_kernels);
+  std::vector<sara_population::member> members;
+  for (size_t ti = 0; ti < threads.size(); ++ti)
+    g_population_kernels.insert(threads[ti]->get_kernel().get_uid());
+  if (g_population_inventory.includes_rf()) {
+  for (size_t ti = 0; ti < threads.size(); ++ti) {
+    ptx_thread_info *thread = threads[ti];
+    if (thread->get_cta_uid() != static_cast<uint64_t>(thread->get_hw_ctaid()) * shader->num_shader() + thread->get_hw_sid())
+      g_population_inventory.block("cta_slot_mapping_disagrees_with_allocator");
+    population_rf_descriptors &cached = g_population_rf_descriptors[thread->get_uid()];
+    if (compact && !literal_walk && cached.epoch == thread->population_register_epoch()) {
+      members.insert(members.end(), cached.members.begin(), cached.members.end());
+      continue;
+    }
+    const size_t first_member = members.size();
+    struct entry { const symbol *reg; unsigned frame; entry(const symbol *r, unsigned f) : reg(r), frame(f) {} };
+    std::vector<entry> regs;
+    unsigned frame_index = 0;
+    const std::list<tr1_hash_map<const symbol *, ptx_reg_t> > &frames = thread->population_regs_read_only();
+    if (frames.size() > 1) g_population_inventory.block("multi_frame_lifecycle_unverified");
+    for (std::list<tr1_hash_map<const symbol *, ptx_reg_t> >::const_iterator frame = frames.begin(); frame != frames.end(); ++frame, ++frame_index)
+      for (tr1_hash_map<const symbol *, ptx_reg_t>::const_iterator reg = frame->begin(); reg != frame->end(); ++reg)
+        regs.push_back(entry(reg->first, frame_index));
+    std::stable_sort(regs.begin(), regs.end(), [](const entry &a, const entry &b) { return a.reg->uid() < b.reg->uid(); });
+    std::map<unsigned, unsigned> uid_counts;
+    for (size_t ri = 0; ri < regs.size(); ++ri) ++uid_counts[regs[ri].reg->uid()];
+    for (size_t ri = 0; ri < regs.size(); ++ri) {
+      const symbol *reg = regs[ri].reg;
+      size_t width = 0; int basic_type = 0;
+      if (reg->type()) reg->type()->get_key().type_decode(width, basic_type);
+      const bool supported = (width == 1 || width == 8 || width == 16 || width == 32 || width == 64 || width == 128) && uid_counts[reg->uid()] == 1;
+      if (!supported) g_population_inventory.block("unresolved_rf_width_or_duplicate_uid");
+      std::ostringstream body, key;
+      key << "rf:" << thread->get_uid() << ":" << regs[ri].frame << ":" << reg->uid();
+      body << "\"component\":\"rf\",\"bit_start\":0,\"bit_count\":" << width
+           << ",\"mapping_supported\":" << (supported ? "true" : "false")
+           << ",\"target\":{" << population_context(thread, false) << ",\"cta_id\":" << thread->get_hw_ctaid()
+           << ",\"register\":" << sara_population::quote(reg->name()) << ",\"register_uid\":" << reg->uid() << ",\"width_bits\":" << width << "}";
+      if (!compact)
+        body << ",\"hook_selectors\":{\"-kernel_n\":\"0\",\"-per_warp\":\"0\",\"-thread_rand\":" << sara_population::quote(std::to_string(ti))
+           << ",\"-register_rand_n\":" << sara_population::quote(std::to_string(ri + 1)) << "}"
+           << ",\"ack_expected\":{\"component\":\"rf\"," << population_context(thread, true)
+           << ",\"reg\":" << sara_population::quote(reg->name()) << ",\"reg_uid\":" << sara_population::quote(std::to_string(reg->uid()))
+           << ",\"width\":" << sara_population::quote(std::to_string(width)) << "}";
+      body << ",\"lifecycle\":{\"logical_cta\":" << sara_population::quote(population_cta(thread))
+           << ",\"frame_index\":" << regs[ri].frame << ",\"frame_count\":" << frames.size();
+      if (!compact) body << ",\"active_thread_index\":" << ti << ",\"register_walk_index\":" << ri + 1;
+      body << "}";
+      members.push_back(sara_population::member(key.str(), body.str(), width, true));
+    }
+    if (compact) {
+      cached.epoch = thread->population_register_epoch();
+      cached.members.assign(members.begin() + first_member, members.end());
+    }
+  }
+  }
+  if (g_population_kernels.size() > 1) g_population_inventory.block("multi_kernel_lifecycle_unverified");
+  for (size_t si = 0; si < scopes.size(); ++si) {
+    ptx_thread_info *scope = scopes[si];
+    const sara_shared::owner_identity &owner = scope->shared_owner_identity();
+    if (!owner.object_uid || !owner.owner_epoch || owner.allocator_slot != scope->get_cta_uid()) {
+      g_population_inventory.block("actual_shared_allocator_identity_missing"); continue;
+    }
+
+    memory_space_impl<16 * 1024> *memory = dynamic_cast<memory_space_impl<16 * 1024> *>(memories[si]);
+    if (!memory) { g_population_inventory.block("unsupported_shared_memory_container"); continue; }
+    mem_map<mem_addr_t, mem_storage<16 * 1024> > &pages = memory->get_m_data();
+    std::vector<uint64_t> page_indices;
+    for (mem_map<mem_addr_t, mem_storage<16 * 1024> >::const_iterator page = pages.begin(); page != pages.end(); ++page)
+      page_indices.push_back(page->first);
+    std::sort(page_indices.begin(), page_indices.end());
+    for (size_t pi = 0; pi < page_indices.size(); ++pi) {
+      const uint64_t begin = page_indices[pi] * 16384;
+      if (begin >= shader->gpgpu_shmem_per_block) continue;  // injector rejects outside this configured limit
+      const uint64_t count = std::min<uint64_t>(16384, shader->gpgpu_shmem_per_block - begin);
+      std::ostringstream body, key;
+      key << "smem:" << scope->get_kernel().get_uid() << ":" << scope->get_cta_uid() << ":" << population_cta(scope) << ":" << page_indices[pi];
+      body << "\"component\":\"smem_page\",\"mapping_supported\":true,\"byte_start\":" << begin << ",\"byte_count\":" << count
+           << ",\"target\":{\"kernel\":" << scope->get_kernel().get_uid() << ",\"sm\":" << scope->get_hw_sid()
+           << ",\"cta_slot\":" << scope->get_cta_uid() << ",\"cta_id\":" << scope->get_hw_ctaid() << "}";
+      if (!compact)
+        body << ",\"hook_selectors\":{\"-kernel_n\":\"0\",\"-per_warp\":\"0\",\"-block_rand\":" << sara_population::quote(std::to_string(si)) << ",\"-block_n\":\"1\"}"
+           << ",\"ack_expected\":{\"component\":\"smem\"," << population_context(scope, true) << ",\"width\":\"8\""
+           << ",\"shared_storage_uid\":" << sara_population::quote(std::to_string(owner.object_uid))
+           << ",\"shared_owner_epoch\":" << sara_population::quote(std::to_string(owner.owner_epoch))
+           << ",\"shared_allocator_slot\":" << sara_population::quote(std::to_string(owner.allocator_slot)) << "}";
+      body << ",\"lifecycle\":{\"logical_cta\":" << sara_population::quote(population_cta(scope))
+           << ",\"shared_object_slot\":" << scope->get_cta_uid()
+           << ",\"shared_storage_uid\":" << owner.object_uid << ",\"shared_owner_epoch\":" << owner.owner_epoch
+           << ",\"shared_allocator_slot\":" << owner.allocator_slot << ",\"page_index\":" << page_indices[pi]
+           << ",\"page_bytes\":16384";
+      if (!compact) body << ",\"shared_scope_index\":" << si;
+      body << "}";
+      members.push_back(sara_population::member(key.str(), body.str(), count * 8, false));
+    }
+  }
+  g_population_inventory.tick(cycle, members);
+}
+
+static std::string fault_value_hex(const void *storage, unsigned width_bits) {
+  static const char hex[] = "0123456789abcdef";
+  const unsigned char *bytes = static_cast<const unsigned char *>(storage);
+  std::string out;
+  for (unsigned n = (width_bits + 7) / 8; n > 0; --n) {
+    unsigned byte = bytes[n - 1];
+    if (n == (width_bits + 7) / 8 && width_bits % 8)
+      byte &= (1U << (width_bits % 8)) - 1;
+    out += hex[byte >> 4];
+    out += hex[byte & 15];
+  }
+  return out;
+}
+
+static void flip_rf_register(ptx_thread_info *thread, const symbol *reg_symbol,
+                             ptx_reg_t *value, const std::vector<unsigned> &bits,
+                             unsigned long long cycle) {
+  size_t width = 0;
+  int basic_type = 0;
+  if (reg_symbol->type() == NULL) {
+    printf("GPUFI_FAULT component=rf status=rejected reason=missing_register_type\n");
+    return;
+  }
+  reg_symbol->type()->get_key().type_decode(width, basic_type);
+  for (size_t j = 0; j < bits.size(); ++j) {
+    uint64_t zero = 0;
+    if (width > sizeof(ptx_reg_t) * 8 ||
+        !sara_fault::zero_based_bit(bits[j], width, &zero)) {
+      printf("GPUFI_FAULT component=rf status=rejected reason=invalid_bit "
+             "cycle=%llu thread=%u reg=%s reg_uid=%u width=%u bit=%u\n",
+             cycle, thread->get_uid(), reg_symbol->name().c_str(),
+             reg_symbol->uid(), static_cast<unsigned>(width), bits[j]);
+      return;  // Validate every requested bit before changing this register.
+    }
+  }
+  for (size_t j = 0; j < bits.size(); ++j) {
+    const std::string before = fault_value_hex(value, static_cast<unsigned>(width));
+    if (!sara_fault::flip_bit(value, sizeof(*value), static_cast<unsigned>(width), bits[j]))
+      continue;
+    const std::string after = fault_value_hex(value, static_cast<unsigned>(width));
+    const dim3 cta = thread->get_ctaid();
+    printf("GPUFI_FAULT component=rf status=applied cycle=%llu kernel=%u "
+           "thread=%u sm=%u cta_slot=%llu cta=%u,%u,%u reg=%s reg_uid=%u "
+           "width=%u bit=%u before=%s after=%s\n", cycle,
+           thread->get_kernel().get_uid(), thread->get_uid(), thread->get_hw_sid(),
+           thread->get_cta_uid(), cta.x, cta.y, cta.z,
+           reg_symbol->name().c_str(), reg_symbol->uid(), static_cast<unsigned>(width),
+           bits[j], before.c_str(), after.c_str());
+  }
+}
+
+void bitflip_n_nregs(std::vector<ptx_thread_info*> &threads_vector,
+                     char *register_rand_n, char *reg_bitflip_rand_n,
+                     const char *register_name, unsigned long long cycle) {
+  std::vector<unsigned> bits, indices;
+  read_colon_option(bits, reg_bitflip_rand_n);
+  read_colon_option(indices, register_rand_n);
+  for (size_t ti = 0; ti < threads_vector.size(); ++ti) {
+    ptx_thread_info *thread = threads_vector[ti];
+    std::vector<std::pair<const symbol *, ptx_reg_t *> > regs;
+    std::list<tr1_hash_map<const symbol *, ptx_reg_t> > &frames = thread->get_regs();
+    for (std::list<tr1_hash_map<const symbol *, ptx_reg_t> >::iterator frame = frames.begin();
+         frame != frames.end(); ++frame) {
+      for (tr1_hash_map<const symbol *, ptx_reg_t>::iterator reg = frame->begin();
+           reg != frame->end(); ++reg) {
+        regs.push_back(std::make_pair(reg->first, &reg->second));
+      }
+    }
+    std::stable_sort(regs.begin(), regs.end(),
+        [](const std::pair<const symbol *, ptx_reg_t *> &left,
+           const std::pair<const symbol *, ptx_reg_t *> &right) {
+          return left.first->uid() < right.first->uid();
+        });
+    if (register_name && *register_name) {
+      std::istringstream names(register_name);
+      std::string name;
+      while (std::getline(names, name, ':')) {
+        size_t match = regs.size(), matches = 0;
+        for (size_t i = 0; i < regs.size(); ++i) {
+          if (regs[i].first->name() == name) { match = i; ++matches; }
+        }
+        if (matches != 1) {
+          printf("GPUFI_FAULT component=rf status=%s reason=%s cycle=%llu "
+                 "thread=%u reg=%s\n", matches ? "rejected" : "unmapped",
+                 matches ? "ambiguous_register" : "register_not_live", cycle,
+                 thread->get_uid(), name.c_str());
+          continue;
+        }
+        flip_rf_register(thread, regs[match].first, regs[match].second, bits, cycle);
+      }
+    } else {
+      for (size_t i = 0; i < indices.size(); ++i) {
+        if (indices[i] == 0 || indices[i] > regs.size()) {
+          printf("GPUFI_FAULT component=rf status=rejected reason=invalid_register_index\n");
+          continue;
+        }
+        const size_t index = indices[i] - 1;
+        flip_rf_register(thread, regs[index].first, regs[index].second, bits, cycle);
+      }
+    }
+  }
+}
+
+template <unsigned BlockBytes>
+static void flip_memory_bits(memory_space *space, ptx_thread_info *scope,
+                             const std::vector<unsigned> &bits,
+                             const char *component, unsigned long long cycle) {
+  const bool actual_shared = std::string(component) == "smem";
+  const sara_shared::owner_identity &owner = scope->shared_owner_identity();
+  if (actual_shared && (space != scope->m_shared_mem || !owner.object_uid || !owner.owner_epoch ||
+                        owner.allocator_slot != scope->get_cta_uid())) {
+    printf("GPUFI_FAULT component=smem status=rejected reason=actual_shared_owner_identity_invalid\n");
+    return;
+  }
+  memory_space_impl<BlockBytes> *memory = dynamic_cast<memory_space_impl<BlockBytes> *>(space);
+  if (!memory) {
+    printf("GPUFI_FAULT component=%s status=rejected reason=memory_type_mismatch\n", component);
+    return;
+  }
+  mem_map<mem_addr_t, mem_storage<BlockBytes> > &data = memory->get_m_data();
+  for (size_t j = 0; j < bits.size(); ++j) {
+    uint64_t block = 0;
+    size_t byte = 0;
+    unsigned bit = 0;
+    if (!sara_fault::memory_bit(bits[j], BlockBytes, &block, &byte, &bit)) {
+      printf("GPUFI_FAULT component=%s status=rejected reason=invalid_bit bit=%u\n",
+             component, bits[j]);
+      continue;
+    }
+    typename mem_map<mem_addr_t, mem_storage<BlockBytes> >::iterator found =
+        data.find(static_cast<mem_addr_t>(block));
+    if (found == data.end()) {
+      printf("GPUFI_FAULT component=%s status=unmapped reason=unallocated_storage "
+             "cycle=%llu thread=%u cta_slot=%llu bit=%u\n", component, cycle,
+             scope->get_uid(), scope->get_cta_uid(), bits[j]);
+      continue;
+    }
+    unsigned char *value = found->second.get_m_data() + byte;
+    const unsigned before = *value;
+    sara_fault::flip_bit(value, 1, 8, bit + 1);
+    const dim3 cta = scope->get_ctaid();
+    std::ostringstream identity;
+    if (actual_shared) identity << " shared_storage_uid=" << owner.object_uid << " shared_owner_epoch=" << owner.owner_epoch
+                               << " shared_allocator_slot=" << owner.allocator_slot;
+    printf("GPUFI_FAULT component=%s status=applied cycle=%llu kernel=%u "
+           "thread=%u sm=%u cta_slot=%llu cta=%u,%u,%u byte_addr=%llu "
+           "width=8 bit=%u byte_bit=%u before=%02x after=%02x%s\n", component,
+           cycle, scope->get_kernel().get_uid(), scope->get_uid(), scope->get_hw_sid(),
+           scope->get_cta_uid(), cta.x, cta.y, cta.z,
+           static_cast<unsigned long long>(block * BlockBytes + byte), bits[j], bit,
+           before, static_cast<unsigned>(*value), identity.str().c_str());
+  }
+}
+
+void bitflip_n_local_mem(std::vector<ptx_thread_info*> &threads,
+                         char *option, unsigned long long cycle) {
+  std::vector<unsigned> bits;
+  read_colon_option(bits, option);
+  for (size_t i = 0; i < threads.size(); ++i)
+    flip_memory_bits<32>(threads[i]->m_local_mem, threads[i], bits, "local", cycle);
+}
+
+void bitflip_n_shared_mem_nblocks(std::vector<memory_space *> memories,
+                                  std::vector<ptx_thread_info *> scopes,
+                                  unsigned block_rand, unsigned block_n,
+                                  char *option, unsigned long long cycle,
+                                  uint64_t max_bits) {
+  std::vector<unsigned> bits;
+  read_colon_option(bits, option);
+  for (size_t j = 0; j < bits.size(); ++j) {
+    uint64_t zero = 0;
+    if (!sara_fault::zero_based_bit(bits[j], max_bits, &zero)) {
+      printf("GPUFI_FAULT component=smem status=rejected reason=invalid_bit bit=%u\n",
+             bits[j]);
+      return;
+    }
+  }
+  while (block_n && !memories.empty()) {
+    const size_t index = block_rand % memories.size();
+    flip_memory_bits<16 * 1024>(memories[index], scopes[index], bits, "smem", cycle);
+    memories.erase(memories.begin() + index);
+    scopes.erase(scopes.begin() + index);
+    --block_n;
+  }
+}
+
+void gpgpu_sim::bitflip_global_memory() {
+  const unsigned bsize = 32U;
+  memory_space_impl<bsize> *global_mem =
+      dynamic_cast<memory_space_impl<bsize> *>(this->get_global_memory());
+  if (global_mem == NULL) {
+    fprintf(stderr, "Warning: GMEM FI skipped because global memory space is unavailable.\n");
+    return;
+  }
+
+  mem_map<mem_addr_t, mem_storage<bsize> > &memory_data = global_mem->get_m_data();
+  if (memory_data.empty()) {
+    fprintf(stderr, "Warning: GMEM FI skipped because global memory has no resident blocks.\n");
+    return;
+  }
+
+  std::vector<unsigned> bitflip_vector;
+  read_colon_option(bitflip_vector, m_config.reg_bitflip_rand_n);
+  if (bitflip_vector.empty()) {
+    bitflip_vector.push_back(1U);
+  }
+
+  std::vector<mem_addr_t> block_indices;
+  for (mem_map<mem_addr_t, mem_storage<bsize> >::iterator it = memory_data.begin();
+       it != memory_data.end(); ++it) {
+    block_indices.push_back(it->first);
+  }
+  std::sort(block_indices.begin(), block_indices.end());
+  const size_t total_bytes = block_indices.size() * bsize;
+  if (total_bytes == 0) {
+    fprintf(stderr, "Warning: GMEM FI skipped because the resolved byte domain is empty.\n");
+    return;
+  }
+
+  const size_t byte_ordinal = static_cast<size_t>(m_config.gmem_byte_seed) % total_bytes;
+  size_t block_slot = byte_ordinal / bsize;
+  size_t byte_in_block = byte_ordinal % bsize;
+  mem_addr_t blk_idx = block_indices[block_slot];
+  if (m_config.gmem_target_addr != static_cast<unsigned long long>(-1)) {
+    const mem_addr_t target_addr = static_cast<mem_addr_t>(m_config.gmem_target_addr);
+    const mem_addr_t target_blk = target_addr / bsize;
+    if (memory_data.find(target_blk) != memory_data.end()) {
+      blk_idx = target_blk;
+      byte_in_block = static_cast<size_t>(target_addr % bsize);
+    } else {
+      printf("GPUFI_FAULT component=gmem status=unmapped reason=unallocated_target byte_addr=%llu\n",
+             static_cast<unsigned long long>(target_addr));
+      return;
+    }
+  }
+  unsigned char *i_data = memory_data[blk_idx].get_m_data();
+  const mem_addr_t target_addr =
+      static_cast<mem_addr_t>(blk_idx * bsize + static_cast<mem_addr_t>(byte_in_block));
+
+  for (std::vector<unsigned>::iterator bf_it = bitflip_vector.begin();
+       bf_it != bitflip_vector.end(); ++bf_it) {
+    const unsigned before = i_data[byte_in_block];
+    if (!sara_fault::flip_bit(i_data + byte_in_block, 1, 8, *bf_it)) {
+      printf("GPUFI_FAULT component=gmem status=rejected reason=invalid_bit bit=%u\n", *bf_it);
+      continue;
+    }
+    printf("GPUFI_FAULT component=gmem status=applied cycle=%llu byte_addr=%llu "
+           "width=8 bit=%u before=%02x after=%02x\n", gpu_tot_sim_cycle + gpu_sim_cycle,
+           static_cast<unsigned long long>(target_addr), *bf_it, before,
+           static_cast<unsigned>(i_data[byte_in_block]));
+  }
+
+  mem_access_sector_mask_t invalidate_mask = mem_access_sector_mask_t();
+  for (unsigned s = 0; s < SECTOR_CHUNCK_SIZE; ++s) {
+    invalidate_mask.set(s);
+  }
+
+  for (unsigned cluster_idx = 0; cluster_idx < m_shader_config->n_simt_clusters; ++cluster_idx) {
+    simt_core_cluster *simt_cluster = m_cluster[cluster_idx];
+    if (simt_cluster == NULL) continue;
+    for (unsigned core_local_idx = 0; core_local_idx < m_shader_config->n_simt_cores_per_cluster; ++core_local_idx) {
+      shader_core_ctx *shader_core = simt_cluster->get_core()[core_local_idx];
+      if (shader_core == NULL || shader_core->m_ldst_unit == NULL || shader_core->m_ldst_unit->m_L1D == NULL) continue;
+      l1_cache *L1D = shader_core->m_ldst_unit->m_L1D;
+      unsigned index = 0;
+      enum cache_request_status status = L1D->m_tag_array->probe(target_addr, index, invalidate_mask, false, NULL);
+      if (status == HIT || status == HIT_RESERVED) {
+        cache_block_t *block = L1D->m_tag_array->get_block(index);
+        if (block != NULL) {
+          block->set_status(INVALID, invalidate_mask);
+        }
+      }
+    }
+  }
+
+  addrdec_t addrdec = addrdec_t();
+  m_memory_config->m_L2_config.m_address_mapping->addrdec_tlx(target_addr, &addrdec);
+  l2_cache *l2_cache_ptr = m_memory_sub_partition[addrdec.sub_partition]->m_L2cache;
+  if (l2_cache_ptr != NULL) {
+    unsigned index = 0;
+    enum cache_request_status status = l2_cache_ptr->m_tag_array->probe(target_addr, index, invalidate_mask, false, NULL);
+    if (status == HIT || status == HIT_RESERVED) {
+      cache_block_t *block = l2_cache_ptr->m_tag_array->get_block(index);
+      if (block != NULL) {
+        block->set_status(INVALID, invalidate_mask);
+      }
+    }
+  }
+}
+
+// Called only after the actual simulation-exit semaphore has completed.
+// A normal model endpoint is distinct from a physical DATA assignment: retain
+// the unchanged pending mask, but certify no later modeled consumer can run.
+void gpgpu_sim::fault_cold_terminal_after_thread_exit(uint64_t cursor) {
+  if (!sara_fault::cold_invalid_data::any()) return;
+  bool idle = false;
+  memory_observer_state(idle);  // independent of active()'s limit short-circuit
+  if (m_config.cache_data_realizer_version != 2 || !idle ||
+      sara_fault::live_cache_error())
+    sara_fault::cold_invalid_data::reject_all("cold_model_end_not_drained");
+  const std::set<sara_fault::cold_invalid_data *> &pending = sara_fault::cold_invalid_data::pending();
+  for (std::set<sara_fault::cold_invalid_data *>::const_iterator item = pending.begin(); item != pending.end(); ++item) {
+    sara_fault::cold_invalid_data &cold = **item;
+    std::map<const void *, sara_fault::tag_cache_owner>::const_iterator found =
+        sara_fault::tag_cache_owners().find(cold.owner());
+    if (found == sara_fault::tag_cache_owners().end() || found->second.instance != cold.instance() ||
+        found->second.epoch != cold.epoch() || found->second.allocated_lines != cold.allocated_lines() ||
+        found->second.line_bytes != cold.line_bytes() || found->second.cache_type != cold.cache_type())
+      sara_fault::cold_invalid_data::reject_all("cold_model_end_physical_owner_changed");
+    tag_array *tags = const_cast<tag_array *>(static_cast<const tag_array *>(cold.owner()));
+    tags->fault_tag_check_geometry();
+    if (cold.slot() >= tags->size() || cold.slot() >= tags->actual_allocation().lines)
+      sara_fault::cold_invalid_data::reject_all("cold_model_end_slot_outside_actual_allocation");
+    cache_block_t *slot = tags->get_block(static_cast<unsigned>(cold.slot()));
+    mem_access_sector_mask_t selected;
+    if (cold.cache_type() == SECTOR)
+      selected.set(cold.data_bit() / (cold.line_bytes()*8/SECTOR_CHUNCK_SIZE));
+    if (&slot->m_fault_overlay.cold() != &cold || slot->get_status(selected) != INVALID)
+      sara_fault::cold_invalid_data::reject_all("cold_model_end_data_not_invalid");
+    cold.terminal_invalid(slot->m_fault_overlay.version(), gpu_tot_sim_cycle + gpu_sim_cycle,
+                          cursor, slot->is_readable(selected));
+  }
+}
+
+// A reserved sector has a pending fill, not resident data. Normal-cache
+// is_valid_line() excludes MODIFIED, whereas the sector implementation includes
+// RESERVED, so neither virtual predicate alone identifies usable data storage.
+static bool fault_cache_data_resident(cache_block_t *line,
+                                      const cache_config &config,
+                                      unsigned data_bit) {
+  if (data_bit >= config.get_line_sz() * 8) return false;
+  mem_access_sector_mask_t mask;
+  if (config.m_cache_type == SECTOR) {
+    const unsigned sector = data_bit /
+        (config.get_line_sz() * 8 / SECTOR_CHUNCK_SIZE);
+    mask.set(sector);
+  }
+  const enum cache_block_state status = line->get_status(mask);
+  return status == VALID || status == MODIFIED;
+}
+
+// Explicit pending physical mutation for nonreadable INVALID/RESERVED DATA. It never enters the resident
+// registry or invents a logical block for unallocated/invalid DATA bytes.
+static bool fault_arm_cold_invalid_data(const gpgpu_sim_config &simulation,
+    const cache_config &config, tag_array *tags, cache_block_t *line,
+    unsigned slot, unsigned data_bit, uint64_t cycle, unsigned requested_bit,
+    const char *component, unsigned cluster, unsigned core, unsigned bank,
+    const std::string &realization) {
+  if (simulation.get_cache_data_realizer_version() != 2) return false;
+  mem_access_sector_mask_t mask;
+  if (config.m_cache_type == SECTOR)
+    mask.set(data_bit / (config.get_line_sz() * 8 / SECTOR_CHUNCK_SIZE));
+  const cache_block_state state = line->get_status(mask);
+  if (state == VALID || state == MODIFIED) return false;  // unchanged resident realizer
+  if (state != INVALID)
+    sara_fault::cache_approximation("cold_reserved_data_realization_unverified", component, realization);
+  if (std::string(component) != "l1d" && std::string(component) != "l2")
+    sara_fault::cache_approximation("cold_constant_or_texture_scope", component, realization);
+  sara_fault::tag_cache_check_geometry(tags, config.fault_tag_geometry());
+  const sara_fault::tag_cache_owner &owner = sara_fault::tag_cache_owners().at(tags);
+  if (!owner.allocated_lines || slot >= owner.allocated_lines || slot >= config.get_num_lines() ||
+      owner.line_bytes != config.get_line_sz() || owner.cache_type != config.m_cache_type ||
+      data_bit >= owner.line_bytes * 8 || line->is_reserved_line() || line->is_modified_line())
+    sara_fault::cache_approximation("cold_physical_slot_or_dirty_inflight_scope_unverified", component, realization);
+  if (sara_fault::live_cache_error() || sara_fault::tag_faults_active() || sara_fault::cold_invalid_data::any())
+    sara_fault::cache_approximation("cold_conflicting_existing_fault_cause", component, realization);
+  sara_fault::cold_invalid_data &cold = line->m_fault_overlay.cold();
+  line->m_fault_overlay.set_component(component);
+  const uint64_t execution_before = cold.execution();
+  cold.arm(tags, owner.instance, owner.epoch, slot, owner.allocated_lines,
+      config.get_line_sz(), config.m_cache_type, data_bit, line->m_fault_overlay.version(), component, realization);
+  std::ostringstream ack;
+  ack << "GPUFI_FAULT component=" << component << " kind=data status=cold_armed"
+      << " ack_schema=cache-invalid-pending-v2 realizer_version=2 fault_model=" << sara_fault::cold_data_fault_model()
+      << " storage_model=physical_invalid_pending_xor_v2 cycle=" << cycle
+      << " line=" << slot << " bit=" << requested_bit << " data_bit=" << data_bit;
+  if (std::string(component) == "l1d") ack << " cluster=" << cluster << " core=" << core;
+  else ack << " bank=" << bank;
+  ack << " cache_instance=" << owner.instance << " geometry_epoch=" << owner.epoch
+      << " allocated_lines=" << owner.allocated_lines << " active_lines=" << config.get_num_lines()
+      << " line_bytes=" << owner.line_bytes << " cache_type=" << owner.cache_type
+      << " state=" << (state == RESERVED ? "RESERVED" : "INVALID") << " known_block=0 allocation_version=" << line->m_fault_overlay.version()
+      << " readable=" << (line->is_readable(mask) ? 1 : 0)
+      << " execution_before=" << execution_before << " execution_after=" << cold.execution()
+      << " pending_before=00 pending_after=";
+  char byte_mask[3]; snprintf(byte_mask, sizeof(byte_mask), "%02x", cold.mask());
+  ack << byte_mask << " realization_id=" << realization;
+  printf("%s\n", ack.str().c_str()); fflush(stdout);
+  return true;
+}
+
+static unsigned fault_cache_data_sector_mask(cache_block_t *line,
+                                             const cache_config &config) {
+  unsigned result = 0;
+  for (unsigned sector = 0; sector < SECTOR_CHUNCK_SIZE; ++sector) {
+    if (fault_cache_data_resident(line, config,
+          sector * (config.get_line_sz() * 8 / SECTOR_CHUNCK_SIZE)))
+      result |= 1U << sector;
+  }
+  return result;
+}
+
+// cache_type <= 0: L1D, 1: L1C, 2: L1T
+void gpgpu_sim::bitflip_l1_cache(unsigned cache_type) {
+  const char *component = cache_type == 0 ? "l1d" : cache_type == 1 ? "l1c" : "l1t";
+  std::vector<unsigned> l1_bitflip_vector, l1_shader_vector;
+  char *l1_cache_bitflip_rand_n = cache_type==0 ? m_config.l1d_cache_bitflip_rand_n
+                                                : cache_type==1 ? m_config.l1c_cache_bitflip_rand_n
+                                                                : m_config.l1t_cache_bitflip_rand_n;
+  char *l1_shader_rand_n = cache_type==0 ? m_config.l1d_shader_rand_n
+                                   : cache_type==1 ? m_config.l1c_shader_rand_n
+                                                   : m_config.l1t_shader_rand_n;
+  read_colon_option(l1_bitflip_vector, l1_cache_bitflip_rand_n);
+  read_colon_option(l1_shader_vector, l1_shader_rand_n);
+  if (m_config.cache_data_realizer_version == 2 &&
+      (cache_type != 0 || l1_bitflip_vector.size() != 1 || l1_shader_vector.size() != 1))
+    sara_fault::cache_approximation("cold_v2_requires_single_L1D_target", component, "none");
+
+  std::vector<cache_t*> l1_to_bitflip;
+  std::vector<unsigned> l1_cluster_to_bitflip;
