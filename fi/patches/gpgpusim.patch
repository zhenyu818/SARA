+#ifndef SARA_POPULATION_DIRECTORY_H
+#define SARA_POPULATION_DIRECTORY_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+namespace sara_population {
+
+// Observer invalidation only. No value, instruction, scheduling or FI state is
+// changed. It remains disabled in FI and every run without a population collector.
+struct directory_state {
+  directory_state() : enabled(false), rf(0), smem(0) {}
+  bool enabled;
+  uint64_t rf, smem;
+};
+inline directory_state &directory() { static directory_state state; return state; }
+inline void directory_advance(uint64_t &value) {
+  if (value == UINT64_MAX) {
+    fprintf(stderr, "population directory epoch overflow\n"); abort();
+  }
+  ++value;
+}
+inline void directory_rf_changed() {
+  if (directory().enabled) directory_advance(directory().rf);
+}
+inline void directory_smem_changed() {
+  if (directory().enabled) directory_advance(directory().smem);
+}
+inline void directory_threads_changed() {
+  directory_rf_changed(); directory_smem_changed();
+}
+
+}  // namespace sara_population
+#endif
