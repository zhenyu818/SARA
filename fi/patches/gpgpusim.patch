+// Independent tiny-state reference observer. Default off; correctness use only.
+// This header is included in gpu-sim.cc after complete simulator type definitions.
+// It must not call the production collector, membership walkers or serializer.
+#ifndef SARA_POPULATION_REFERENCE_TICKS_H
+#define SARA_POPULATION_REFERENCE_TICKS_H
+#include <algorithm>
+#include <fcntl.h>
+#include <unistd.h>
+#include <zlib.h>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <map>
+#include <sstream>
+#include <string>
+#include <tuple>
+#include <vector>
+
+namespace sara_population_reference {
+inline void fail(const std::string &why) {
+  fprintf(stderr, "GPUFI_REFERENCE_ERROR %s\n", why.c_str());
+  fflush(stderr);
+  abort();
+}
+inline std::string quoted(const std::string &text) {
+  std::ostringstream out;
+  out << '"';
+  const char *hex = "0123456789abcdef";
+  for (size_t i = 0; i < text.size(); ++i) {
+    const unsigned char c = static_cast<unsigned char>(text[i]);
+    if (c == '"' || c == '\\') out << '\\' << static_cast<char>(c);
+    else if (c < 32) out << "\\u00" << hex[c >> 4] << hex[c & 15];
+    else out << static_cast<char>(c);
+  }
+  out << '"';
+  return out.str();
+}
+inline std::string required_environment(const char *name) {
+  const char *value = getenv(name);
+  if (!value || !value[0]) fail(std::string("missing_environment:") + name);
+  return value;
+}
+inline void add_checked(uint64_t &value, uint64_t delta) {
+  if (delta > std::numeric_limits<uint64_t>::max() - value)
+    fail("reference_counter_overflow");
+  value += delta;
+}
+inline std::string raw_hex(const void *value, unsigned width) {
+  const unsigned char *data = static_cast<const unsigned char *>(value);
+  const char *hex = "0123456789abcdef";
+  std::string text;
+  for (unsigned n = (width + 7) / 8; n != 0; --n) {
+    unsigned byte = data[n - 1];
+    if (n == (width + 7) / 8 && width % 8)
+      byte &= (1U << (width % 8)) - 1;
+    text += hex[byte >> 4]; text += hex[byte & 15];
+  }
+  return text;
+}
+inline std::string logical_cta(ptx_thread_info *thread) {
+  const dim3 c = thread->get_ctaid();
+  std::ostringstream out;
+  out << c.x << ',' << c.y << ',' << c.z;
+  return out.str();
+}
+inline std::string context(ptx_thread_info *thread, bool ack) {
+  std::ostringstream out;
+  const uint64_t values[] = {thread->get_uid(), thread->get_kernel().get_uid(),
+                            thread->get_hw_sid(), thread->get_cta_uid()};
+  const char *names[] = {"thread", "kernel", "sm", "cta_slot"};
+  for (unsigned i = 0; i < 4; ++i) {
+    if (i) out << ',';
+    out << quoted(names[i]) << ':';
+    if (ack) out << quoted(std::to_string(values[i])); else out << values[i];
+  }
+  if (ack) out << ",\"cta\":" << quoted(logical_cta(thread));
+  return out.str();
+}
+
+struct physical_thread {
+  ptx_thread_info *thread;
+  unsigned kernel, cluster, core, warp, lane;
+  bool operator<(const physical_thread &other) const {
+    return std::tie(kernel, cluster, core, warp, lane) <
+           std::tie(other.kernel, other.cluster, other.core, other.warp, other.lane);
+  }
+};
+
+class raw_tick_writer {
+ public:
+  raw_tick_writer() : file_(NULL), gzip_(NULL), configured_(false), ticks_(0), first_(0),
+      next_(0), empty_(0), rf_(0), smem_(0), bytes_(0), next_object_(0),
+      select_rf_(true), select_smem_(true), membership_only_(false), pending_(false), pending_start_(0),
+      tick_budget_(20000), byte_budget_(268435456) {}
+  ~raw_tick_writer() { close(); }
+
+  void tick(const gpgpu_sim_config &cfg, const shader_core_config *shader,
+            simt_core_cluster **clusters, uint64_t cycle) {
+    if (!configured_) {
+      configured_ = true;
+      const char *path = getenv("SARA_POPULATION_REFERENCE_TICKS");
+      if (!path || !path[0]) return;
+      const char *components = getenv("SARA_POPULATION_REFERENCE_COMPONENTS");
+      const std::string mode = components && components[0] ? components : "both";
+      if (mode != "rf" && mode != "smem" && mode != "both") fail("unreviewed_reference_component");
+      select_rf_ = mode != "smem"; select_smem_ = mode != "rf";
+      const char *format = getenv("SARA_POPULATION_REFERENCE_FORMAT");
+      if (format && format[0] && std::string(format) != "membership_v2") fail("unreviewed_reference_format");
+      membership_only_ = format && format[0];
+      if ((!membership_only_ && mode != "both") || (membership_only_ && mode == "both"))
+        fail("reference_v2_requires_one_complete_declared_component");
+      component_mode_ = mode;
+      if (!cfg.population_output() || !cfg.population_output()[0] ||
+          !cfg.population_fault_free_options() || cfg.population_has_termination_limit())
+        fail("reference_requires_complete_fault_free_collection");
+      const unsigned endian_probe = 1;
+      if (*reinterpret_cast<const unsigned char *>(&endian_probe) != 1)
+        fail("reference_requires_little_endian_host");
+      path_ = path;
+      tick_budget_ = cfg.reference_tick_budget(); byte_budget_ = cfg.reference_byte_budget();
+      if (!tick_budget_ || tick_budget_ > 1000000000ULL || !byte_budget_)
+        fail("reference_explicit_budget_outside_hard_bounds");
+      const char *codec = getenv("SARA_POPULATION_REFERENCE_CODEC");
+      if (codec && codec[0] && std::string(codec) != "plain" && std::string(codec) != "gzip")
+        fail("unreviewed_reference_codec");
+      if (codec && std::string(codec) == "gzip") {
+        const int descriptor = ::open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+        if (descriptor < 0) fail("reference_output_open_failed");
+        gzip_ = gzdopen(descriptor, "wb1");
+        if (!gzip_) { ::close(descriptor); fail("reference_gzip_open_failed"); }
+      } else {
+        file_ = fopen(path, "wx");
+        if (!file_) fail("reference_output_open_failed");
+      }
+      std::ostringstream header;
+      header << "{\"kind\":\"header\",\"schema\":" << quoted(membership_only_ ?
+          "sara-population-independent-membership-v2" : "sara-population-independent-ticks-v1") << ',' 
+             << "\"reference_walk\":\"direct_core_warp_lane_const_containers\","
+             << "\"phase\":\"after_all_core_instruction_events_at_cycle\","
+             << "\"model\":\"active-allocated-simulator-rf-smem-single-bit-v1\","
+             << "\"source_fingerprint\":" << quoted(required_environment("SARA_SOURCE_FINGERPRINT"))
+             << ",\"image_id\":" << quoted(required_environment("SARA_IMAGE_ID"))
+             << ",\"run_nonce\":" << quoted(required_environment("SARA_POPULATION_REFERENCE_NONCE"))
+             << ",\"config_sha256\":" << quoted(required_environment("SARA_POPULATION_REFERENCE_CONFIG_SHA256"))
+             << ",\"shared_identity_contract\":\"actual_allocator_persistent_object_owner_epoch_v1\""
+             << ",\"num_shaders\":" << shader->num_shader()
+             << ",\"smem_limit_bytes\":" << shader->gpgpu_shmem_per_block
+             << ",\"max_hook_ticks\":" << tick_budget_ << ",\"max_output_bytes\":" << byte_budget_
+             << ",\"feature_envelope\":" << quoted(membership_only_ && select_rf_ ?
+                 "RF_single_frame_actual_kernel_set_no_calls" : membership_only_ ?
+                 "SMEM_actual_persistent_object_owner_epochs" : "single_frame_no_calls_no_shared_object_reuse");
+      if (membership_only_) header << ",\"declared_components\":[" << quoted(component_mode_) << ']'
+          << ",\"thread_geometry_contract\":\"independent_actual_thread_uid_logical_coords_v1\"";
+      header << '}';
+      line(header.str());
+    }
+    if (!file_ && !gzip_) return;
+    if (ticks_ && cycle != next_) fail("nonconsecutive_reference_hook");
+    if (!ticks_) first_ = cycle;
+    if (cycle == std::numeric_limits<uint64_t>::max()) fail("reference_cycle_overflow");
+    next_ = cycle + 1;
+    if (ticks_ >= tick_budget_) fail("reference_complete_window_tick_budget_exceeded");
+
+    // Independent physical traversal, not find_active_* or collector members.
+    // Iterate const existing maps/pages only: no get_reg/read/operator[] access.
+    std::vector<physical_thread> threads;
+    for (unsigned ci = 0; ci != shader->n_simt_clusters; ++ci) {
+      simt_core_cluster *cluster = clusters[ci];
+      const unsigned cores = cluster->get_config()->n_simt_cores_per_cluster;
+      for (unsigned co = 0; co != cores; ++co) {
+        shader_core_ctx *core = cluster->get_core()[co];
+        if (!core->get_not_completed()) continue;
+        for (unsigned wi = 0; wi != cluster->get_config()->max_warps_per_shader; ++wi) {
+          shd_warp_t *warp = core->get_warp()[wi];
+          if (warp->done_exit()) continue;
+          for (unsigned lane = 0; lane != warp->get_warp_size(); ++lane) {
+            const unsigned physical = warp->get_warp_id() * warp->get_warp_size() + lane;
+            ptx_thread_info *thread = core->get_thread_info()[physical];
+            if (!thread || thread->is_done()) continue;
+            physical_thread item = {thread, thread->get_kernel().get_uid(), ci, co, wi, lane};
+            if (item.kernel != core->get_kernel()->get_uid()) fail("thread_core_kernel_disagreement");
+            if (thread->get_cta_uid() != static_cast<uint64_t>(thread->get_hw_ctaid()) * shader->num_shader() + thread->get_hw_sid())
+              fail("reference_allocator_slot_disagreement");
+            threads.push_back(item);
+          }
+        }
+      }
+    }
+    std::sort(threads.begin(), threads.end());
+    std::ostringstream geometry;
+    if (membership_only_) for (size_t ti = 0; ti != threads.size(); ++ti) {
+      ptx_thread_info *thread = threads[ti].thread;
+      const dim3 cta = thread->get_ctaid(), tid = thread->get_tid();
+      if (ti) geometry << ',';
+      const sara_shared::owner_identity &actual = thread->shared_owner_identity();
+      geometry << "{\"kernel_uid\":" << thread->get_kernel().get_uid() << ",\"thread_id\":" << thread->get_uid()
+               << ",\"logical_cta\":[" << cta.x << ',' << cta.y << ',' << cta.z << ']'
+               << ",\"logical_tid\":[" << tid.x << ',' << tid.y << ',' << tid.z << ']'
+               << ",\"sm_id\":" << thread->get_hw_sid() << ",\"cta_id\":" << thread->get_hw_ctaid()
+               << ",\"shared_storage\":{\"schema\":\"sara-actual-shared-owner-v1\",\"object_uid\":" << actual.object_uid
+               << ",\"owner_epoch\":" << actual.owner_epoch << ",\"allocator_slot\":" << actual.allocator_slot << "}}";
+    }
+    std::ostringstream members;
+    uint64_t tick_rf = 0, tick_smem = 0;
+    bool comma = false;
+    if (select_rf_) for (size_t ti = 0; ti != threads.size(); ++ti) {
+      ptx_thread_info *thread = threads[ti].thread;
+      typedef tr1_hash_map<const symbol *, ptx_reg_t> registers;
+      const std::list<registers> &frames = thread->population_regs_read_only();
+      if (frames.size() != 1) fail("reference_frame_envelope_exceeded");
+      std::vector<registers::const_iterator> ordered;
+      const registers &frame = frames.front();
+      for (registers::const_iterator r = frame.begin(); r != frame.end(); ++r) ordered.push_back(r);
+      std::sort(ordered.begin(), ordered.end(), [](registers::const_iterator a, registers::const_iterator b) {
+        return a->first->uid() < b->first->uid();
+      });
+      for (size_t ri = 0; ri != ordered.size(); ++ri) {
+        const symbol *reg = ordered[ri]->first;
+        size_t width = 0; int basic_type = 0;
+        if (reg->type()) reg->type()->get_key().type_decode(width, basic_type);
+        if (!(width == 1 || width == 8 || width == 16 || width == 32 || width == 64 || width == 128) ||
+            (ri && ordered[ri - 1]->first->uid() == reg->uid()))
+          fail("reference_unquantifiable_width_or_duplicate_uid");
+        if (comma) members << ','; comma = true;
+        members << "{\"component\":\"rf\"";
+        if (membership_only_) members << ",\"mapping_supported\":true";
+        members << ",\"bit_start\":0,\"bit_count\":" << width
+                << ",\"target\":{" << context(thread, false) << ",\"cta_id\":" << thread->get_hw_ctaid()
+                << ",\"register\":" << quoted(reg->name()) << ",\"register_uid\":" << reg->uid() << ",\"width_bits\":" << width << '}'
+                << ",\"hook_selectors\":{\"-kernel_n\":\"0\",\"-per_warp\":\"0\",\"-thread_rand\":" << quoted(std::to_string(ti))
+                << ",\"-register_rand_n\":" << quoted(std::to_string(ri + 1)) << '}'
+                << ",\"ack_expected\":{\"component\":\"rf\"," << context(thread, true)
+                << ",\"reg\":" << quoted(reg->name()) << ",\"reg_uid\":" << quoted(std::to_string(reg->uid()))
+                << ",\"width\":" << quoted(std::to_string(width)) << '}'
+                << ",\"lifecycle\":{\"logical_cta\":" << quoted(logical_cta(thread))
+                << ",\"frame_index\":0,\"frame_count\":1,\"active_thread_index\":" << ti << ",\"register_walk_index\":" << ri + 1 << '}';
+        if (!membership_only_) members << ",\"value_hex\":" << quoted(raw_hex(&ordered[ri]->second, width));
+        members << '}';
+        add_checked(tick_rf, width);
+      }
+    }
+    // Independent scope grouping, from physical records rather than producer scopes.
+    if (select_smem_) {
+    typedef std::pair<unsigned, uint64_t> scope_key;
+    std::map<scope_key, ptx_thread_info *> scopes;
+    for (size_t i = 0; i != threads.size(); ++i) {
+      ptx_thread_info *thread = threads[i].thread;
+      const scope_key key(thread->get_kernel().get_uid(), thread->get_cta_uid());
+      std::map<scope_key, ptx_thread_info *>::iterator old = scopes.find(key);
+      if (old == scopes.end()) scopes.insert(std::make_pair(key, thread));
+      else {
+        if (old->second->m_shared_mem != thread->m_shared_mem || logical_cta(old->second) != logical_cta(thread))
+          fail("inconsistent_physical_shared_scope");
+        if (thread->get_uid() < old->second->get_uid()) old->second = thread;
+      }
+    }
+    unsigned si = 0;
+    for (std::map<scope_key, ptx_thread_info *>::const_iterator scope = scopes.begin(); scope != scopes.end(); ++scope, ++si) {
+      ptx_thread_info *thread = scope->second;
+      const memory_space_impl<16384> *memory = dynamic_cast<const memory_space_impl<16384> *>(thread->m_shared_mem);
+      if (!memory) fail("reference_unknown_shared_container");
+      typedef mem_map<mem_addr_t, mem_storage<16384> > pages;
+      const pages &allocated = memory->get_m_data();
+      std::vector<pages::const_iterator> ordered;
+      for (pages::const_iterator page = allocated.begin(); page != allocated.end(); ++page) ordered.push_back(page);
+      std::sort(ordered.begin(), ordered.end(), [](pages::const_iterator a, pages::const_iterator b) { return a->first < b->first; });
+      std::map<const memory_space *, unsigned>::iterator object = objects_.find(memory);
+      if (object == objects_.end()) object = objects_.insert(std::make_pair(memory, ++next_object_)).first;
+      const std::string generation = std::to_string(thread->get_kernel().get_uid()) + ":" + logical_cta(thread);
+      const sara_shared::owner_identity &actual = thread->shared_owner_identity();
+      if (!actual.object_uid || !actual.owner_epoch || actual.allocator_slot != thread->get_cta_uid())
+        fail("reference_missing_actual_shared_allocator_identity");
+      if (membership_only_) {
+        std::map<uint64_t, const memory_space *>::const_iterator uid = actual_uid_objects_.find(actual.object_uid);
+        if (uid != actual_uid_objects_.end() && uid->second != memory) fail("reference_shared_UID_alias");
+        std::map<const memory_space *, observed_owner>::const_iterator prior = actual_owners_.find(memory);
+        if (prior != actual_owners_.end()) {
+          if (prior->second.uid != actual.object_uid || prior->second.slot != actual.allocator_slot ||
+              actual.owner_epoch < prior->second.epoch ||
+              ((actual.owner_epoch == prior->second.epoch) != (generation == prior->second.generation)))
+            fail("reference_shared_owner_epoch_or_object_disagreement");
+        }
+        actual_uid_objects_[actual.object_uid] = memory;
+        actual_owners_[memory] = observed_owner(actual.object_uid, actual.owner_epoch, actual.allocator_slot, generation);
+      }
+
+      std::map<unsigned, std::string>::const_iterator previous = generations_.find(object->second);
+      if (!membership_only_ && previous != generations_.end() && previous->second != generation) fail("reference_shared_reuse_envelope_exceeded");
+      generations_.insert(std::make_pair(object->second, generation));
+      for (size_t pi = 0; pi != ordered.size(); ++pi) {
+        const uint64_t index = ordered[pi]->first;
+        if (index > std::numeric_limits<uint64_t>::max() / 16384) fail("reference_page_index_overflow");
+        const uint64_t begin = index * 16384;
+        if (membership_only_) {
+          if (begin >= shader->gpgpu_shmem_per_block) continue;
+          const uint64_t count = std::min<uint64_t>(16384, shader->gpgpu_shmem_per_block - begin);
+          if (comma) members << ','; comma = true;
+          members << "{\"component\":\"smem_page\",\"mapping_supported\":true,\"byte_start\":" << begin
+                  << ",\"byte_count\":" << count << ",\"target\":{\"kernel\":" << thread->get_kernel().get_uid()
+                  << ",\"sm\":" << thread->get_hw_sid() << ",\"cta_slot\":" << thread->get_cta_uid()
+                  << ",\"cta_id\":" << thread->get_hw_ctaid() << '}'
+                  << ",\"hook_selectors\":{\"-kernel_n\":\"0\",\"-per_warp\":\"0\",\"-block_rand\":" << quoted(std::to_string(si)) << ",\"-block_n\":\"1\"}"
+                  << ",\"ack_expected\":{\"component\":\"smem\"," << context(thread, true) << ",\"width\":\"8\""
+                  << ",\"shared_storage_uid\":" << quoted(std::to_string(actual.object_uid))
+                  << ",\"shared_owner_epoch\":" << quoted(std::to_string(actual.owner_epoch))
+                  << ",\"shared_allocator_slot\":" << quoted(std::to_string(actual.allocator_slot)) << "}"
+                  << ",\"lifecycle\":{\"logical_cta\":" << quoted(logical_cta(thread)) << ",\"shared_object_slot\":" << thread->get_cta_uid()
+                  << ",\"shared_storage_uid\":" << actual.object_uid << ",\"shared_owner_epoch\":" << actual.owner_epoch
+                  << ",\"shared_allocator_slot\":" << actual.allocator_slot << ",\"page_index\":" << index << ",\"page_bytes\":16384,\"shared_scope_index\":" << si << "}}";
+          add_checked(tick_smem, count * 8);
+          continue;
+        }
+        for (unsigned offset = 0; offset != 16384 && begin + offset < shader->gpgpu_shmem_per_block; ++offset) {
+          const uint64_t address = begin + offset;
+          unsigned char value = 0;
+          ordered[pi]->second.read(offset, 1, &value);  // existing page, const memcpy only
+          if (comma) members << ','; comma = true;
+          members << "{\"component\":\"smem\",\"bit_start\":" << address * 8 << ",\"bit_count\":8"
+                  << ",\"target\":{\"kernel\":" << thread->get_kernel().get_uid() << ",\"sm\":" << thread->get_hw_sid()
+                  << ",\"cta_slot\":" << thread->get_cta_uid() << ",\"cta_id\":" << thread->get_hw_ctaid() << ",\"byte_addr\":" << address << '}'
+                  << ",\"hook_selectors\":{\"-kernel_n\":\"0\",\"-per_warp\":\"0\",\"-block_rand\":" << quoted(std::to_string(si)) << ",\"-block_n\":\"1\"}"
+                  << ",\"ack_expected\":{\"component\":\"smem\"," << context(thread, true) << ",\"width\":\"8\",\"byte_addr\":" << quoted(std::to_string(address))
+                  << ",\"shared_storage_uid\":" << quoted(std::to_string(actual.object_uid))
+                  << ",\"shared_owner_epoch\":" << quoted(std::to_string(actual.owner_epoch))
+                  << ",\"shared_allocator_slot\":" << quoted(std::to_string(actual.allocator_slot)) << '}'
+                  << ",\"lifecycle\":{\"logical_cta\":" << quoted(logical_cta(thread)) << ",\"shared_object_slot\":" << thread->get_cta_uid()
+                  << ",\"shared_storage_uid\":" << actual.object_uid << ",\"shared_owner_epoch\":" << actual.owner_epoch
+                  << ",\"shared_allocator_slot\":" << actual.allocator_slot << ",\"page_index\":" << index << ",\"page_bytes\":16384,\"shared_scope_index\":" << si << '}'
+                  << ",\"value_hex\":" << quoted(raw_hex(&value, 8)) << ",\"raw_context\":{\"physical_shared_object\":" << object->second << ",\"generation\":" << quoted(generation) << "}}";
+          add_checked(tick_smem, 8);
+        }
+      }
+    }
+    }  // selected shared component; RF-only does not inspect or block SMEM reuse
+    if (membership_only_) membership_tick(cycle, members.str(), geometry.str());
+    else {
+      std::ostringstream row;
+      row << "{\"kind\":\"tick\",\"cycle\":" << cycle << ",\"members\":[" << members.str() << "]}";
+      line(row.str());
+    }
+    add_checked(ticks_, 1); add_checked(rf_, tick_rf); add_checked(smem_, tick_smem);
+    if (!comma) add_checked(empty_, 1);
+  }
+
+ private:
+  // Full-state RLE is independent of production's per-member interval emitter.
+  // Only membership/selector/generation fields participate, never current values.
+  void membership_tick(uint64_t cycle, const std::string &members, const std::string &geometry) {
+    if (pending_ && pending_members_ == members && pending_geometry_ == geometry) return;
+    if (pending_) flush_membership(cycle);
+    pending_ = true; pending_start_ = cycle; pending_members_ = members; pending_geometry_ = geometry;
+  }
+  void flush_membership(uint64_t stop) {
+    if (!pending_ || stop <= pending_start_) fail("invalid_reference_membership_interval");
+    std::ostringstream row;
+    row << "{\"kind\":\"tick_span\",\"cycle_start\":" << pending_start_ << ",\"cycle_stop\":" << stop
+        << ",\"members\":[" << pending_members_ << "],\"thread_geometry\":[" << pending_geometry_ << "]}";
+    line(row.str()); pending_ = false;
+  }
+  void line(const std::string &value) {
+    if (bytes_ > byte_budget_ || value.size() + 1 > byte_budget_ - bytes_)
+      fail("reference_complete_window_byte_budget_exceeded");
+    // Transport only: the complete original JSON bytes and decoded-byte
+    // budget are identical. The close nonce is issued only after CRC closure.
+    if (gzip_) {
+      for (size_t offset = 0; offset < value.size();) {
+        const unsigned count = static_cast<unsigned>(std::min<size_t>(1024 * 1024, value.size() - offset));
+        if (gzwrite(gzip_, value.data() + offset, count) != static_cast<int>(count))
+          fail("reference_gzip_write_failed");
+        offset += count;
+      }
+      if (gzwrite(gzip_, "\n", 1) != 1) fail("reference_gzip_write_failed");
+    } else if (fwrite(value.data(), 1, value.size(), file_) != value.size() || fputc('\n', file_) == EOF)
+      fail("reference_write_failed");
+    add_checked(bytes_, value.size() + 1);
+  }
+  void close() {
+    if (!file_ && !gzip_) return;
+    if (membership_only_) flush_membership(next_);
+    std::ostringstream footer;
+    footer << "{\"kind\":\"footer\",\"schema\":" << quoted(membership_only_ ?
+        "sara-population-independent-membership-footer-v2" : "sara-population-independent-ticks-footer-v1")
+        << ",\"first_cycle\":" << first_
+           << ",\"cycle_stop\":" << next_ << ",\"hook_ticks\":" << ticks_ << ",\"zero_member_ticks\":" << empty_
+           << ",\"rf_bit_cycles\":" << rf_ << ",\"smem_bit_cycles\":" << smem_ << ",\"counter_overflow\":false,\"io_error\":false}";
+    line(footer.str());
+    if (gzip_) {
+      gzFile stream = gzip_; gzip_ = NULL;
+      if (gzclose(stream) != Z_OK) fail("reference_gzip_close_failed");
+    } else {
+      if (fflush(file_) || ferror(file_)) fail("reference_flush_failed");
+      FILE *file = file_; file_ = NULL;
+      if (fclose(file)) fail("reference_close_failed");
+    }
+    FILE *receipt = fopen((path_ + ".closed").c_str(), "wx");
+    if (!receipt) fail("reference_close_receipt_open_failed");
+    const std::string nonce = required_environment("SARA_POPULATION_REFERENCE_NONCE");
+    const bool failed = fprintf(receipt, "%s\n", nonce.c_str()) < 0 || fflush(receipt) != 0;
+    const int closed = fclose(receipt);
+    if (failed || closed) fail("reference_close_receipt_failed");
+  }
+  FILE *file_;
+  gzFile gzip_;
+  bool configured_;
+  std::string path_;
+  uint64_t ticks_, first_, next_, empty_, rf_, smem_, bytes_;
+  unsigned next_object_;
+  bool select_rf_, select_smem_, membership_only_, pending_;
+  uint64_t pending_start_;
+  uint64_t tick_budget_, byte_budget_;
+  std::string pending_members_, pending_geometry_, component_mode_;
+  struct observed_owner {
+    uint64_t uid, epoch; unsigned slot; std::string generation;
+    observed_owner() : uid(0), epoch(0), slot(0) {}
+    observed_owner(uint64_t u, uint64_t e, unsigned s, const std::string &g) : uid(u), epoch(e), slot(s), generation(g) {}
+  };
+  std::map<const memory_space *, observed_owner> actual_owners_;
+  std::map<uint64_t, const memory_space *> actual_uid_objects_;
+  std::map<const memory_space *, unsigned> objects_;
+  std::map<unsigned, std::string> generations_;
+};
