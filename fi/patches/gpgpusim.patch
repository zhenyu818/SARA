@@ -0,0 +1,80 @@
+#ifndef SARA_OPCODE_TIMING_CONFIG_H
+#define SARA_OPCODE_TIMING_CONFIG_H
+#include <limits.h>
+#include <stddef.h>
+#include <string.h>
+#include <stdio.h>
+#include <stdlib.h>
+namespace sara_timing {
+// Both existing occupied/result-bus bitsets have 512 entries: index 512 is invalid.
+static const unsigned ALU_LATENCY_BOUND=512;
+static const unsigned CDP_MAX_ACTIVE_LANES=32;
+struct error {const char *option;const char *reason;error():option(NULL),reason(NULL){}};
+struct table {
+  unsigned latency[5][6], initiation[5][6], cdp[5];
+  table() {memset(this,0,sizeof(*this));}
+};
+inline bool unsigned_csv(const char *text,unsigned count,unsigned minimum,
+                         unsigned maximum,unsigned *output,const char *&reason) {
+  reason=NULL;
+  if(!text || !output || !count || count>6 || minimum>maximum) {reason="invalid_parser_argument";return false;}
+  unsigned parsed[6]={0};const char *cursor=text;
+  for(unsigned item=0;item<count;++item) {
+    if(*cursor<'0' || *cursor>'9') {reason="unsigned_decimal_required";return false;}
+    unsigned value=0;
+    do {
+      const unsigned digit=static_cast<unsigned>(*cursor-'0');
+      if(value>maximum/10 || (value==maximum/10 && digit>maximum%10)) {reason="value_outside_allowed_range";return false;}
+      value=value*10+digit;++cursor;
+    } while(*cursor>='0' && *cursor<='9');
+    if(value<minimum) {reason="value_outside_allowed_range";return false;}
+    parsed[item]=value;
+    if(item+1<count) {
+      if(*cursor!=',') {reason="exact_csv_arity_required";return false;}
+      ++cursor;
+    } else if(*cursor!='\0') {reason="exact_csv_arity_required";return false;}
+  }
+  for(unsigned item=0;item<count;++item)output[item]=parsed[item];
+  return true;
+}
+inline bool parse(const char *const latency[5],const char *const initiation[5],
+                  const char *cdp,table &output,error &failure) {
+  const unsigned arity[5]={6,5,5,1,1};
+  const char *latency_names[5]={"-ptx_opcode_latency_int","-ptx_opcode_latency_fp","-ptx_opcode_latency_dp","-ptx_opcode_latency_sfu","-ptx_opcode_latency_tesnor"};
+  const char *init_names[5]={"-ptx_opcode_initiation_int","-ptx_opcode_initiation_fp","-ptx_opcode_initiation_dp","-ptx_opcode_initiation_sfu","-ptx_opcode_initiation_tensor"};
+  failure=error();table parsed;
+  if(!latency || !initiation) {failure.option="opcode_timing";failure.reason="invalid_parser_argument";return false;}
+  for(unsigned kind=0;kind<5;++kind) {
+    failure.option=latency_names[kind];
+    if(!unsigned_csv(latency[kind],arity[kind],1,ALU_LATENCY_BOUND-1,parsed.latency[kind],failure.reason))return false;
+    failure.option=init_names[kind];
+    if(!unsigned_csv(initiation[kind],arity[kind],1,ALU_LATENCY_BOUND-1,parsed.initiation[kind],failure.reason))return false;
+    for(unsigned item=0;item<arity[kind];++item)if(parsed.initiation[kind][item]>parsed.latency[kind][item]) {
+      failure.reason="initiation_exceeds_corresponding_latency";return false;
+    }
+  }
+  // CDP is a countdown, not an ALU bitset index; zero is a legitimate delay.
+  failure.option="-cdp_latency";
+  if(!unsigned_csv(cdp,5,0,UINT_MAX,parsed.cdp,failure.reason))return false;
+  for(unsigned base=1;base<5;base+=2) {
+    const unsigned long long maximum=static_cast<unsigned long long>(parsed.cdp[base])+
+      static_cast<unsigned long long>(parsed.cdp[base+1])*CDP_MAX_ACTIVE_LANES;
+    if(maximum>UINT_MAX) {failure.reason="cdp_active_lane_delay_overflow";return false;}
+  }
+  output=parsed;failure=error();return true;
+}
+inline void require(const char *const latency[5],const char *const initiation[5],const char *cdp,table &output) {
+  error failure;if(parse(latency,initiation,cdp,output,failure))return;
+  fprintf(stderr,"GPUFI_INVALID_CONFIGURATION option=%s reason=%s\n",failure.option?failure.option:"unknown",failure.reason?failure.reason:"unknown");
+  fflush(stderr);exit(EXIT_FAILURE);
+}
+inline unsigned maximum(const unsigned *values,unsigned count) {
+  unsigned result=1;for(unsigned i=0;i<count;++i)if(values[i]>result)result=values[i];return result;
+}
+inline unsigned larger(unsigned a,unsigned b){return a>b?a:b;}
+inline unsigned int_depth(const table &t){return larger(maximum(t.latency[0],4),t.latency[0][5]);}
+inline unsigned sp_depth(const table &t,bool int_fallback){return int_fallback?larger(maximum(t.latency[1],4),int_depth(t)):maximum(t.latency[1],4);}
+inline unsigned dp_depth(const table &t){return maximum(t.latency[2],4);}
+inline unsigned sfu_depth(const table &t,bool dp_fallback){return larger(larger(t.latency[3][0],dp_fallback?maximum(t.latency[2],5):t.latency[2][4]),larger(t.latency[0][4],t.latency[1][4]));}
+} // namespace sara_timing
