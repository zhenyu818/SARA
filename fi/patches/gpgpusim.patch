+#ifndef SARA_CACHE_COMPATIBILITY_H
+#define SARA_CACHE_COMPATIBILITY_H
+
+#include <stdio.h>
+#include <map>
+#include <string>
+
+namespace sara_fault {
+// Fixed scientific model, not a per-trial option or a fitted policy. Counts
+// describe approximations; they never select Masked/SDC/DUE labels.
+inline const char *cache_model_name() { return "functional-snapshot-cache-v3"; }
+inline void cache_approximation(const char *reason, const char *component,
+                                const std::string &realization) {
+  static std::map<std::string, unsigned long long> counts;
+  const std::string key = std::string(component) + ":" + reason;
+  const unsigned long long count = ++counts[key];
+  // One compact first-use witness per mechanism; no duplicate rich trace.
+  if (count == 1) {
+    printf("GPUFI_CACHE_APPROX model=%s component=%s reason=%s realization_id=%s\n",
+           cache_model_name(), component, reason,
+           realization.empty() ? "none" : realization.c_str());
+    fflush(stdout);
+  }
+}
+}  // namespace sara_fault
+#endif
