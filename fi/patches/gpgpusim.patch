+void find_l1_used(ptx_thread_info *thread, gpgpu_sim *gpu_sim, int &l1_used_index, unsigned l1_cache) {
+  std::vector<bool> *l1_enabled;
+  std::vector<unsigned> *l1_cluster_idx;
